;\\\">\\n<p>QS World University Rankings 2026</p>\\n</td>\\n<td style=\\\"width: 397.305px; height: 28px;\\\">\\n<p>World University</p>\\n</td>\\n<td style=\\\"width: 369.766px; height: 28px;\\\">222</td>\\n</tr>\\n<tr style=\\\"height: 12px;\\\">\\n<td style=\\\"width: 420px; height: 12px;\\\">\\n<p>QS World University Rankings 2026</p>\\n</td>\\n<td style=\\\"width: 397.305px; height: 12px;\\\">\\n<p>Asia</p>\\n</td>\\n<td style=\\\"width: 369.766px; height: 12px;\\\">77</td>\\n</tr>\\n<tr style=\\\"height: 10px;\\\">\\n<td style=\\\"width: 420px; height: 10px;\\\">\\n<p>QS World University Rankings 2026</p>\\n</td>\\n<td style=\\\"width: 397.305px; height: 10px;\\\">\\n<p>Southern Asia</p>\\n</td>\\n<td style=\\\"width: 369.766px; height: 10px;\\\">6</td>\\n</tr>\\n</tbody>\\n</table>\\n<p> </p>\",\"sectionName\":\"ovp_section_rankings\",\"sectionHeading\":\"IIT Kanpur Rankings 2026\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"productized\":false,\"sectionExist\":false,\"customDefaultSectionOrder\":false,\"dynamicOrder\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_rcb_mini_non_paid\":{\"description\":null,\"sectionName\":\"ovp_section_rcb_mini_non_paid\",\"sectionHeading\":\"College Counselling Mini Non Paid\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"productized\":true,\"sectionExist\":false,\"customDefaultSectionOrder\":false,\"dynamicOrder\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_others_2\":{\"description\":null,\"sectionName\":\"ovp_section_others_2\",\"sectionHeading\":\"Additional Information\",\"categoryTyp