\":\"SONY\",\"logoUrl\":\"https://images.shiksha.com/mediadata/images/SONY.gif\"},{\"companyName\":\"Qualcomm\",\"logoUrl\":\"https://images.shiksha.com/mediadata/images/Qualcomm.gif\"},{\"companyName\":\"Mahindra Group\",\"logoUrl\":\"https://images.shiksha.com/mediadata/images/Mahindra_Group.gif\"},{\"companyName\":\"Samsung\",\"logoUrl\":\"https://images.shiksha.com/mediadata/images/Samsung.gif\"},{\"companyName\":\"Analog Devices\",\"logoUrl\":\"https://images.shiksha.com/mediadata/images/Analog_Devices.gif\"},{\"companyName\":\"Reliance\",\"logoUrl\":\"https://images.shiksha.com/mediadata/images/Reliance.gif\"}],\"placementPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/placement\",\"l2Menu\":[{\"name\":\"College Info\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212\",\"menuSelected\":true,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":null,\"altText\":\"All About IIT Bombay\"},{\"name\":\"Courses\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Courses 2027\",\"headingPrefix\":null,\"altText\":\"IIT Bombay Courses\"},{\"name\":\"Fees\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/fees\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Fees 2027\",\"headingPrefix\":null,\"altText\":\"IIT Bombay Fees\"},{\"name\":\"Reviews\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/reviews\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Reviews on Placements, Faculty & Facilities\",\"headingPrefix\":null,\"altText\":\"IIT Bombay Reviews\"},{\"name\":\"Admissions\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/admission\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Admission 2027 - Cutoffs, Eligibility & Dates\",\"headingPrefix\":null,\"altText\":\"IIT Bombay Admissions 2027\"},{\"name\":\"Placements\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/placement\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Placement - Highest & Average Salary Package\",\"headingPrefix\":null,\"altText\":\"IIT Bombay Placements 2027\"},{\"name\":\"Cut-Offs\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/cutoff\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Cut off & Merit List 2027\",\"headingPrefix\":null,\"altText\":\"IIT Bombay Cut Offs\"},{\"name\":\"Rankings\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/ranking\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":null,\"altText\":\"IIT Bombay Rankings\"},{\"name\":\"Gallery\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/gallery\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Gallery 2027\",\"headingPrefix\":null,\"altText\":\"IIT Bombay Gallery\"},{\"name\":\"Hostel & Campus\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/infrastructure\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Hostel & Campus Details & Reviews\",\"headingPrefix\":null,\"altText\":\"IIT Bombay Hostel & Campus\"},{\"name\":\"Faculty\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/faculty\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":\"Faculty Details & Reviews\",\"altText\":\"IIT Bombay Faculty\"},{\"name\":\"Compare\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/compare\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":\"Compare\",\"altText\":\"Compare IIT Bombay\"},{\"name\":\"Q&A\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/questions\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":null,\"altText\":\"IIT Bombay Q&A\"},{\"name\":\"Scholarships\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/scholarships\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Scholarships\",\"headingPrefix\":null,\"altText\":\"IIT Bombay Scholarships\"},{\"name\":\"JEE Advanced\",\"url\":\"/engineering/jee-advanced-exam\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":null,\"altText\":\"JEE Advanced\"},{\"name\":\"GATE\",\"url\":\"/engineering/gate-exam\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":null,\"altText\":\"GATE\"}],\"breadCrumb\":[{\"name\":\"Home\",\"url\":\"/\",\"linkText\":null,\"entityId\":null,\"entityType\":null,\"pwa\":true},{\"name\":\"Colleges in Mumbai\",\"url\":\"/colleges/mumbai\",\"linkText\":null,\"entityId\":151,\"entityType\":\"city\",\"pwa\":true},{\"name\":\"IIT Bombay\",\"url\":null,\"linkText\":null,\"entityId\":null,\"entityType\":null,\"pwa\":true}],\"faq\":{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How is the MA in Research at IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The HSS department at IITBombay is introducing the Master of Arts by Research (MA. Res) with precisely this emphasis. The faculty members in the department represent diverse areas of expertise and have considerable experience teaching with an emphasis on research skills while accommodating disciplinary crossovers with ease. This is especially important since many of the concerns of the Humanities and Social Sciences requireamulti-disciplinary approach. Our students have been successful both in working at the interfaces of different areas and in transcending traditional disciplinary boundaries in their work. The programme combines course work to build student competence in specific areas, research training, and researchmodules for independent work. Students are expected to carry out a successful programme of research within the duration of the programme. The internal structure of the programme is designed to be quite different from course intensive postgraduate programmes and allows for relative flexibility interms of student backgrounds and prior training\"}},{\"@type\":\"Question\",\"name\":\"What is the placement package at central IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"During the IIT Bombay 2026 placements, 42 companies visited and made 98 offers on the first day. The highest international package offered was around INR 1.5 Crore per Annum. Further, accroding to the SJMSOM final placement report 2026 for MBA program, 100% placement was recorded in 2026. The highest and average package recorded during IIT Bombay MBA placements 2026 was INR 53.8 LPA and 28.16 LPA.\"}},{\"@type\":\"Question\",\"name\":\"What is the JEE Advanced cut off for B.Tech. in Computer Science and Engineering in IIT Bombay - Indian Institute of Technology?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For 2026, cut off was 67 for General category candidates in All India quota for B.Tech. in Computer Science and Engineering in IIT Bombay - Indian Institute of Technology. Which was the most competitive specialisations amongs others.\"}},{\"@type\":\"Question\",\"name\":\"What facilities are available at campus of IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The extensive campus of IIT Bombay houses many advanced facilities for its students such as banks, a shopping centre, two excellent schools for children, a well-equipped hospital, hostels, modern libraries and more. Inside the hostel premises, there is a separate complex for various sports. Also, the libraries are decked with Lacs of books, journals, thesis and digital books. Other than that, various canteens and cafeteria are also available inside the hostel premises.\"}},{\"@type\":\"Question\",\"name\":\"Is it compulsory to stay in hostel in IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No, it’s not compulsory for regular scholars to stay in the hostel for studying at IIT Bombay. Also, not every student gets a hostel facility. However, students who get enrolled in summer and winter internships have to stay in a hostel during the tenure of their internship. Interns who get the hostel are required to complete the formalities such as registration, payment of internship fees, etc., with the academic office of the institute.\"}},{\"@type\":\"Question\",\"name\":\"How is hostel life at IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay is popular for its cheerful hostel life. The institute’s hostel has modern amenities that makes it most viable among students. It has several cafeterias and canteens with affordable food options. Cultural, sports and technical championships are conducted inside the campus. Students can spend their free time playing indoor and outdoor sports such as pool, basketball court and table tennis. IIT Bombay has encouraging atmosphere.\"}},{\"@type\":\"Question\",\"name\":\"Does IIT Bombay have a hostel?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, IIT Bombay provides on-campus residential accommodation across Powai campus through multiple numbered hostels and hostel blocks (such as Tansa). Rooms are allotted based on availability, programme, category and institute policy, with first-year students generally placed in shared accomodation. Hostel administration, mess policies, and residential guidelines are coordinated by IIT Bombay's Hostel Coordinating Unit (HCU).\"}},{\"@type\":\"Question\",\"name\":\"How is the campus of IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay has a technologically advanced campus. IIT Bombay has one of the best campuses in India with state-of-the-art infrastructure, modern amenities and research laboratories. In addition to this, IIT Bombay also has separate hostels for boys and girls. IIT Bombay offers hostel facilities to both domestic and international students. Also, a special hostel is constructed to offer accommodation to foreign national students. The classrooms of IIT Bombay are bestowed with audio-visual aids along with digital smart boards to promote innovative and interactive learning.\"}},{\"@type\":\"Question\",\"name\":\"What is the salary of MBA in IIT Bombay SJMSOM?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The placement rate recorded during SJMSOM IIT Bombay MBA placements 2026 was 100%. Students get a good salary package after completing MBA from a reputed institute like SJMSOM. The highest package and average package offered during SJMSOM IIT Bombay MBA placements 2026 stood at INR 53.8 LPA and INR 28.16 LPA, respectively. The top recruiters of SJMSOM IIT Bombay in 2026 included leading companies such as Google, Intel, Samasung, etc.\"}},{\"@type\":\"Question\",\"name\":\"Which is better for pursuing a BDes - IIT Bombay or NIFT Mumbai?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Both IIT Bombay and NIFT Mumbai are recognised for their BDes course. For better comparison, below are some parameters to compare BDes programme of both the institutes: Parameter IIT Bombay NIFT Mumbai Total tuition fee* INR 8 L INR 9.32 Lacs - INR 12.96 L Overall NIRF Ranking 2025 3 NA Selection criteria UCEED NIFT Entrance Exam\"}},{\"@type\":\"Question\",\"name\":\"What is the hostel fee for IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Students who get the hostel facility have to pay for the hostel charges, which include various one-time and semester-wise payable components such as Mess Fee, Medical Fee, Hostel Amenities Fund, etc. Find below the bifurcation of IIT Bombay hostel charges for undergraduate courses: IIT Bombay Hostel Fee Component Charges (in INR) Hostel Charges INR 9150 (Hostel Rent of INR 2,750/- included) Electricity and Water charges INR 4000 Hostel Amenities Fund INR 1800 Hostel-Mess Security Deposit (one time) INR 5000 Total Hostel Fee (A) INR 19,950 Per Semester Mess Advance (B) INR 22,500 Total Fees Payable (A+B) INR 42,450 Note: The above amount are the autumn semester charges for UG courses. The final amount may differ as per the semester and course preference.\"}},{\"@type\":\"Question\",\"name\":\"What is the total fee of B.Tech at IIT Bombay for 4 years?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay BTech programmes total tuition fees is INR 8 lakh (inclusive of the integrated BTech-MTech fee). Additionally, SC/ ST/ PwD candidates are exempted from paying tuition fees for UG courses. It further reserves the right to revise the fee in subsequent semesters. Moreover, given fee is as per the data collected from unofficial sources. Hence, is subject to change.\"}},{\"@type\":\"Question\",\"name\":\"How do I prepare for admission in Design courses at IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Admission to Design courses at IIT Bombay requires qualifying the UCEED for B.Des or CEED for MDes. Check below some prepration strategies for admission in design courses at IIT Bombay: Review the exact structure of the exam, the types of questions and the time constraints. Break the syllabus down into smaller actionable goals. Dedicate specific blocks to theory, practice, and the review of incorrect answers. Students must solve mock tests and previous year papers to build confidence so they don't run out of time on test day.\"}},{\"@type\":\"Question\",\"name\":\"How can I get admission in IIT Mumbai?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay admission to all the courses is entrance-based (Except for EMBA, where admission is merit-based and performance in the interview round). The IIT Bombay admission process includes the application process, selection round, cutoff, merit list or counselling and other steps. For BTech, candidates have to clear JEE Main and JEE Advanced. Further for other courses such as MTech, MBA, MSc, BDes, and MDes, aspirants need to clear GATE, CAT, IITJAM, UCEED, and CEED, respectively to qualify for further admission rounds.\"}},{\"@type\":\"Question\",\"name\":\"Which exam score is accepted for IIT Bombay admissions for the M.Tech course?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GATE results will be accepted by IIT Bombay for admission to the M.Tech programme. Candidates must secure at least 60% of the total marks (55% of the total marks for SC/ST/PwD category) in any of the following degrees: BE, B.Tech, B.Sc., Bachelor of Architecture and Bachelor of Planning, M.Sc., MCA, MBBS, M.Pharm, B.Pharma, BDS or a recognised qualification equivalent to BE or B.Tech.\"}},{\"@type\":\"Question\",\"name\":\"What is the IIT Bombay GATE cutoff 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay GATE cutoff 2026 was released till last round for admission to the MTech course for various All India categories. For the General AI category, its last round closing rank ranged from 325 to 650. Hence, a score of at least 510 is required to be eligible for admission. Students can refer to the list of pointers below to see the cutoff range of other categories. OBC: 585 - 459 SC: 433 - 217 ST: 433 - 217 EWS: 650 - 325\"}},{\"@type\":\"Question\",\"name\":\"What is the IIT Bombay JAM cutoff for the OBC category?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay JAM cutoff 2026 for the OBC category ranged from 65 in the first round to 1217 in the last round. As per this range, MSc in Applied Geology came out as the most preferred course for admission. Students who want admission to this course need to attain a rank of at least 65 to be qualified for admission. Candidates can check the table below to know the Round 1 and Last Round closing ranks for the OBC AI category. Course Round 1 Cutoff 2026 Last Round Cutoff 2026 M.Sc. in Physics 118 203 M.Sc. in Biotechnology 71 97 M.Sc. in Applied Geology 65 65 M.Sc. in Applied Geophysics 658 688 M.Sc.+ Ph.D. in Environmental Science and Engineering 1217 1217 M.Sc. in Mathematics 109 128 M.Sc. in Applied Statistics and Informatics 82 138 M.Sc. in Chemistry 142 169 M.Sc. + Ph.D. in Energy Science and Engineering 842 1030 M.Sc. in Operations Research 156 177\"}},{\"@type\":\"Question\",\"name\":\"What is the application fee for M.Tech admissions at IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The application fee for M.Tech at IIT Bombay differs for each category. Below is the M.Tech application fee at IITB: Category MTech Application fee for Regular Period MTech Application fee for Extended period Women candidates INR 150 INR 650 SC/ ST/ PwD category candidates INR 150 INR 650 All other candidates INR 300 INR 800\"}},{\"@type\":\"Question\",\"name\":\"Can I get MTech in IIT Bombay with GATE?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, GATE score is required to get admission to IIT Bombay course. However, aspirants who have not qualified GATE can also get admission based on written test conducted by the institute. The shortlisted candidates are further called for a personal interview round. In order to be eligible to apply for the course, an aspirant must have a BE/ BTech/ BSc/ Bachelor of Architecture and Bachelor of Planning/ MSc/ MCA/ MBBS/ MPharm/ BPharm/ BDS/ degree recognised equivalent to BE/ BTech with a minimum of 60% aggregate (55% aggregate for SC/ ST/ PwD category) earned through Associate Membership Examinations conducted by recognised professional bodies to apply for MTech course.\"}},{\"@type\":\"Question\",\"name\":\"How can I get into IIT Bombay for MDes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay admission to MDes programme is entrance-based. Candidates have to follow the below steps to get a seat in the MDes programme: Step 1: Candidates meeting the eligibility requirements have to pay an application fee to register for MDes course. Step 2: IIT Bombay selects candidates for MDes programme based on CEED score. After qualifying CEED, the institute releases a category-wise merit list for each stream. Eligible candidates are required to appear for an IDC (written test) and an interview round. Step 3: After the completion of the selection rounds, IITB releases a final merit list. Selected candidates will then have to appear for the verification of documents in order to complete the admission.\"}},{\"@type\":\"Question\",\"name\":\"How many seats are there in IIT Bombay for BDes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"There a total of 37 seats available in BDes course at IIT Bombay. The seats are filled based on UCEED score. As there are only a few seats, candidates must obtain a good rank in UCEED for admission. Below is category-wise intake for BDes: Category Intake Open 14 SC 5 ST 3 EWS 4 OBC-NCL 9 Open-PwD 1 OBC-NCL-PwD 1 Note: PwD reservation at 5% will be horizontal.\"}},{\"@type\":\"Question\",\"name\":\"Can I apply offline for IIT Bombay admission?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No, students cannot apply offline for IIT Bombay admissions. The entire application process is conducted online through the relevant entrance exam portal. For all programmes including BTech, MTech, BDes, MDes, MBA, etc., students must register and submit details through their respective entrance portals.\"}},{\"@type\":\"Question\",\"name\":\"Who is eligible for BDes in IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A minimum of Class 12 is required to apply for BDes course at IIT Bombay. Below is the detailed eligibility: Aspirants should have obtained a rank in UCEED. A candidate can attempt UCEED a maximum of two times, and that too in consecutive years. UCEED score is valid for one year and only for admissions in the same corresponding academic year. Candidates need to pass all five subjects in Class 12 or equivalent. Those who have appeared for the first time in the qualifying exam in 2022 or earlier are not eligible.\"}},{\"@type\":\"Question\",\"name\":\"Which courses does Industrial Design Centre - IIT Bombay offer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Industrial Design Centre - IIT Bombay provides programmes including B.Des, M.Des in streams such as Design, Animation, and are excellent for students to build their careers. The institute has specializations in Fashion Design, UI / UX, Automotive Design.\"}},{\"@type\":\"Question\",\"name\":\"What is the JAM cutoff for IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay JAM cutoff 2026 has been released for admission to the MSc and MSc+ PhD courses. The cutoff was announced for different categories under the All India quota. For the General AI category, the overall cutoff ranged from 15 (MSc in Biotechnology) to 839 (MSc+ PhD in Environmental Science and Engineering). As per the last round closing ranks, MSc in Applied Geology (17), followed by MSc in Biotechnology (26) and MSc in Applied Statistics and Informatics (35) were the most preffered courses for admission. General AI category students can look at the table below to know the Round 1 and Last Round Closing Ranks for different courses. Course Round 1 Cutoff 2026 Last Round Cutoff 2026 M.Sc. in Physics 39 64 M.Sc. in Biotechnology 15 26 M.Sc. in Applied Geology 16 17 M.Sc. in Applied Geophysics 390 451 M.Sc.+ Ph.D. in Environmental Science and Engineering 710 839 M.Sc. in Mathematics 34 55 M.Sc. in Applied Statistics and Informatics 22 35 M.Sc. in Chemistry 33 36 M.Sc. + Ph.D. in Energy Science and Engineering 582 593 M.Sc. in Operations Research 26 90 Note: Other categories will have different cutoffs.\"}},{\"@type\":\"Question\",\"name\":\"Can I get IIT Bombay at 500 rank in IIT JAM?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, you might get into IIT Bombay with a rank of 500 depending on the course and category. For the General AI category, the highest rank acceptable was 839. While the more sought-after courses, like M.Sc. in Chemistry or Mathematics, Physics, etc., might not be available, other courses might still be up for grabs. To know the same, see below. Course Last Round Cutoff 2026 M.Sc. + Ph.D. in Energy Science and Engineering 593 M.Sc.+ Ph.D. in Environmental Science and Engineering 839 Note: Other categories, rounds, courses, etc, will have different cutoffs.\"}},{\"@type\":\"Question\",\"name\":\"What is the female-only OBC category BTech cutoff at IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For the OBC female category, the last round cutoff ranged from 280 (BTech CSE) to 5353 (BS in Environmental Science and Engineering). Among all BTech courses, BTech CSE was the most sought-after course for admission, with the cutoff rank of 280. In the case of BS courses, BS in Economics was the most competitive course, with the closing rank of 3139. Students can check the table below to know the Round 1 and Last Round closing ranks for other courses. Course Last Round Cutoff 2026 B.Tech. in Aerospace Engineering 3632 B.Tech. in Chemical Engineering 3280 B.Tech. in Civil Engineering 4410 B.Tech. in Computer Science and Engineering 280 B.Tech. in Electrical Engineering 885 B.Tech. in Metallurgical Engineering and Materials Science 4498 B.Tech. in Mechanical Engineering 2990 B.Tech. in Engineering Physics 3840 B.S. in Chemistry 7860 B.S. in Economics 3139 B.S. in Mathematics 3185 B.Tech. + M.Tech. in Electrical Engineering 1651 B.Tech. in Energy Engineering 4313 B.Tech. in Environmental Science and Engineering 5353 B.Tech. in Industrial Engineering and Operations Research 2608 B.S. in Applied Geophysics 7744 Note: Other categories, rounds, etc, will have different cutoffs.\"}},{\"@type\":\"Question\",\"name\":\"Can I get IIT Bombay with a UCEED rank of 20?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No, you cannot get IIT Bombay with a rank of 20 no matter which category you belong to. As per the cutoff data, the highest rank admissable was 16 for the General AI category. Howeever, with a rank of 20, you can get into IIT Delhi, if you belong to the General or OBC AI category. For both these categories, the highest admissable rank was 28 and 32, respectively. Please know that other categories will have different cutoffs.\"}},{\"@type\":\"Question\",\"name\":\"What is the JEE Main cutoff for admission to BTech CSE at IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The JEE Main cutoff 2026 for admission to BTech CSE at IIT Bombay stood at 67 in the first round for the General AI category. For OBC, the first round closing rank was 60. There has been a drop in the closing rank this year when compared to the last years. Below is the CSE cutoff at IIT Bombay in the last 3 years: Course 2024 2025 2026 B.Tech. in Computer Science and Engineering 68 66 67\"}},{\"@type\":\"Question\",\"name\":\"How many students are placed during IIT Bombay placements?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The complete placement report for 2026 is not yet released. The course-wise number of students placed over the past two years are presented below: Course Students Placed (2024) Students Placed (2025) BTech 683 678 Dual Degree BTech 152 357 MTech 415 390\"}},{\"@type\":\"Question\",\"name\":\"How many offers were made during IIT Bombay placements?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IITB placements 2026 complete report is not released yet. In the meantime, the department-wise offers accepted / students placed during IIT Bombay placements 2025 is presented below: Departments Students Placed (2025) Chemical Engineering 98 Electrical Engineering 244 Mechanical Engineering 213 Civil Engineering 133 Computer Science Engineering 258\"}},{\"@type\":\"Question\",\"name\":\"Can I join IIT Bombay after Class 12?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Admission to the institute after Class 12 is open for BTech, BS and BDes courses. After completing Class 12, candidates must qualify JEE Main, JEE Advanced followed by the JoSAA Counselling for BTech and BS courses. For BDes, UCEED score is required for admission.\"}},{\"@type\":\"Question\",\"name\":\"Is JEE Main required for admission in IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, JEE Main is required for admission to IIT Bombay's BTech programmes. It is an eligibility requirement for JEE Advanced. Students cannot get admission to IIT Bombay using only the JEE Main score. Aspirants must appear for JEE Advanced and participate in JoSAA counselling for final seat allotment in BTech course.\"}},{\"@type\":\"Question\",\"name\":\"How can I get admission to the MA by Research course at IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Students holding Bachelor's degree with 60 percent marks (55 percent for reserved category) are eligible to apply. Eligible students should visit the IIT Bombay website to fill the application form. The selection is through GATE or MAAT exam followed by an interview round.\"}},{\"@type\":\"Question\",\"name\":\"Is there any scholarship for IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The institute offers Merit-cum-Means Scholarship to a maximum of 25% of the sanctioned intake of UG and MSc students. Facilities of Free Messing is also available to SC/ ST students under which they get an exemption from paying the tuition fees. In addition, the Office of the Dean Alumni & Corporate Relations manages the Named scholarship endowed by the alumni of the Institute and other wellwishers. In order to avail of any of the offered scholarships, candidates must meet the eligibility conditions set for the respective scholarships. For more information about the offered scholarships, click here.\"}},{\"@type\":\"Question\",\"name\":\"What types of scholarships are offered by IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay offers many financial aids like Merit-cum-Means scholarship, full or partial fee waivers schemes, and SC/ST Support Facilities. Additionally, female undergraduate students can apply for Women Merit Scholarships, and top-performing students can receive Donor & Alumni Named Scholarships.\"}},{\"@type\":\"Question\",\"name\":\"Does IIT Bombay offer any merit scholarship?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, IIT Bombay offers Merit-cum-Means Scholarship to UG students. It is awarded to a maximum of 25% of sanctioned intake. For Dual degree, it is available only up to fourth year. Merit Criterion: For new entrants of BDes their UCEED Rank, will be the criterion. In subsequent years, the criterion will be their academic performance during the preceding academic year. Means Criterion: The parental income is the basis for the ‘means' criterion of the scholarship. At present, students with parents annual gross income from all sources for the previous Financial year does not exceed INR 5 Lacs are eligible to apply for Merit cum Means Scholarship.\"}},{\"@type\":\"Question\",\"name\":\"What are the scholarships offered by BDes programme of IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay offers merit-based scholarships to BDes students. Applications for the scholarships are forwarded through IIT. The available scholarships are further as follows: Institute Merit-cum-Means Free Mess Facilities (SC/ST) Remission of Fees Named Scholarships\"}},{\"@type\":\"Question\",\"name\":\"Which course is best in IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay is one of the top Engineering institute in the country. It is ranked by various bodies. National Institutional Ranking Framework (NIRF) 2026 has ranked IIT Bombay, #3 in the \\\"Engineering\\\" category. BTech is the flagship programme of the institute. Moreover, the institute also offers MBA programme. IIT Bombay is also well-known for its Management course. It has secured #10 position in the NIRF 2024 rankings in the Management category.\"}},{\"@type\":\"Question\",\"name\":\"What is the eligibility to join in IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay admissions are entrance-based. Candidates must also fulfil the requirements specified by the institute. The eligibility criteria varies course-wise at IIT Bombay. Check below the eligibility of top IIT Bombay courses: Course Name Common Eligibility BTech Class 12 with a minimum of 75% aggregate in PCM BS Class 12 with a minimum of 75% aggregate in PCM MBA Bachelor’s degree or a Master’s degree with at least 60% marks (55% in case of candidates belonging to SC/ST/PWD category) MTech Bachelor's degree with a minimum of 60% aggregate (55% aggregate for SC/ ST/ PwD category) <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/phd-bc\\\">PhD</a> Bachelor or Masters or equivalent degree with a minimum of 60% aggregate (55% aggregate for SC/ ST/ PwD category)\"}},{\"@type\":\"Question\",\"name\":\"Is IIT Bombay good for MBA courses?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"MBA is one of the popular courses at IIT Bombay, offered through the Shailesh J. Mehta School of Management. The institute has a good ranking in the Management category. Here are a few parameters that will help candidates decide if IIT Bombay is a good option for pursuing an MBA: Rankings: IIT Bombay has ranked #3 under the 'Engineering' category by Outlook Rankings 2026. In 2025, NIRF ranked the institute #3 in the 'Engineering' category, same as last year's rank. Placements: IIT Bombay conducts a placement drive every year. Students pursuing an MBA can get placed in the top companies through the placement drive. The highest and average package offered during SJMSOM IIT Bombay MBA placements 2026 stood at INR 53.8 LPA and INR 28.16 LPA. Further, the placement rate recorded during SJMSOM MBA placements 2026 was 100% and 51 companies visited the placement drive. Faculty: As per IIT Bombay Shiksha Reviews, every faculty member here is highly qualified, and many of them have multiple publications in renowned research journals.\"}},{\"@type\":\"Question\",\"name\":\"Is BTech available in IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, IIT Bombay offers a four-year BTech in various specialisations. Admission to these programmes is based on merit in JEE Advanced. Only the students who pass JEE main can take the advanced exam. The aspirants who furher meet the cutoff criteria can participate in JoSAA counselling. Some of the BTech specialisations offered by IIT Bombay are enlisted below: Aerospace Engineering Electrical Engineering Mechanical Engineering Chemical Engineering Computer Science & Engineering Metallurgical Engineering & Materials Science Engineering Physics Civil Engineering\"}},{\"@type\":\"Question\",\"name\":\"Is IIT Bombay MBA ranked?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay Management course is ranked by various agencies. In NIRF 2025, the institute was ranked at 3rd position in the 'Business & Management Studies' and 'BE/ BTech' category. In its engineering, IIT Bombay ranked #1 under 'BE/ BTech' and 'Engineering' category in The Week Ranking 2026. Additionally, in the Outlook Ranking 2026, the institute ranked #3 in the 'Engineering' category.\"}},{\"@type\":\"Question\",\"name\":\"What is the overall NIRF ranking of IIT Bombay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In the officially NIRF rankings released by the Ministry of Eduication, IIT Bombay consistently secures 3rd position in both Overall and Engineering categories. Additionally, the insititute ranks 2nd in Innovation, 4th in Research. Also, holds 14th position in Management nationally.\"}},{\"@type\":\"Question\",\"name\":\"What is IIT Bombay's ranking on global platforms like QS?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Bombay is recognised among the world's top higher education insititutions. It holds high ranks among both national and international bodies. In the QS world ranking 2027, it has been ranked #134 globally, #4 in 'Asia University Rankings' and #267 in 'QS Sustainability Ranking'.\"}}]},\"similarWidgetHeading\":\"Other Popular IITs\",\"predictorUrlFlag\":true,\"beaconData\":{\"hierarchy\":[{\"stream_id\":2,\"substream_id\":0,\"specialization_id\":108,\"primary_hierarchy\":1}],\"baseCourseId\":10,\"credential\":{\"id\":9,\"name\":\"Degree\"},\"level\":{\"id\":14,\"name\":\"UG\"},\"deliveryMethod\":{\"id\":33,\"name\":\"Classroom\"},\"educationType\":{\"id\":20,\"name\":\"Full Time\"},\"cityId\":151,\"stateId\":114,\"flagshipCourseId\":109575,\"examIds\":[6244,6245],\"instituteOwnership\":\"Public/Government\",\"instituteListingType\":\"university\",\"isInstituteClient\":0},\"ownership\":\"Public/Government\",\"isKnowledgeBoxHidden\":1,\"authorDetails\":{\"authorId\":78007874,\"updatedDate\":\"11-23-2026 16:41\",\"createdDate\":\"2017-10-04T12:42:46\",\"pageType\":\"institute_info\",\"authorDisplayName\":\"Sarfaraz200136713\",\"authorImageUrl\":\"\",\"firstName\":\"Al\",\"lastName\":\"Kashaf\",\"description\":\"<p><strong>Role:</strong> Content Author</p>\\n<p><strong>Specializes In:</strong> Creative Writing &amp; University Content</p>\\n<p>Al Kashaf is an experienced content writer and editor with 2 years of experience in content writing, editing and publishing. She has done her Bachelor’s degree in Journalism and Mass Communication. At Shiksha.com, Al Kashaf mainly deals with updating the university pages with accurate and detailed information. Her efforts help the aspirants get all the information about admissions, courses, fees structure and university campus life that helps them make informed decisions for enrollment.</p>\\n<p><strong>Highlights</strong></p>\\n<ul>\\n<li>2 years of experience in content writing, editing and education publishing.</li>\\n<li>Bachelor's Degree in Journalism and Mass Communication provides her with a solid base in re