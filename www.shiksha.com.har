          "cookies": [],
          "content": {
            "size": 362200,
            "mimeType": "application/json",
            "text": "{\"status\":\"success\",\"data\":{\"status\":200,\"pageType\":\"iulp\",\"listingName\":\"IIT Kanpur - Indian Institute of Technology\",\"listingNameWithCityLocality\":\"IIT Kanpur - Indian Institute of Technology\",\"listingId\":25116,\"listingType\":\"institute\",\"customizedCtas\":{\"primary\":{\"ctaText\":\"Placement PDF\",\"actionType\":\"download\",\"ctaType\":\"registration\",\"url\":\"/mediadata/pdf/1794893310phpNTiEKO.pdf\",\"ctaColor\":\"ORANGE_WHITE\"},\"secondary\":{\"ctaText\":\"Fee Details\",\"actionType\":\"download\",\"ctaType\":\"registration\",\"url\":\"/mediadata/pdf/1794893328phpiEsGoY.pdf\",\"ctaColor\":\"BLUE_WHITE\"}},\"seoUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116\",\"anaUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116/questions\",\"rankingPageUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116/ranking\",\"feesPageUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116/fees\",\"scholarshipInfo\":{\"scholarShipDetails\":[{\"listingId\":null,\"description\":\"Merit-cum-Means (MCM) Scholarships:\\n\\nThe Institute gives Merit-cum-Means (MCM) Scholarships to meritorious and needy students. Details and Criteria are given below:\\n\\nAn undergraduate (UG) student in the 4-year, 5-year, or 2-year M.Sc. program can receive the MCM scholarship subject to the following criteria/conditions:\\n\\n1) Up to 25% of the students in a batch may be awarded the MCM scholarship. From the total number of MCM Scholarships available in each batch, 20% shall be reserved for students belonging to the SC/ST category. The SC/ST students are not to be compared with the GN/OBC students.\\n2) The MCM scholarships unutilized in a batch may be transferred to another batch. Similarly, the MCM scholarships unutilized in SC/ST category may be transferred to other category students.\\n3) A student should have a CPI of 6.5 or above to be eligible to receive a full MCM scholarship (freeship + pocket allowance). If the CPI of a student falls below 6.5 (but remains above 6.0), then the pocket allowance is withdrawn.\\n4) For the first-year UG students, common JEE-AIR or marks obtained will be used for awarding the MCM scholarship.\\n5) A student must not have had an 'F' grade(s) in one or more courses in the last two regular semesters to receive the MCM scholarship.\\n6) Total Family Annual Income (TFAI) of the student from all sources should be less than 6.0 lacs.\\n7) The student must not be getting any other scholarship either from IIT Kanpur or from any other external sources.\",\"scholarship_type_id\":201,\"scholarship_type_name\":\"Scholarship\"},{\"listingId\":null,\"description\":\"Inspire Scholarships:\\n\\nThe Department of Science and Technology (DST), Government of India gives Scholarships for Higher Education (SHE), called INSPIRE-SHE Scholarships, to the students enrolled in undergraduate programs in natural and basic sciences all across the country in order to inspire them to become leading scientists.\\n\\nThe details of the INSPIRE Scholarship are provided below:\\n\\n1) Students pursuing 4-Year BS and 5-Year BS-MS Dual Degree programs in natural and basic sciences AND have secured rank within top 10,000 in JEE-AIR are eligible to apply for INSPIRE Scholarship.\\n2) Applicants must have secured marks within top 1% of their board\\n3) Applicants must have secured rank within top 10,000 in JEE-AIR\\n4) Applicants are KVPY, NTSE, JBNSTS scholar, or International Olympiad medalist\\n5) As per the DST guidelines, the students pursuing BS program in Economics and B. Tech./Dual-Degree programs in Engineering are NOT eligible to receive INSPIRE Scholarship.\\n6) If applicants have failed in one or more courses or their CPI is below 7.0, then they are NOT eligible to receive INSPIRE scholarship.\\n7) The IIT Kanpur facilitates the application and award process for its students as per the DST guidelines available at: http://www.inspire-dst.gov.in/SHE.html.\\n8) A student must apply for the Inspire Scholarship on the prescribed application form before the last date for submitting the application form.\\n\\nTo know more about scholarships, please click on https://www.iitk.ac.in/sspc/\",\"scholarship_type_id\":201,\"scholarship_type_name\":\"Scholarship\"}],\"allScholarshipPageUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116/scholarships\",\"pdfUrl\":null,\"scholarshipSummaryInfo\":null},\"media\":{\"photos\":{\"Others\":[{\"mediaId\":1826266,\"thumbUrl\":\"https://images.shiksha.com/mediadata/images/1745958470phpSHEIHJ_100x78.jpg\",\"mediaUrl\":\"https://images.shiksha.com/mediadata/images/1745958470phpSHEIHJ.jpeg\",\"widgetThumbUrl\":\"https://images.shiksha.com/mediadata/images/1745958470phpSHEIHJ_205x160.jpg\",\"mediaTitle\":\"Flight Lab\",\"altText\":\"IIT Kanpur Others\",\"uploadedDate\":\"2025-04-30T02:16:10\"}],\"Labs\":[{\"mediaId\":522636,\"thumbUrl\":\"https://images.shiksha.com/mediadata/images/1488177801phpVL5kR9_100x78.jpg\",\"mediaUrl\":\"https://images.shiksha.com/mediadata/images/1488177801phpVL5kR9.jpeg\",\"widgetThumbUrl\":\"https://images.shiksha.com/mediadata/images/1488177801phpVL5kR9_205x160.jpg\",\"mediaTitle\":\"Computer Lab\",\"altText\":\"IIT Kanpur Labs\",\"uploadedDate\":\"2020-11-26T22:04:28\"}],\"Academic Block\":[{\"mediaId\":1094091,\"thumbUrl\":\"https://images.shiksha.com/mediadata/images/1606408199phpAwEWkH_100x78.jpg\",\"mediaUrl\":\"https://images.shiksha.com/mediadata/images/1606408199phpAwEWkH.jpeg\",\"widgetThumbUrl\":\"https://images.shiksha.com/mediadata/images/1606408199phpAwEWkH_205x160.jpg\",\"mediaTitle\":\"Header Image\",\"altText\":\"IIT Kanpur Academic Block(1)\",\"uploadedDate\":\"2020-12-01T15:01:29\"},{\"mediaId\":1349445,\"thumbUrl\":\"https://images.shiksha.com/mediadata/images/1652079454php4jTXZj_100x78.jpg\",\"mediaUrl\":\"https://images.shiksha.com/mediadata/images/1652079454php4jTXZj.jpeg\",\"widgetThumbUrl\":\"https://images.shiksha.com/mediadata