12th\",\"shikshaUrl\":{\"url\":\"/boards/science-commerce-and-arts/cbse-12th-board\",\"urlHost\":\"relative\",\"absoluteUrl\":\"https://www.shiksha.com/boards/science-commerce-and-arts/cbse-12th-board\"}}],\"myShikshaPageData\":null,\"loggedIn\":false,\"websiteSchema\":{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Shiksha.com\",\"url\":\"Discover Colleges, Courses & Exams for Higher Education in India\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"Discover Colleges, Courses & Exams for Higher Education in India\",\"query-input\":\"required name=search_term_string\"}},\"webpageSchema\":{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Discover Colleges, Courses & Exams for Higher Education in India\",\"description\":\"Get Detailed Information on Top Colleges, Courses & Exams in India. Get alerts about Ranking, Cutoff, Placements, Fees & Admissions of 30,000+ Colleges & Universities. Get Question Papers, Syllabus & Important dates of 500+ exams.\",\"url\":\"Discover Colleges, Courses & Exams for Higher Education in India\",\"author\":{\"@type\":\"Organization\",\"name\":\"Shiksha.com\"}},\"usersInfo\":{\"5712995\":{\"userId\":5712995,\"firstName\":\"Vipra\",\"lastName\":\"Shrivastava\",\"name\":\"Vipra Shrivastava\",\"displayName\":\"VipraSrivastava\",\"city\":74,\"locality\":778,\"country\":2,\"imageURL\":\"/mediadata/images/1483692921phpIgfHw9.jpeg\",\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/VipraSrivastava\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":2022,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"PG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"YES\",\"ldbuser\":\"YES\",\"ndnc\":\"YES\",\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"1\",\"abroadUser\":false},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/VipraSrivastava\",\"isAbroad\":false,\"description\":\"<p>Vipra Shrivastava is MA in English Literature from Delhi University with extensive experience in content writing of over 14 years. She has been handling content for Management, Accounting and Commerce streams for 8 years at Shiksha. As an expert, she has been creating content to guide students in cracking MBA entrance exams such as CAT, XAT, MAT, CMAT, and SNAP. She also authors detailed blogs and online guides Management and Accounting courses and related career.</p>\\n<p><strong>Highlights:</strong></p>\\n<ul>\\n<li>Management and Accounting with special focus on MBA entrance exams in India</li>\\n<li>Authored 3000+ articles for Shiksha with over 36 million reads.</li>\\n<li>Simplifying complex exam/admission processes into user friendly content.</li>\\n<li>Provides latest and verified exam updates to Shiksha readers for making informed decision.</li>\\n</ul>\\n<p>Vipra is dedicated to producing authentic and student friendly content that guides in academic challenges and career aspirations.</p>\",\"twitterLink\":null,\"facebookLink\":\"https://www.facebook.com/vipra.shrivastava/\",\"linkedinLink\":\"https://www.linkedin.com/in/vipra-shrivastava-75943613/\",\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":78,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"yes\"},\"96365866\":{\"userId\":96365866,\"firstName\":\"Samridhi\",\"lastName\":\"Mishra\",\"name\":\"Samridhi Mishra\",\"displayName\":\"Samridhi2025818964\",\"city\":95,\"locality\":null,\"country\":2,\"imageURL\":null,\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/Samridhi2025818964\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":null,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"UG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"NO\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"1\",\"abroadUser\":false},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/Samridhi2025818964\",\"isAbroad\":false,\"description\":\"<div>\\n<div>Samridhi Mishra is a seasoned writer in the Indian engineering education sector. She understands most of the engineering competitive exams: JEE, MHT CET, BITSAT, COMEDK UGET etc. News articles, live blogs, social media scripts, anchoring-she has done it all to connect with her audience the best.</div>\\n<h3>Highlights:</h3>\\n<div><strong>Specialisation:</strong> Concentrated expertise in the engineering field.<br><strong>Reach:</strong> Engagement rates confirm that she reaches a high number of target audiences.<br><strong>Various Formats:</strong> Quick news updates to tips and tutorials-her content is designed to suit all kinds of needs.<br><strong>Relevant Stories:</strong> Timely, pre-exam coverage up until admission, she works on data-driven stories relevant to aspirants.</div>\\n<div>&nbsp;</div>\\n</div>\\n<p>Contact- samridhi.mishra@shiksha.com<br>LinkedIn- <a href=\\\"https://www.linkedin.com/in/samridhi-mishra-3793b9297/\\\" rel=\\\"nofollow\\\">Samridhi Mishra</a></p>\",\"twitterLink\":null,\"facebookLink\":null,\"linkedinLink\":\"https://www.linkedin.com/in/samridhi-mishra-3793b9297/\",\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":63,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"no\"},\"59961703\":{\"userId\":59961703,\"firstName\":\"Sanjana\",\"lastName\":\"Surbhi\",\"name\":\"Sanjana Surbhi\",\"displayName\":\"Sanjana849031986\",\"city\":161,\"locality\":null,\"country\":2,\"imageURL\":null,\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/Sanjana849031986\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":null,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"PG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"YES\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"0\",\"abroadUser\":false},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/Sanjana849031986\",\"isAbroad\":false,\"description\":\"<p>Sanjana Surbhi is education focused content specialist with over five years of experience in education sector. She covers engineering and government exams. She holds Bachelor’s degree in Mass Communication from Patna Women’s College and completed her PG Diploma in Journalism from National School of Journalism Bangalore in 2018.</p>\\n<h4><strong>Highlights</strong></h4>\\n<p><strong>Domain Expertise:</strong> Sanjana covers Board Exam Result, engineering entrance and government recruitment (Sarkari Naukri) exams.<br><strong>Experience:</strong> With over five years of editorial experience in education sector, she specialises in creating reliable content on engineering and government exam streams.<br><strong>Focus:</strong> She delivers accurate and student friendly updates on national and state level entrance exams and admissions trends.<br>&nbsp;<br><strong>Contact: <a href=\\\"mailto:sanjana.surbhi@Shiksha.com\\\" rel=\\\"nofollow\\\">sanjana.surbhi@Shiksha.com</a></strong></p>\\n<p><strong>Specialisations:</strong> Engineering Exams and Sarkari Exams</p>\",\"twitterLink\":\"https://twitter.com/sanjana_surbhi\",\"facebookLink\":null,\"linkedinLink\":null,\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":77,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"no\"},\"61302717\":{\"userId\":61302717,\"firstName\":\"Vikash Kumar\",\"lastName\":\"Vishwakarma\",\"name\":\"Vikash Kumar Vishwakarma\",\"displayName\":\"Vikash1965490648\",\"city\":161,\"locality\":null,\"country\":2,\"imageURL\":null,\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/Vikash1965490648\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":null,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"PG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"NO\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"1\",\"abroadUser\":false},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/Vikash1965490648\",\"isAbroad\":false,\"description\":\"Vikash Kumar is a leading subject matter expert, specializing in K–12 education and competitive exam preparation for JEE Mains. With a BTech degree and over 10 years of experience in creating high quality content for in Physics, Chemistry, and Mathematics, various competitive exams, he creates academic content that blends conceptual clarity with exam-focused strategies. His articles, study guides, and mock tests are trusted by thousands of students preparing for JEE Mains as well as NEET. Vikash can be reached at vikash.k@Shiksha.com.\",\"twitterLink\":null,\"facebookLink\":null,\"linkedinLink\":null,\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":78,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"implicit\"},\"11614203\":{\"userId\":11614203,\"firstName\":\"Anangsha\",\"lastName\":\"Patra\",\"name\":\"Anangsha Patra\",\"displayName\":\"AnangshaPatra\",\"city\":74,\"locality\":898,\"country\":2,\"imageURL\":null,\"workExperience\":1,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/AnangshaPatra\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":2019,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"UG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"YES\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"1\",\"abroadUser\":false},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/AnangshaPatra\",\"isAbroad\":false,\"description\":\"<div>Anangsha Patra is MA in Mass Communication &amp; Journalism with more than 10 years of experience in the field of Journalism, Content Writing and Editing. At Shiksha.Com, she works as Deputy Manager-Content for the Sarkari Exam Domain. Anangsha specialises in developing content for Banking, Defence, SSC, Railway, Teaching related Sarkari Exams such as NDA, SBI Clerk, SBI PO, SSC CPO, RRB NTPC, RRB Group D, IBPS Clerk, IBPS RRB, AFCAT and many more.</div>\\n<div><strong>Professional Role</strong></div>\\n<div>At Shiksha, Anangsha Manage:</div>\\n<div>• Developing content basis student needs and SEO goals</div>\\n<div>• Ensuring accuracy and clarity in content</div>\\n<div>• Real time coverages of events</div>\\n<div><strong>Expertise</strong></div>\\n<div>• Competitive exam content creation-SBI, IBPS, RRB, SSC, UPSC, etc.</div>\\n<div>• SEO-driven content development for Government Jobs</div>\\n<div>• Student-centric communication</div>\\n<div>• Ground Reporting of Government Exams in India</div>\\n<div>• Conducting Topper Interviews</div>\\n<div>• Covering Latest Govt Jobs News</div>\\n<div><strong>Contribution to Students</strong></div>\\n<div>Through her Role, Anangsha Ensures:</div>\\n<div>• Timely updates on Govt exams, results, and admit cards for NDA, SBI Clerk, SBI PO, SSC CPO, RRB NTPC, RRB Group D, IBPS Clerk, IBPS RRB, AFCAT</div>\\n<div>• Comprehensive preparation resources, guides and live blogs</div>\\n<div>Anangsha believes that delivering reliable content with accurate and updated information to students can help aspirants to choose their right careers.</div>\\n<div><strong>Contact</strong></div>\\n<div><strong>Email:</strong> anangsha.patra@shiksha.com</div>\\n<div><strong>Specialises in:</strong></div>\\n<div>Board Exams/Sarkari Exams/Govt Exams</div>\",\"twitterLink\":\"https://twitter.com/anangsha_patra\",\"facebookLink\":null,\"linkedinLink\":\"https://www.linkedin.com/in/anangsha-patra-b558a521a/\",\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":77,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"implicit\"}}},\"message\":null,\"softUpgrade\":null,\"forceUpgrade\":null,\"shortListCount\":0,\"notificationCount\":0,\"site\":\"\",\"partialResponse\":false}"
