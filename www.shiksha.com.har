            "text": "{\"status\":\"success\",\"data\":{\"status\":200,\"listingId\":25116,\"listingType\":\"institute\",\"listingName\":\"IIT Kanpur - Indian Institute of Technology\",\"isRMCEnabled\":false,\"seoUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116/reviews\",\"breadCrumb\":[{\"name\":\"Home\",\"url\":\"/\",\"linkText\":null,\"entityId\":null,\"entityType\":null,\"pwa\":true},{\"name\":\"Colleges in Kanpur\",\"url\":\"/colleges/kanpur\",\"linkText\":null,\"entityId\":122,\"entityType\":\"city\",\"pwa\":true},{\"name\":\"IIT Kanpur\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116\",\"linkText\":null,\"entityId\":null,\"entityType\":null,\"pwa\":true},{\"name\":\"reviews\",\"url\":null,\"linkText\":null,\"entityId\":null,\"entityType\":null,\"pwa\":true}],\"instituteTopCardData\":{\"instituteName\":\"IIT Kanpur - Indian Institute of Technology\",\"h1\":\"IIT Kanpur: Cutoff 2026, Fees, Courses, Placement, Admission and Ranking\",\"instituteSpecificationType\":\"College\",\"inlineData\":{\"ownership\":\"Public/Government\",\"estbYear\":\"1959\"},\"headerImageDesktop\":null,\"headerImageMobile\":null,\"headerImageDesktopNew\":\"https://images.shiksha.com/mediadata/images/1606408194phpeXUl1t_1280x960.jpg\",\"headerImageMobileNew\":\"https://images.shiksha.com/mediadata/images/1488177388php2b8Al7_270x200.jpg\",\"logoImageUrl\":\"https://images.shiksha.com/mediadata/images/1570693266php1HVCm6.jpg\",\"affiliationData\":null,\"instituteImportantData\":{\"autonomous\":true,\"nationalImportance\":true,\"univeristyTypeWithSpecification\":null,\"univeristyInstitutionType\":null,\"ugcApproved\":false,\"naacAccreditation\":null,\"aiuMember\":false},\"parentUniversityData\":null,\"rankingData\":[],\"instituteDisplayName\":\"IIT Kanpur\",\"ctaPdfUrl\":null,\"mediaCount\":27,\"photoCount\":22,\"videoCount\":5,\"currentLocationInterlinkings\":{\"CITY\":\"/colleges/kanpur\"},\"reviewDetails\":null,\"instituteShortName\":\"IIT Kanpur\",\"instituteAbbreviation\":\"IITK\",\"showBudgetCalculator\":false,\"shortNameAbbOrFullName\":\"IIT Kanpur\"},\"l2Menu\":[{\"name\":\"College Info\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":null,\"altText\":\"All About IIT Kanpur\"},{\"name\":\"Courses\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/courses\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Courses 2027\",\"headingPrefix\":null,\"altText\":\"IIT Kanpur Courses\"},{\"name\":\"Fees\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/fees\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Fees 2027\",\"headingPrefix\":null,\"altText\":\"IIT Kanpur Fees\"},{\"name\":\"Reviews\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/reviews\",\"menuSelected\":true,\"pwa\":true,\"headingSuffix\":\"Reviews on Placements, Faculty & Facilities\",\"headingPrefix\":null,\"altText\":\"IIT Kanpur Reviews\"},{\"name\":\"Admissions\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/admission\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Admission 2027 - Cutoffs, Eligibility & Dates\",\"headingPrefix\":null,\"altText\":\"IIT Kanpur Admissions 2027\"},{\"name\":\"Placements\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/placement\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Placement - Highest & Average Salary Package\",\"headingPrefix\":null,\"altText\":\"IIT Kanpur Placements 2027\"},{\"name\":\"Cut-Offs\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/cutoff\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Cut off & Merit List 2027\",\"headingPrefix\":null,\"altText\":\"IIT Kanpur Cut Offs\"},{\"name\":\"Rankings\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/ranking\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":null,\"altText\":\"IIT Kanpur Rankings\"},{\"name\":\"Gallery\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/gallery\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Gallery 2027\",\"headingPrefix\":null,\"altText\":\"IIT Kanpur Gallery\"},{\"name\":\"Infrastructure\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/infrastructure\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Infrastructure Details & Reviews\",\"headingPrefix\":null,\"altText\":\"IIT Kanpur Infrastructure\"},{\"name\":\"Faculty\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/faculty\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":\"Faculty Details & Reviews\",\"altText\":\"IIT Kanpur Faculty\"},{\"name\":\"Compare\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/compare\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":\"Compare\",\"altText\":\"Compare IIT Kanpur\"},{\"name\":\"Q&A\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/questions\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":null,\"altText\":\"IIT Kanpur Q&A\"},{\"name\":\"Scholarships\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116/scholarships\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":\"Scholarships\",\"headingPrefix\":null,\"altText\":\"IIT Kanpur Scholarships\"},{\"name\":\"JEE Advanced\",\"url\":\"/engineering/jee-advanced-exam\",\"menuSelected\":false,\"pwa\":true,\"headingSuffix\":null,\"headingPrefix\":null,\"altText\":\"JEE Advanced\"}],\"seoData\":{\"instituteAdmissionUrl\":null,\"pageHeading\":\"IIT Kanpur\",\"headingName\":\"IIT Kanpur\",\"headingSuffix\":\"Reviews on Placements, Faculty & Facilities\",\"headingPrefix\":null,\"scriptedText\":null,\"canonicalUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116/reviews\",\"soCanonicalUrl\":null,\"metaTitle\":\"IIT Kanpur Reviews on Placements, Faculty and Facilities\",\"metaDescription\":\"Read 419 IIT Kanpur - Indian Institute of Technology Reviews on Placements, Faculty, Facilities & Infrastructure given by students and alumni across various courses and streams. Download Brochures & Admission details of IITK.\",\"metaKeywords\":\"iit kanpur reviews, iit kanpur students reviews, iit kanpur course reviews, iit kanpur placement reviews, iit kanpur faculty reviews, iit kanpur infrastructure reviews, iit kanpur facilities reviews\",\"prevUrl\":null,\"nextUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116/reviews-2\",\"ampUrl\":null,\"bhst\":null,\"faqContent\":null,\"languageTag\":\"en\",\"noIndex\":null,\"noFollow\":null},\"domain\":\"national\",\"beaconData\":{\"hierarchy\":[{\"stream_id\":2,\"substream_id\":0,\"specialization_id\":108,\"primary_hierarchy\":1}],\"baseCourseId\":10,\"credential\":{\"id\":9,\"name\":\"Degree\"},\"level\":{\"id\":14,\"name\":\"UG\"},\"deliveryMethod\":{\"id\":33,\"name\":\"Classroom\"},\"educationType\":{\"id\":20,\"name\":\"Full Time\"},\"cityId\":122,\"stateId\":126,\"flagshipCourseId\":109925,\"examIds\":[6244],\"instituteOwnership\":\"Public/Government\",\"instituteListingType\":\"institute\",\"isInstituteClient\":0},\"flagshipCourseId\":109925,\"dfpParams\":{\"streamIds\":[2,11,8,9,1,3,14,10,16],\"baseCourseIds\":[10,86,26,100,193,116,101,124,85,195]},\"countryId\":2,\"mapUrl\":\"https://www.google.com/maps/?q=26.512340,80.232894\",\"sdListingId\":25116,\"trendsWidgetRequest\":{\"et\":\"institute\",\"eid\":25116,\"fi\":null,\"pt\":\"uilp\",\"pn\":1,\"rpp\":10,\"wt\":\"Specializations\"},\"listingNameWithCityLocality\":\"IIT Kanpur - Indian Institute of Technology\",\"anaCount\":492,\"articleCount\":844,\"anaCountString\":\"492\",\"instituteDisplayName\":\"IIT Kanpur\",\"allCoursesUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116/courses\",\"instituteShortNameWithLocation\":\"IIT Kanpur\",\"pageSchema\":{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"IIT Kanpur Reviews on Placements, Faculty and Facilities\",\"description\":\"Read 419 IIT Kanpur - Indian Institute of Technology Reviews on Placements, Faculty, Facilities & Infrastructure given by students and alumni across various courses and streams. Download Brochures & Admission details of IITK.\",\"url\":\"https://www.shiksha.com/college/iit-kanpur-indian-institute-of-technology-25116/reviews\"},\"websiteSchema\":{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Shiksha.com\",\"url\":\"https://www.shiksha.com\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://www.shiksha.com/search?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}},\"faq\":{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the highest package offered at IIT Kanpur?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The overall IIT Kanpur highest package has not been released yet. Take a look at the table below to know the IIT Kanpur highest package trends for MBA: Course Highest Package (2023) Highest Package (2024) Highest Package (2025) MBA INR 24 LPA INR 24 LPA INR 36 LPA\"}},{\"@type\":\"Question\",\"name\":\"What is the NIRF Ranking of IIT Kanpur MBA course?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"NIRF has ranked IIT Kanpur under the 'Management' Category for past three-years. Check below the NIRF rankings: Year Rank 2025 27 2022 29 2023 23\"}},{\"@type\":\"Question\",\"name\":\"How is BTech in CSE at IIT Kanpur?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"BTech CSE is the most sought after BTech specialisation at IIT Kanpur. The course is offered in full-time mode for a span of 4 years. BTech CSE students at IITK have bagged excellent placement packages over the years. In 2024, the vaerage package for BTech CSE stood at INR 52.8 LPA. Further, the course curriculum offers a strong foundation in Science and maths in the first 2 years, followed by highly advanced professional courses and electives in the last 2 years of the course. It is also the most competitve BTech branch with a closing cutoff rank of 271 in 2025.\"}},{\"@type\":\"Question\",\"name\":\"What is the rank of IIT Kanpur MBA?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Kanpur MBA course has been ranked by various ranking Agencies. Check below the 2025 rankings of IIT Kanpur: Ranking Body Rank (2025) NIRF 27\"}},{\"@type\":\"Question\",\"name\":\"How is the placement scenario at IIT Kanpur?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The institute has not released the placement report incorporating the overall data for the 2026 drive. However, the institute have disclosed the 2026 placement statistics till Phase I. As per the reports, over 250 recruiters participated and presented 1202 offers to the students. 1079 students were placed, of which 15 students have got international placements.\"}},{\"@type\":\"Question\",\"name\":\"Which are the top companies visiting IIT Kanpur for M.Tech placements?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"As per the verified students' reviews on Shiksha, top companies, such as Barclays, Flipkart, Qualcomm, Bajaj, HSBC, Tata Motors and Intel come for final placements at IIT Kanpur for MTech. Students get roles from technical research profiles to analytical roles. Additionaly, the institute in 2022 recorded a the highest domestic package of INR 1.9 crore per annum (not just for M.Tech but overall across courses).\"}},{\"@type\":\"Question\",\"name\":\"Is IIT Kanpur good for placement?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"As of now, the institute has released the phase-I placement statistics. A total of 1079 students were placed and 1202 job offers were distributed among them. Check the complete insights of IIT Kanpur placements 2026 from the table below: Particulars Placement Statistics (2026) Phase I Total job offers 1202 Students placed 1079 International offers 15 Top Recruiters Accenture, American Express, BlackRock, Boeing, Databricks\"}},{\"@type\":\"Question\",\"name\":\"What is the highest salary offered for IIT Kanpur BTech programme?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IIT Kanpur has not released course-wise placements information so far for 2022-23 Phase-I placements (which got over in December). According to media reports, phase 1 of the placement session 2022-23 concluded with 1,200 job offers received from over 250 companies. IIT Kanpur the highest package (domestic) stood at INR 1.9 crore per annum. The recruitment drive witnessed 74 international offers and 208 PPOs and a total of 1,198 students accepted the job offers. Further, 33 students received packages of above INR 1 crore per annum during IIT Kanpur placements 2023. For more details on IIT Kanpur placements, click here.\"}}]},\"reviewData\":{\"aggregateReviewWidget\":{\"averageRating\":{\"mean\":4.597022342326919},\"facultyRating\":{\"mean\":4.454810495626822},\"campusFacilitiesRating\":{\"mean\":4.667638483965015},\"avgSalaryPlacementRating\":{\"mean\":4.48396501457726},\"crowdCampusRating\":{\"mean\":4.743440233236152},\"moneyRating\":{\"mean\":4.696793002915452},\"learningExperienceRating\":{\"mean\":0.0},\"courseSupportRating\":{\"mean\":0.0},\"internshipRating\":null,\"partTimeWorkRating\":null,\"postStudyJobsRating\":null,\"qualityOfFacultyRating\":null,\"studentLifeRating\":null,\"valueForMoneyRating\":null,\"publicTransportationRating\":null,\"permanentImmigrationRating\":null,\"safetyRating\":null,\"foodOptionsRating\":null,\"discriminationFacedDTO\":{\"discriminationFacedRarely\":0,\"discriminationFacedNever\":0,\"discriminationFacedSometimes\":0,\"discriminationFacedVeryCommon\":0},\"universityAdjectives\":{\"adjectiveOne\":null,\"adjectiveTwo\":null,\"adjectiveThree\":null,\"adjectiveFour\":null},\"verifiedCount\":403,\"unverifiedCount\":52,\"intervalRatingCount\":{\"4\":338,\"3\":60,\"2\":4,\"1\":1},\"intervalRatingCountForPlacement\":{\"4\":199,\"3\":116,\"2\":24,\"1\":4},\"intervalRatingCountForFaculty\":{\"4\":187,\"3\":128,\"2\":25,\"1\":3},\"intervalRatingCountForInfrastructure\":{\"4\":241,\"3\":90,\"2\":12}},\"reviewTuplesDTO\":{\"reviewData\":[{\"reviewId\":5313923,\"averageRating\":4.8,\"facultyRating\":5,\"campusFacilitiesRating\":4,\"avgSalaryPlacementRating\":5,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"Nearly 85 percent of those enrolled in chemical engineering got placed. Highest package is 50 LPA. The average package is 19 LPA to 20 LPA. 60 percent of students got internships at top companies, including Microsoft, ITC, BPCL, ICICI, and Meesho. Top roles offered are software engineering, product manager, and plant engineer.\\n\",\"infraDescription\":\"Every kind of lab is present with properly working equipment. There is Wi-Fi everywhere on the campus, which every student can access. The library is good. All relevant books are present. Classrooms are good but some people find the seats uncomfortable. All sports facilities are present with proper grounds, and a coach and health centre are present where all medical facilities are available. Hostel rooms are average. The mess food is also good.\",\"facultyDescription\":\"Qualified faculty members are there for every course and they are well-versed in their field. The curriculum is relevant. Student may find academics a bit hectic here. Semester exams are according to what is taught in class it is not difficult to pass, but for good marks you need to study hard. The passing percentage is above 95 percent.\\n\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"Good placement, satisfactory faculty, excellent facilities, and average infrastructure.\",\"reviewDescription\":\"The campus is very big, so there are a lot of things to explore. The placement percentage is good in the course and a lot of companies come to hire chemical branch is a bit hectic here, we get to study a lot of courses during second and third year. Regular events happen on campus, major ones being Antaragni, Techriti, and Udghosh. City life is not so good here. Different scholarships are provided by the institute based on merit and family income.\\n\",\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2029,\"crowdCampusRating\":5,\"moneyRating\":5,\"creationDate\":\"2026-09-04\",\"firstname\":\"Avneesh kumar yadav\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109917,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":5303271,\"averageRating\":4.0,\"facultyRating\":4,\"campusFacilitiesRating\":3,\"avgSalaryPlacementRating\":3,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\" For Civil Engineering branch at IIT Kanpur, 65 to 85 percent of students get placements. The average package is 16-20 LPA. The highest packages reach much higher, like around 40 LPA. BPCL and Larsen & Toubro are top recruiters, along with various consulting or software firms. For internships, 50 to 70 percent of students usually get opportunities in core engineering or other sectors. Internships depend on how you perform there. Some students even get internships in the 1st year.\\n\",\"infraDescription\":\"Facilities for academics are top-notch, except for the Wi-Fi. The hostel for 1st-year students is quite a mess. You have to share with 2-3 people in less space. The mess food is not that tasty, but it is of a wide variety. You will definitely feel reluctant about it after 1 or 2 months.\\n\",\"facultyDescription\":\"Professors are really very helpful. You can ask doubts during their lectures. They are also available outside the lecture hall once the class is over. They also have dedicated office hours for students. Tutors are assigned to a section of students to clarify doubts regarding the assignment problems given to students for homework. The pass percentage is average, and some courses have very bad pass percentages. It is around 35% for some courses. Professors are really good, except for some boring instructors.\\n\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"IIT Kanpur Campus. You will definitely learn a lot from your 4 years here. Explore the campus.\",\"reviewDescription\":\"The best thing is that you always have a second option other than JEE Advanced to take up your favorite branch, but it requires discipline. It is not that hard, but it requires dedication.\\n\",\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2030,\"crowdCampusRating\":5,\"moneyRating\":5,\"creationDate\":\"2026-08-27\",\"firstname\":\"Sandeep Gurjar\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":73837,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":5066648,\"averageRating\":3.4,\"facultyRating\":5,\"campusFacilitiesRating\":3,\"avgSalaryPlacementRating\":3,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"If you are expecting placements like B.Tech then this is not good. Mostly students are placed in some pharma companies or in different laboratories. Mostly students are doing higher studies in a foreign or in a top Indian institute. Students got internships from different universities as assistant professors.\",\"infraDescription\":\"Facilities are good. Wi-Fi all over the campus with cctv security. Hostels are 2-seated or 3-seated and also AC rooms are available. Classrooms are spacious and digitally updated. Labs are spacious and have all the apparatus used in industry. The library is good. All types of books and magazines are available. There are different indoor and outdoor grounds for different sports.\",\"facultyDescription\":\"Student ratio with faculty is 76:56, i.e., 3:2 and all the faculty members are super qualified and their teaching methods are a bit old school meaning they focus more on books and research articles. An amazing part is IIT Kanpur I believe, is one of the IITs that conducted their exams timely and nicely with projects, theoretical, and laboratory chemistry.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"First crack at IIT JAM in a good rank.\",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2023,\"crowdCampusRating\":3,\"moneyRating\":3,\"creationDate\":\"2026-01-27\",\"firstname\":null,\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109950,\"streamId\":11,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":true},{\"reviewId\":5206161,\"averageRating\":4.6,\"facultyRating\":5,\"campusFacilitiesRating\":4,\"avgSalaryPlacementRating\":5,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"Placements for Economics are honestly top-tier almost on par with the core engineering branches if you maintain a decent CPI. Around 85 to 90 percent of the students get placed easily while the rest usually go for higher studies or off-campus research. The average package is around 18 LPA-20 LPA with the highest offers going up to more than 45 LPA for quant and high-frequency trading roles. Massive companies like Goldman Sachs, JP Morgan, Barclays, McKinsey, and WorldQuant come to the campus for both summer internships and final placements. Most people end up getting internships by their 3rd year in roles like data analytics.\",\"infraDescription\":\"The campus infrastructure is amazing. We have high-speed Wi-Fi everywhere from hostels to the lecture hall complex (LHC). The computer labs are loaded with the software we need for economic modelling. P K Kelkar library is great and a quiet place to study during midterms. Hostel life is a huge part of IITK. The rooms are decent, and the mess food is actually manageable compared to what you hear about other colleges. You have late-night canteens open till 2:00 or 3:00 AM in almost every Hall. Sports facilities are massive, we have a proper running track and an olympic-size pool.\",\"facultyDescription\":\"Professors are incredibly smart and know their stuff inside out though some can be a bit strict with grading. The teaching quality is quite rigorous. The Economics curriculum here isn't just theory it is very mathematical and focuses heavily on econometrics and data analysis which makes it highly relevant if you want to go into data science or financial analytics.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"Home away from home, though getting high CPI here is a bit tough.\",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2028,\"crowdCampusRating\":5,\"moneyRating\":4,\"creationDate\":\"2026-06-02\",\"firstname\":\"Meet Solanki\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":172233,\"streamId\":9,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":5142381,\"averageRating\":4.6,\"facultyRating\":4,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":4,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"Many students with good grades get placed. Around 70 percent of the total participating students get placed on campus, and a large number of students are placed in top companies. The average package offered ranges from 17-18 LPA. Top roles are offered in the software development sector and multiple core branch positions.\",\"infraDescription\":\"The infrastructure in hostels is pretty good. Academic facilities are well-built. We have individual infrastructure for all sports played across Inter IIT. Wi-Fi speed is pretty decent across the campus. The canteen facilities and the food facilities are well-managed and organised. There are multiple fast food outlets that serve great food. They also serve food late at night.\",\"facultyDescription\":\"Faculty members here are good. They are well-trained, and they know a lot in their field of interest. The course curriculum is definitely pretty hard here. Semester exams are pretty hard, and the grading part is pretty harsh. Although student councils try well to get the professors to do better grading, if students are struggling too much.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"IIT Kanpur - A tough balance of stressful academics, stress-relieving events, and campus crowd.\",\"reviewDescription\":\"Apart from academics, everything here feels like bliss. After coming here, students will surely know why it is one of the top institutes of India. Plenty of extracurricular activities are happening all the time on campus. Events and fests organised are great here. Plenty of scholarships are available at this college for students who are in need.\",\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2029,\"crowdCampusRating\":5,\"moneyRating\":5,\"creationDate\":\"2026-04-02\",\"firstname\":\"Shriom\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":73837,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":5060696,\"averageRating\":4.0,\"facultyRating\":5,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":2,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"I am here giving a idea about the placement of M.Sc. Chemistry student. Its pathetic, only 2 companies came by and 0 placement of any student. Apart from this if you want to do a Ph.D. from abroad then this was the best place for you. Students were doing Ph.D. in different foreign universities or in IITS.\",\"infraDescription\":\"Hostels were good and there were many facilities such as Wi-Fi 80+Mbps, LAN in each room 500+Mbps, Gym, TV room, Computer room and washing machines on each floor. Football, cricket, hockey grounds, Tennis, basketball courts, Olympic sized swimming pool and much more. Mess food was good. Wi-Fi all over the campus with CCTV security. Classrooms are digitally updated. The library is good all types of books and magazines are available.\",\"facultyDescription\":\"Student ratio with faculty is 76:56, i.e, 3:2. All the faculty members are super qualified and their teaching methods are a bit old school means they focus more on books and research articles. An amazing part is IIT Kanpur, I believe is one of the IITs that conducted their exams timely and nicely with projects, theoretical and laboratory chemistry.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"For placements this is not good.\",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2023,\"crowdCampusRating\":4,\"moneyRating\":4,\"creationDate\":\"2026-01-23\",\"firstname\":null,\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109950,\"streamId\":11,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":true},{\"reviewId\":5063242,\"averageRating\":4.4,\"facultyRating\":4,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":4,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"My branch is the second-best branch among the circuital branches after Computer Science in terms of placements. More than 50% of students from my branch get placed. The highest package offered is around 50 LPA, while the average and median packages generally remain around 20 LPA. Around 40% of students from my branch get internships. The top role offered is Software Developer (SD). The highest packages are offered by Quant companies.\\n\",\"infraDescription\":\"Almost all facilities are available on the campus. We have canteens in every hall, along with Subway, Starbucks, Domino's, and other food outlets on campus. The Wi-Fi speed is good, and connectivity is available throughout the campus. The food quality in the mess is above average. Some days of the week, it is really good, while on other days, it is just bearable. However, it depends on the hall you are staying in and the HEC. We have sports grounds on the campus, including football grounds, cricket grounds, and other facilities in each hall.\\n\",\"facultyDescription\":\"Professors are very well qualified for the courses they teach, and they are knowledgeable. Most of them have completed their Ph.D. from foreign universities. The course curriculum is based on pure mathematics and its applications in scientific computing. However, it remains more focused on the pure mathematics side. It could be made more relevant to the job market. Semester exams are generally moderate to difficult. Professors' grading is strict. The pass percentage depends on the professor.\\n\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"Best internships and placements, good faculty. Good infrastructure and facilities.\",\"reviewDescription\":\"Since childhood, I have been interested in pure mathematics, which is the reason I chose this course. The best thing about my course is its curriculum. If you really want to study pure mathematics, then it is perfect for you. It includes subjects like Linear Algebra, Real Analysis, Abstract Algebra, Set Theory, Pure Logic, Topology, Complex Analysis, Differential Equations, and more. IIT Kanpur's campus culture is one of the best. Three major cultural fests are organized here: Antaragni, Udghosh, and Techkriti. Many events are conducted related to sports, the job market, business, startups, and other fields. Many scholarships are also offered, and BS students can apply for the INSPIRE Scholarship.\\n\",\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2027,\"crowdCampusRating\":4,\"moneyRating\":5,\"creationDate\":\"2026-01-25\",\"firstname\":\"Abhishek Visavadiya\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":292377,\"streamId\":11,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4967546,\"averageRating\":5.0,\"facultyRating\":5,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":5,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"Placements commence for us in the 3rd semester, and there is a 100% placement rate. Companies like Wells Fargo, McKinsey, Axtria, etc., visit and give about 50+ offers. The highest package is around 24 lac/annum, and the average is about 16 lac/annum. For internships, companies like ICICI Bank and Emphasis visit. The roles offered are diverse, from Data Analyst to Product Management, and the total stipend ranges from 1-200,000 for most internships. It gives the students very good industry exposure.\",\"infraDescription\":\"The hostel rooms are pretty basic but not bad at all. The meal quality is very good. The hostel fee is about 10-15000 for a semester. The library offers a wide range of books from academic to non-academic. We can also make their virtual copy available via the library app and website. The classrooms have AC, a blackboard, & a projector. The IITK offers a wide range of sports, from football, cricket, skating, and boxing etc. Anyone who is interested in any of these activities can come and play.\",\"facultyDescription\":\"The course curriculum is very rigorous and depends on the student's requirements. The course consists of 4 semesters. The faculty have a great subjective knowledge that they pass on to the students. They are all very experienced in teaching management. There is 1 faculty member for every 25 students. The exams are very hard, but subject-based.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"First, clear the CAT, then think about this college.\",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2025,\"crowdCampusRating\":5,\"moneyRating\":5,\"creationDate\":\"2025-11-17\",\"firstname\":null,\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109940,\"streamId\":1,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":true},{\"reviewId\":4916074,\"averageRating\":4.6,\"facultyRating\":4,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":4,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"Every single student who went for placement ended up getting a spot in coaching institutes like Physics Wallah and Prutor, with packages typically ranging from about 6 to 7 LPA. When it comes to math, it seems like a lot of folks are looking to pursue their Ph.D., whether in India or overseas, if we are talking placements, Statistics is actually doing better than Mathematics in our department.\\n\",\"infraDescription\":\"Talking about the colleges infrastructure, it includes all the basics, clean water supply, spacious Science labs, an auditorium for cultural events, and a playground for sports, there is also a well-stocked library and tidy classrooms. Students can take advantage of transportation and on-campus housing if they do not have their own rides, the mess is kept clean, and while the food is pretty good, I think adding more choices that students like would be a bonus.\\n\",\"facultyDescription\":\"The faculty and staff do a solid job here. First-year classes felt a lot like high school, which made the transition smoother, the college does a nice job recognizing academic achievements and really goes out of its way to celebrate the top performers.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"IIT Kanpur College review.\",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2021,\"crowdCampusRating\":5,\"moneyRating\":5,\"creationDate\":\"2025-09-14\",\"firstname\":\"Santanu Majhi\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109956,\"streamId\":11,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4916020,\"averageRating\":4.8,\"facultyRating\":5,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":5,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"Honestly, when it comes to placements for this course, it’s pretty much non-existent. Hardly any companies show up for recruitment. Now, if you look at other courses, though, the situation is much brighter. They actually have solid placement opportunities. And here’s a little silver lining: students from this course can still throw their hats in the ring for placements in those other programs. On average, the packages can reach anywhere from 10 to 15 LPA.\",\"infraDescription\":\"The college has pretty solid infrastructure and decent amenities, You know, the on-campus housing is actually quite comfy and well-managed. A lot of students choose to live there. As for the food service, it’s okay, meets the basic standards, nothing fancy.\",\"facultyDescription\":\"The faculty here is just fantastic. Every single member really knows their stuff when it comes to their field. They’re super accessible and are always ready to lend a hand to students, the way they teach works well, giving students a solid grasp of the material, the curriculum is modern, and the test questions strike a nice balance, not too easy, not too hard.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"IIIT Kanpur College review.\",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2021,\"crowdCampusRating\":4,\"moneyRating\":5,\"creationDate\":\"2025-09-14\",\"firstname\":\"Aranya Roy Choudhury\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109950,\"streamId\":11,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4892276,\"averageRating\":4.8,\"facultyRating\":4,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":5,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"In our senior batch, 55 out of 70 students have secured placements so far, with an average package of 15 LPA as a base. The big names hiring include Microsoft, Intel, Flipkart, and Saplabs, among others. As for the roles, we are talking about SDE, data scientists, and cybersecurity engineers. The highest package is 60 LPA.\",\"infraDescription\":\"The campus comprises all the required academic and research buildings, a central library, well-equipped labs, and classrooms that have Wi-Fi accessibility. In addition to this, students may use the residential facilities and dining halls. The hostel accommodation is generally considered satisfactory. The food in the mess is middling, and the health center is staffed with medical professionals who are there to help if someone falls sick.\",\"facultyDescription\":\"The teaching staff comprises faculty members who possess good qualifications and have sufficient knowledge. They are very creative in their activities, and this attracts listeners. They are using the method of storytelling and participating in discussions to explain the concepts. The curriculum is on point and perfectly suitable. Otherwise, students who are well-covered in the concepts are mostly good at finding ways to clear the exams.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"IIT Kanpur College review.\",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2026,\"crowdCampusRating\":5,\"moneyRating\":5,\"creationDate\":\"2025-09-02\",\"firstname\":\"Sajaldeep Singh\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":1103051,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4821262,\"averageRating\":4.8,\"facultyRating\":5,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":5,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"In this college, there are many companies interested in this course and providing the best package, like 7 LPA to 30 LPA. The highest salary is present. This company provides a 2 to 3 years agreement for employees who do not resign from the company. This course is held every year, and the maximum number of students is placed in the company.\",\"infraDescription\":\"In this college, infrastructure is also good because it is a top college for this course. In this college, facilities are provided like classrooms, labs, a hostel, a bathroom, a library, a canteen, an auditorium, a lift, CCTV, etc. Facilities are available. Sports and games facilities are also available.\",\"facultyDescription\":\"In this course, faculty is very good and manages the organisation to follow the rules and regulations of the college. In this college, professors and teachers with high level qualifications are present, and the best quality of teaching knowledge is available. This exam was very difficult, but this college provides some important questions to be asked in the exam.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"IIT Kanpur for Ph.D. CE and other stream course admission information.\",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2028,\"crowdCampusRating\":4,\"moneyRating\":5,\"creationDate\":\"2025-07-31\",\"firstname\":\"Ankit Mishra\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":732031,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4811638,\"averageRating\":5.0,\"facultyRating\":5,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":5,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"This college provides placement facilities. Every year, the placement cell is organized for many departments of students. The college offers courses for both IT and non-IT jobs. Companies provide packages ranging from 4 LPA to 20 LPA for average students.\",\"infraDescription\":\"This college provides good facilities such as fast Wi-Fi, Ethernet connections, labs, computers, CCTV, lifts, a campus canteen, and water purifier machines. Sports committees organize many sports and game tournaments, and gym facilities are also available.\",\"facultyDescription\":\"The course curriculum is relevant and good. But the college enforces many rules and regulations that students must follow compulsorily. In this college, attendance of 75% or above is compulsory to attend the practical and theoretical exams. The exams are not difficult because internal marks are included.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"IIT Kanpur is about admission, campus, faculty, students, and exams.\",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2026,\"crowdCampusRating\":5,\"moneyRating\":5,\"creationDate\":\"2025-07-28\",\"firstname\":\"Shreyash Dwivedi\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":1,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109932,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4732790,\"averageRating\":5.0,\"facultyRating\":5,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":5,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"I am from Chemical Engineering, and in my branch, around 80% of students get placed. The highest package offered is 50 LPA, the median is 21 LPA, and the lowest is 8 LPA. The top recruiting company from my branch is Microsoft, offering 50 LPA. The top roles offered are SDE, consulting, and data analytics roles.\",\"infraDescription\":\"Wi-Fi facility is great, and labs are a bit hectic, but the infrastructure is top-class. The library has an occupancy of around 500 students and is a three-storey building. The infrastructure of hostels is quite old, so in the beginning, it might be difficult to live as there is no AC. The food quality in the mess is better than that of any other engineering college. The health centre at IIT Kanpur provides medicine and treatment completely free of cost. The campus provides facilities for all sorts of games.\",\"facultyDescription\":\"Professors here are among the most educated in the world, having completed their Ph.D. from the best universities globally. There is no limit to the knowledge at IIT Kanpur. The semester exams are much more difficult than those of other IITs, and the grading here is also tough.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"The best four years that I will spend.\",\"reviewDescription\":\"I chose this branch because it is the only one I am getting according to my rank. The fest is the best thing here, as we enjoy amazing concerts by renowned artists like Sonu Nigam, Badshah, Ritviz, etc.\",\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2028,\"crowdCampusRating\":5,\"moneyRating\":5,\"creationDate\":\"2025-06-26\",\"firstname\":\"Rishi\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":1,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109917,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4634532,\"averageRating\":3.2,\"facultyRating\":3,\"campusFacilitiesRating\":3,\"avgSalaryPlacementRating\":3,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"The highest package is 9 LPA, and the average package is 7 LPA. The lowest package is 4 LPA. About 60% of the students got placed in our batch. Many reputed companies reached our college campus for recruitment, and several students got internships.\",\"infraDescription\":\"Classrooms and labs are average and not cleaned on a daily basis. The quality of food available in the mess and canteen is not acceptable. Wi-Fi facilities are only for faculty members. The hostel rooms are not so comfortable and very small. Sports and medical facilities are available.\",\"facultyDescription\":\"Teachers are very qualified and knowledgeable but they are not much helpful. They became angry if students asked about their doubts. The teaching quality is good but the behaviour of faculty members is not acceptable. Only few curriculum activities are conducted.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"Dissatisfied because of faculty members. \",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2026,\"crowdCampusRating\":4,\"moneyRating\":3,\"creationDate\":\"2025-05-23\",\"firstname\":\"Shreyansh Dwivedi\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":1,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109932,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4619440,\"averageRating\":3.8,\"facultyRating\":3,\"campusFacilitiesRating\":4,\"avgSalaryPlacementRating\":5,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"Highest percentage of students who can get placed in my course in the year is high. The highest package offered to students is more than 3 LPA. Top recruiting companies are in my course. The percentage of students who got internships in this course is more than 60%.\",\"infraDescription\":\"Facilities and infrastructure available in my course are very good. Wi-Fi, classrooms, library ,all these things are available in my course. The quality and facilities present in my hostel, including food, are very good. Medical help is also present in this course. Sports and games are available in the college.\",\"facultyDescription\":\"Teachers in my course are very helpful, qualified, and knowledgeable. They have great teaching qualities. This course is curriculum relevant, and students are industry-ready. Semester exams in my course are very difficult, yet the pass percentage is more than 60%.\\n\\n\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"Review of Vishnu Shiksha.\",\"reviewDescription\":\"I am choosing this course for getting very knowledge is no which came to in my perceivements and campus so good but its scholarship is not present.\",\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2022,\"crowdCampusRating\":3,\"moneyRating\":4,\"creationDate\":\"2025-05-18\",\"firstname\":\"Sanjay sharma\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":732035,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4603336,\"averageRating\":3.8,\"facultyRating\":3,\"campusFacilitiesRating\":3,\"avgSalaryPlacementRating\":4,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"At my college, more than 80% of students got placed in top companies in India. The highest package offered to students in my course was more than 3 lakhs per month, and the lowest package was nearly Rs. 20,000 per month. The percentage of students who got internships in companies from my course was 95%.\",\"infraDescription\":\"Facilities and infrastructure available in my course were super. Wi-Fi, classrooms, and the library were all available. The quality of food in the college canteen was very good. Medical facilities were available. Sports and games were also provided for students at the college.\",\"facultyDescription\":\"Teachers in my course were very helpful, qualified, and knowledgeable. They had great teaching qualities. This course was curriculum-relevant, and students were industry-ready. The semester exams in my course were easy. The pass percentage was more than 70%.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"Shaswat's review of my college.\",\"reviewDescription\":\"There was nothing that needed improvement in my course, events, or campus, as everything was very good. However, scholarships were not available in my course.\",\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2024,\"crowdCampusRating\":4,\"moneyRating\":5,\"creationDate\":\"2025-05-12\",\"firstname\":\"Shaswat gupta\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":1,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109925,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4590764,\"averageRating\":4.0,\"facultyRating\":4,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":4,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"Approximately 70% of the students of Mechanical Engineering got placed in 2024–25. The average package is 20 Lacs per annum. The top recruiting companies are Tata, Mahindra, and L&T. Nearly 50% of the students got internships in automobile and sales companies.\",\"infraDescription\":\"The lecture halls are excellent, fully furnished, and equipped with AC. There are different labs for various purposes, equipped with computers for student use. A vast library is also available for the use of students and faculty, with a large number of books. The hostel has all the facilities for mess and sports. The quality of food being served in the mess is above average. Medical facilities are also provided on campus, with an ambulance available whenever needed\",\"facultyDescription\":\"Professors are very helpful and knowledgeable. They teach each topic briefly and encourage doubts. The course curriculum is relevant  prepares students to work at the industrial level. Semester exams are much harder compared to other colleges. The pass percentage is nearly 70%.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"Excellent college, good facilities, enjoyable fests, but hard academics.\",\"reviewDescription\":\"I chose this course because of my interest, and also I got this only from my JEE Advanced rank. This course enables you to solve real life problems in the industry. Several fests are organized on campus through out the year, like sports fest, cultural fest, and tech fest. Scholarships are provided for students. There are many clubs and societies for extracurricular activities, from media and culture to science and technology.\",\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2028,\"crowdCampusRating\":4,\"moneyRating\":3,\"creationDate\":\"2025-05-08\",\"firstname\":\"Vivek Singh\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":176829,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4551648,\"averageRating\":4.4,\"facultyRating\":4,\"campusFacilitiesRating\":4,\"avgSalaryPlacementRating\":4,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"Approximately 80% of students get placed. The highest package is around 2.25 crore per annum. The minimum package is 10 LPA in 2024. The top recruiting companies for our course are Optiver and Google. Internship percentage is about 15%. Students do internships in companies like Google and Nvidia. The top roles offered are PIO-PPO.\",\"infraDescription\":\"We have high-speed Wi-Fi in our hostels, classrooms, and labs. The infrastructure for EE is a bit old, as it is one of the oldest branches, but it's fine. Labs are working well. The quality of food in hostels is fine. Sports here are top tier. Medical facilities are also good.\",\"facultyDescription\":\"Professors are very well qualified and knowledgeable. The teaching quality is also good. The course curriculum is very relevant, and it makes students both office-wise and industry-wise ready. Semester exams are a bit tough, and mostly, the pass percentage is 25%.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"The culture here is nice, but academics are a bit hectic.\",\"reviewDescription\":\"I chose this course because I had an interest in EE. Placements were good in EE. It should improve labs and theoretical classes, and be able to make everyone understand it.\",\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2028,\"crowdCampusRating\":5,\"moneyRating\":5,\"creationDate\":\"2025-04-24\",\"firstname\":\"SWARNIM SAI PRADHAN\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109932,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false},{\"reviewId\":4543478,\"averageRating\":4.2,\"facultyRating\":4,\"campusFacilitiesRating\":5,\"avgSalaryPlacementRating\":3,\"learningExperienceRating\":null,\"courseSupportRating\":null,\"reviewContent\":{\"placementDescription\":\"The highest package is 16 LPA, the average package is 10 LPA, and the lowest package is 5.5 LPA. Many big and reputed companies visit our institute, and about 30% of students get internships. Around 70% of students are placed.\\n\\n\",\"infraDescription\":\"The campus is very clean and surrounded by plants and trees everywhere. Classrooms and labs are well-maintained and modified with all requirements. A well-stocked library is also available. Multiple sports and medical facilities, along with coaches, are present.\",\"facultyDescription\":\"Faculty members for our course are very experienced and skilled. They are very knowledgeable and helpful. They provide both online and offline resources for studies. Our course curriculum is relevant, and many activities are conducted by the institute.\",\"learningExpDescription\":null,\"courseSupportDescription\":null,\"reviewTitle\":\"Very satisfied with services and faculty members. \",\"reviewDescription\":null,\"lowRatingReason\":null,\"highRatingReason\":null,\"knowBeforeJoining\":null},\"yearOfGraduation\":2026,\"crowdCampusRating\":5,\"moneyRating\":4,\"creationDate\":\"2025-04-21\",\"firstname\":\"Shreyash Dwivedi\",\"lastname\":null,\"reviewStatus\":\"published\",\"helpfulCount\":0,\"publicMedia\":[],\"profilePicUrl\":null,\"showInstituteReply\":false,\"courseId\":109932,\"streamId\":2,\"abroadRatings\":null,\"discriminationFaced\":null,\"stayWhileStudying\":null,\"lowRatingMasterLabel\":null,\"highRatingMasterLabel\":null,\"foodSpending\":null,\"accommodationSpending\":null,\"transportationSpending\":null,\"monthlyExpenses\":null,\"currency\":\"INR\",\"hoursSpentPreparing\":null,\"averageAnnualSalary\":null,\"educationTypeId\":20,\"alumniFeedbackData\":null,\"anonymous\":false}],\"pageCount\":21,\"pageNo\":1,\"reviewCount\":419,\"filter\":{\"courseIds\":[172227,1195965,109932,109917,172233,230930,109940,73837,109900,292377,292381,1195981,176829,109925,109916,292370,292390,109950,732035,109956,1195979,109958,292453,526707,293489,293072,292894,292604,1195973,293034,732051,1196005,292852,292669,1103051,732031,1196035,1195989,1195999,292667,293036,732043,732063],\"instituteIds\":[53988,25116],\"topicIds\":[19,55,6,31,54,15,49,10,13,17,155,151,111,175,157,161,171,73,159,101,67,113,165,141,87,105,107,63,145,77,167,41,9,26,22,43,56,42,58,47,40,1