g\":null,\"allIndiaRankingUrl\":null,\"baseCourseId\":null,\"baseCourseName\":null,\"specilizationId\":null,\"specializationName\":null,\"saUnivListingId\":null,\"instituteShortName\":null,\"tupleTitle\":\"All About IIT Mandi - Indian Institute of Technology\",\"shikshaRank\":null,\"instituteShortNameElseName\":\"IIT Mandi - Indian Institute of Technology\",\"duration_unit\":null,\"duration_value\":null,\"review_url\":\"/college/iit-mandi-indian-institute-of-technology-33322/reviews\",\"mean_rating\":4.3}],\"latestArticles\":[{\"acronym\":\"\",\"blogId\":9734,\"blogImageURL\":\"https://images.shiksha.com/mediadata/images/articles/1792924150phpeQknZi.jpeg\",\"blogText1\":null,\"blogTitle\":\"MBA from IITs - Eligibility, Dates, Selection Process 2027, Seat Intake, Fees & Average Salary\",\"countryId\":2,\"creationDate\":\"2015-01-23 18:54:07\",\"discussionTopic\":3162107,\"homepageImgURL\":\"/mediadata/images/articles/1792924150phpeQknZi_b.jpeg\",\"lastModifiedDate\":\"2026-11-24 20:38:36\",\"noIndex\":0,\"tags\":null,\"url\":\"/mba/articles/mba-from-iits-blogId-9734\",\"userId\":5712995,\"summary\":\"The IITs offer MBA progammes through their Department of Management Studies. Some of IITs ranked among top 10 in India for MBA programme. The IIT MBA courses have lower fees and lower cut offs than IIMs. Know all about MBA from IITs including, fees, eligibility, CAT cut off and placements. Check the IIT MBA 2027 admission dates.\",\"tagType\":\"exam\",\"liveBlogStartDate\":null,\"liveBlogEndDate\":null},{\"acronym\":\"\",\"blogId\":221876,\"blogImageURL\":\"https://images.shiksha.com/mediadata/images/articles/1790158371phpSKsSiP.jpeg\",\"blogText1\":null,\"blogTitle\":\"GATE Qualifying Marks 2027: Expected Cutoff Predictions, Past Year's Passing Marks Trends\",\"countryId\":2,\"creationDate\":\"2026-02-12 00:46:59\",\"discussionTopic\":12596890,\"homepageImgURL\":\"/mediadata/images/articles/1790158371phpSKsSiP_b.jpeg\",\"lastModifiedDate\":\"2026-11-23 14:08:25\",\"noIndex\":0,\"tags\":null,\"url\":\"/engineering/articles/gate-qualifying-marks-blogId-221876\",\"userId\":2582250,\"summary\":\"IIT Madras will release GATE 2027 qualifying marks for all 30 subjects. Candidates preparing for GATE 2027 exam can check expected GATE cutoff marks, passing marks for CSE, GATE minimum qualifying mark for IITs, IISc, NITs, etc. Read here to know about admission cutoff, GATE 2027 marks vs rank etc.\",\"tagType\":\"exam\",\"liveBlogStartDate\":null,\"liveBlogEndDate\":null},{\"acronym\":\"\",\"blogId\":29439,\"blogImageURL\":\"https://images.shiksha.com/mediadata/images/articles/1771402450phpp90IGA.jpeg\",\"blogText1\":null,\"blogTitle\":\"GATE Marks vs Rank 2026: Branch-Wise Cutoff OUT, Safe Score, Previous Year's Trends\",\"countryId\":2,\"creationDate\":\"2020-01-23 19:13:57\",\"discussionTopic\":5867375,\"homepageImgURL\":\"/mediadata/images/articles/1771402450phpp90IGA_b.jpeg\",\"lastModifiedDate\":\"2026-11-18 17:10:55\",\"noIndex\":0,\"tags\":null,\"url\":\"/engineering/articles/gate-marks-vs-rank-blogId-29439\",\"userId\":2582250,\"summary\":\"LCandidates can check detailed GATE 2026 marks vs rank analysis below. For CSE, 85-100 marks is required to get AIR under 10. Check GATE 2026 branch-wise expected marks vs rank analysis, good GATE rank, CS cutoff vs marks, cutoff details and predict your AIR here.\",\"tagType\":\"exam\",\"liveBlogStartDate\":null,\"liveBlogEndDate\":null},{\"acronym\":\"\",\"blogId\":11334,\"blogImageURL\":\"https://images.shiksha.com/mediadata/images/articles/1718171516phpjtsmwG.jpeg\",\"blogText1\":null,\"blogTitle\":\"Top Design Entrance Exams: Check Official Notification, Exam Date & Latest Updates\",\"countryId\":2,\"creationDate\":\"2015-07-24 11:24:56\",\"discussionTopic\":3331725,\"homepageImgURL\":\"/mediadata/images/articles/1718171516phpjtsmwG_b.jpeg\",\"lastModifiedDate\":\"2026-11-17 16:46:58\",\"noIndex\":0,\"tags\":null,\"url\":\"/college/articles/top-design-entrance-exams-blogId-11334\",\"userId\":83239030,\"summary\":\"Find out which are the most popular entrance exams you should consider giving if you want to secure admission to a good fashion design college for the academic session 2027. Note that the admission process is currently underway for popular entrance exams like NID DAT 2027, UCEED 2027, SEED 2027, and SEED 2027.\",\"tagType\":\"multi\",\"liveBlogStartDate\":null,\"liveBlogEndDate\":null}],\"anaWidget\":{\"totalNumber\":1143,\"listingType\":\"university\",\"questionsDetail\":{\"13057424\":[{\"answerId\":13057434,\"answerText\":\"<p>As per IIT Bombay summer internship data for 2025-2027 MBA batch, the highest and average package recorded during its placement drive was <strong>INR 5 Lacs </strong>and <strong>INR 3.21 lakh</strong>. Maximum number of students were placed to Consulting and FMCG sectors. Additionally, the number of PPOs made this season at IIT bombay has increased.</p>\",\"activityTime\":\"an hour ago\",\"answerOwnerUserId\":78007874,\"questionId\":13057424,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":1,\"msgCount\":1,\"viewCount\":0,\"status\":\"LIVE\",\"userId\":78007874,\"firstname\":\"Al\",\"lastname\":\"Kashaf\",\"creationDate\":\"2026-11-25 12:20:52\",\"url\":\"https://ask.shiksha.com/how-are-iit-bombay-internships-qna-13057424\",\"title\":\"How are IIT Bombay internships? \",\"answerOwnerName\":\"Al Kashaf\",\"answerOwnerLevel\":\"Contributor-Level 10\",\"answerOwnerImage\":\"\",\"likeCount\":0,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":1,\"questionCreationDate\":\"an hour ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192340,\"tagName\":\"Indian Institute of Technology, IIT Bombay\",\"tagType\":\"Colleges\"},{\"tagId\":187216,\"tagName\":\"Colleges in Mumbai\",\"tagType\":\"Colleges In location\"}]}],\"12375684\":[{\"answerId\":13005689,\"answerText\":\"<p data-path-to-node=\\\"0\\\">While evaluating undergraduate placement statistics, non-core hiring patterns, and sector-wise recruitment data for civil engineering graduates provides a helpful baseline for your career planning, Lovely Professional University (LPU) serves as an excellent alternative to elevate your professional trajectory.</p><p data-path-to-node=\\\"1\\\">At LPU’s School of Civil Engineering, core civil concepts—such as structural analysis, geotechnical engineering, and smart infrastructure—are combined with cross-disciplinary skill sets like data analytics, project management, and building information modeling (BIM). Supported by transparent admission pathways, generous LPUNEST merit-based scholarships, ultra-modern testing labs, international credit transfer tie-ups with 500+ foreign partner universities, and robust multi-sector placement drives, LPU offers a world-class platform engineered to transform engineering aspirants into versatile global leaders.</p>\",\"activityTime\":\"a month ago\",\"answerOwnerUserId\":97712884,\"questionId\":12375684,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":2,\"msgCount\":2,\"viewCount\":19,\"status\":\"LIVE\",\"userId\":67796261,\"firstname\":\"guest\",\"lastname\":\"Singh\",\"creationDate\":\"2025-09-12 02:01:17\",\"url\":\"https://ask.shiksha.com/what-are-the-placement-scenarios-for-civil-in-ug-and-in-what-other-sectors-apart-from-core-companies-are-hiring-qna-12375684\",\"title\":\"What are the placement scenarios for civil in UG and in what other sectors apart from core, companies are hiring? Explain by referring data.\",\"answerOwnerName\":\"Aston Martin\",\"answerOwnerLevel\":\"Contributor-Level 7\",\"answerOwnerImage\":\"\",\"likeCount\":8,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":2,\"questionCreationDate\":\"a year ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192340,\"tagName\":\"Indian Institute of Technology, IIT Bombay\",\"tagType\":\"Colleges\"},{\"tagId\":187216,\"tagName\":\"Colleges in Mumbai\",\"tagType\":\"Colleges In location\"}]}],\"13037343\":[{\"answerId\":13037347,\"answerText\":\"<p>During IIT Bombay placement drive <strong>hundereds of domestic </strong>and <strong>international companies </strong>across engineering, software, finance, and consulting hire students from the insititute. These recruiters include <strong>Google</strong>, <strong>Microsoft</strong>, <strong>Apple</strong>, <strong>Amazon</strong>, <strong>Intel</strong>, <strong>Flipkart</strong>, <strong>Accenture</strong>, <strong>Deloitte</strong>, <strong>Oracle</strong>, etc.</p>\",\"activityTime\":\"3 weeks ago\",\"answerOwnerUserId\":78007874,\"questionId\":13037343,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":1,\"msgCount\":1,\"viewCount\":1,\"status\":\"LIVE\",\"userId\":78007874,\"firstname\":\"Al\",\"lastname\":\"Kashaf\",\"creationDate\":\"2026-11-02 12:52:40\",\"url\":\"https://ask.shiksha.com/which-companies-hire-from-iit-bombay-qna-13037343\",\"title\":\"Which companies hire from IIT Bombay? \",\"answerOwnerName\":\"Al Kashaf\",\"answerOwnerLevel\":\"Contributor-Level 10\",\"answerOwnerImage\":\"\",\"likeCount\":0,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":1,\"questionCreationDate\":\"3 weeks ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192340,\"tagName\":\"Indian Institute of Technology, IIT Bombay\",\"tagType\":\"Colleges\"},{\"tagId\":187216,\"tagName\":\"Colleges in Mumbai\",\"tagType\":\"Colleges In location\"}]}],\"13036637\":[{\"answerId\":13036639,\"answerText\":\"<p>IIT Bombay has over 1400 seats for its BTech course. Where specialisations like <strong>Mechanical Engineering (203)</strong>, <strong>Computer Science and Engineering</strong> <strong> (199)</strong> and <strong>Civil Engineering (146)</strong> has the highest seat intake. Whereas, integrated branches like <strong>BTech in Mechanical Engineering + M.Tech in Computer Integrated Manufacturing (25)</strong> and <strong>BTech + M.Tech in Metallurgical Engineering and Materials Science (20)</strong> has the lowest intake .</p>\",\"activityTime\":\"3 weeks ago\",\"answerOwnerUserId\":78007874,\"questionId\":13036637,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":1,\"msgCount\":1,\"viewCount\":4,\"status\":\"LIVE\",\"userId\":78007874,\"firstname\":\"Al\",\"lastname\":\"Kashaf\",\"creationDate\":\"2026-11-01 16:14:53\",\"url\":\"https://ask.shiksha.com/which-btech-specialisation-has-the-highest-and-the-lowest-seats-at-iit-bombay-qna-13036637\",\"title\":\"Which BTech specialisation has the highest and the lowest seats at IIT Bombay? \",\"answerOwnerName\":\"Al Kashaf\",\"answerOwnerLevel\":\"Contributor-Level 10\",\"answerOwnerImage\":\"\",\"likeCount\":0,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":1,\"questionCreationDate\":\"3 weeks ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192340,\"tagName\":\"Indian Institute of Technology, IIT Bombay\",\"tagType\":\"Colleges\"},{\"tagId\":995229,\"tagName\":\"btech\",\"tagType\":\"Careers\"}]}],\"4293452\":[{\"answerId\":13052082,\"answerText\":\"<p data-pm-slice=\\\"1 []\\\">B.Tech in Civil Engineering is a good option for students interested in construction, infrastructure development, designing and planning buildings, bridges, roads and other structures. The programme generally covers subjects such as structural engineering, geotechnical engineering, transportation engineering, environmental engineering, surveying and construction management. </p>\",\"activityTime\":\"6 days ago\",\"answerOwnerUserId\":58701007,\"questionId\":4293452,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":3,\"msgCount\":3,\"viewCount\":198,\"status\":\"LIVE\",\"userId\":7470045,\"firstname\":\"Shiksha All Time\",\"lastname\":\"Q&A\",\"creationDate\":\"2017-09-04 09:44:32\",\"url\":\"https://ask.shiksha.com/how-are-the-placements-of-b-tech-in-civil-engineering-from-iit-bombay-qna-4293452\",\"title\":\"How are the placements of B.Tech in Civil Engineering from IIT, Bombay?\",\"answerOwnerName\":\"ParmSidhu \",\"answerOwnerLevel\":\"Contributor-Level 10\",\"answerOwnerImage\":\"\",\"likeCount\":0,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":3,\"questionCreationDate\":\"9 years ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192340,\"tagName\":\"Indian Institute of Technology, IIT Bombay\",\"tagType\":\"Colleges\"},{\"tagId\":265054,\"tagName\":\"Indian Institute of Technology, IIT Bombay Placement\",\"tagType\":\"Colleges varients\"}]}]},\"allQuestionURL\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/questions\",\"questionOrder\":[4293452,13057424,12375684,13037343,13036637],\"pageSize\":5,\"maxPagetoDisplay\":2,\"anaFaqData\":null,\"prepFaqData\":null,\"anaWidgetPresent\":false},\"collegeWidget\":{\"collegeWidgetData\":{\"providesAffiliaion\":1,\"constituentCollegeText\":\"Most viewed colleges and departments of\",\"affiliatedCollegesText\":\"To see the list of 1 affiliated colleges offering 7 courses\",\"tabText\":\"Colleges\",\"topInstituteData\":{\"24020\":{\"name\":\"Industrial Design Centre - IIT Bombay\",\"shortName\":\"IDC School of Design\",\"listingType\":\"institute\",\"mediaUrl\":\"https://images.shiksha.com/mediadata/images/1653283039phpuupGd3_68x54.jpg\",\"mediaThumbUrl\":null,\"instituteUrl\":\"/college/industrial-design-centre-iit-bombay-powai-mumbai-24020\",\"reviewUrl\":\"/college/industrial-design-centre-iit-bombay-powai-mumbai-24020/reviews\",\"disp