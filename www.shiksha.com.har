h-board\",\"scope\":\"national\"},{\"id\":14077,\"name\":\"ISC\",\"url\":\"/boards/isc-board\",\"scope\":\"national\"},{\"id\":14183,\"name\":\"Maharashtra HSC\",\"url\":\"/boards/maharashtra-hsc-board\",\"scope\":\"national\"}],\"examIdScores\":[{\"id\":14059,\"minScore\":null,\"maxScore\":null},{\"id\":14077,\"minScore\":null,\"maxScore\":null},{\"id\":14183,\"minScore\":null,\"maxScore\":null}],\"totalExamsCount\":0,\"courseRating\":5.0,\"ratingCount\":2,\"totalSeats\":0,\"courseMedianSalary\":null,\"courseCount\":3,\"minFees\":null,\"maxFees\":null,\"minMedianSalary\":0,\"maxMedianSalary\":0,\"minEligibilityXII\":0.0,\"maxEligibilityXII\":0.0,\"minEligibilityGraduation\":0.0,\"maxEligibilityGraduation\":0.0,\"minEligibilityPostGraduation\":0.0,\"maxEligibilityPostGraduation\":0.0,\"minEligibilityX\":0.0,\"maxEligibilityX\":0.0,\"rankingString\":null,\"rankingUrl\":null,\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/certificate-bc\",\"topCourseUrl\":null,\"reviewUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/reviews?bc=193\",\"courseId\":1195475,\"shortNameAbbOrFullName\":\"IIT Bombay\",\"showInFeesAndEligibilityTable\":true,\"applicationLinkData\":null,\"feeDetailUrl\":\"https://images.shiksha.com/mediadata/instituteCtaPdf/feeDetails_54212_193_1756407604.pdf?v=1756420251\",\"scholarshipPdfUrl\":null,\"isRMCEnabled\":0,\"scholarshipsCount\":0,\"intakeDates\":[],\"instituteGrade\":null,\"workExpString\":null,\"averageMoneyRating\":0.0,\"averagePlacementRating\":0.0,\"ratingString\":null,\"ownership\":\"public\",\"currencyConversionFactorMap\":null,\"recentAdmitsData\":null,\"appliedEducationType\":null,\"courseLevel\":\"Certificate\",\"courseBasicDetails\":null,\"shikshaRank\":null,\"clientId\":null,\"cashbackAmount\":null,\"cashbackStartDate\":null,\"cashbackEndDate\":null,\"cashbackMessage\":null,\"cashbackBannerHeading\":null,\"instituteId\":54212,\"examSeasonalCtaInfo\":null,\"cashbackDataExist\":false}],\"sectionToAnaTaggedFaqDataMap\":{\"ovp_section_highlights\":[{\"anaFaqId\":148450215,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_highlights\",\"questionId\":7336869,\"answerId\":7342711,\"questionText\":\"How is the MA in Research at IIT Bombay?\",\"answerText\":\"The HSS department at IITBombay is introducing the Master of Arts by Research (MA. Res) with precisely this emphasis. The faculty members in the department represent diverse areas of expertise and have considerable experience teaching with an emphasis on research skills while accommodating disciplinary crossovers with ease. This is especially important since many of the concerns of the Humanities and Social Sciences requireamulti-disciplinary approach. Our students have been successful both in working at the interfaces of different areas and in transcending traditional disciplinary boundaries in their work. The programme combines course work to build student competence in specific areas, research training, and researchmodules for independent work. Students are expected to carry out a successful programme of research within the duration of the programme. The internal structure of the programme is designed to be quite different from course intensive postgraduate programmes and allows for relative flexibility interms of student backgrounds and prior training\",\"order\":0,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-is-the-ma-in-research-at-iit-bombay-qna-7336869\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":45,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-04-05T23:45:52\",\"context\":\"Overview\",\"isStale\":false},{\"anaFaqId\":150013255,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_highlights\",\"questionId\":7425311,\"answerId\":7751027,\"questionText\":\"What is the placement package at central IIT Bombay?\",\"answerText\":\"<p>During the IIT Bombay 2026 placements, 42 companies&nbsp;visited and made&nbsp;98 offers&nbsp;on the&nbsp;first day. The highest international package&nbsp;offered was around&nbsp;INR 1.5 Crore per Annum.&nbsp;</p><p>Further, accroding to the SJMSOM final placement report 2026 for MBA program,&nbsp;100% placement&nbsp;was recorded in 2026. The&nbsp;highest&nbsp;and&nbsp;average package&nbsp;recorded during IIT Bombay MBA placements 2026 was&nbsp;INR 53.8 LPA&nbsp;and&nbsp;28.16 LPA.</p>\",\"order\":1,\"answerCount\":2,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-placement-package-at-central-iit-bombay-qna-7425311\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":53,\"atfCtrIndex\":0.003333,\"showViewOther\":false,\"quesTemplateId\":239922,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":2,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-06-11T10:23:28\",\"context\":\"Placements\",\"isStale\":false},{\"anaFaqId\":161206593,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_highlights\",\"questionId\":7549209,\"answerId\":7549211,\"questionText\":\"What is the JEE Advanced cut off for B.Tech. in Computer Science and Engineering in IIT Bombay - Indian Institute of Technology?\",\"answerText\":\"<p><span data-sheets-value=\\\" {\\\" data-sheets-userformat=\\\" {\\\">For 2026, cut off was 67 for General category candidates in All India quota for B.Tech. in Computer Science and Engineering in IIT Bombay - Indian Institute of Technology. Which was the most competitive specialisations amongs others.</span></p>\",\"order\":2,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-jee-advanced-cut-off-for-b-tech-in-computer-science-and-engineering-in-iit-bombay-indian-institute-qna-7549209\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":9,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":3,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-10-19T12:53:41\",\"context\":\"Comparison\",\"isStale\":false},{\"anaFaqId\":165819017,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_highlights\",\"questionId\":7779089,\"answerId\":7779091,\"questionText\":\"What facilities are available at campus of IIT Bombay? \",\"answerText\":\"<p>The extensive campus of IIT Bombay houses many advanced facilities for its students such as banks, a shopping centre, two excellent schools for children, a well-equipped hospital, hostels, modern libraries and more. Inside the hostel premises, there is a separate complex for various sports. Also, the libraries are decked with Lacs of books, journals, thesis and digital books. Other than that, various canteens and cafeteria are also available inside the hostel premises.</p>\",\"order\":3,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-facilities-are-available-at-campus-of-iit-bombay-qna-7779089\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":39,\"atfCtrIndex\":0.013333,\"showViewOther\":false,\"quesTemplateId\":242458,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-09-08T12:40:05\",\"context\":\"Infrastructure\",\"isStale\":false}],\"ovp_section_infrastructure\":[{\"anaFaqId\":100560406,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_infrastructure\",\"questionId\":7779097,\"answerId\":7779099,\"questionText\":\"Is it compulsory to stay in hostel in IIT Bombay? \",\"answerText\":\"<p>No, it&rsquo;s not compulsory for regular scholars to stay in the hostel for studying at IIT Bombay. Also, not every student gets a hostel facility. However, students who get enrolled in summer and winter internships have to stay in a hostel during the tenure of their internship. Interns who get the hostel are required to complete the formalities such as registration, payment of internship fees, etc., with the academic office of the institute.</p>\",\"order\":0,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/is-it-compulsory-to-stay-in-hostel-in-iit-bombay-qna-7779097\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":41,\"atfCtrIndex\":0.013333,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-09-08T12:36:03\",\"context\":\"Infrastructure\",\"isStale\":false},{\"anaFaqId\":104773358,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_infrastructure\",\"questionId\":7779105,\"answerId\":7779107,\"questionText\":\"How is hostel life at IIT Bombay? \",\"answerText\":\"<p>IIT Bombay is popular for its cheerful hostel life. The institute’s hostel has modern amenities that makes it most viable among students. It has several cafeterias and canteens with affordable food options. Cultural, sports and technical championships are conducted inside the campus. Students can spend their free time playing indoor and outdoor sports such as pool, basketball court and table tennis. IIT Bombay has encouraging atmosphere.</p>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-is-hostel-life-at-iit-bombay-qna-7779105\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":41,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2025-10-17T14:31:43\",\"context\":\"Infrastructure\",\"isStale\":false},{\"anaFaqId\":148450229,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_infrastructure\",\"questionId\":7779079,\"answerId\":7779081,\"questionText\":\"Does IIT Bombay have a hostel? \",\"answerText\":\"<p>Yes, IIT Bombay provides on-campus residential accommodation across Powai campus through multiple numbered hostels and hostel blocks (such as Tansa). Rooms are allotted based on availability, programme, category and institute policy, with first-year students generally placed in shared accomodation. Hostel administration, mess policies, and residential guidelines are coordinated by IIT Bombay's Hostel Coordinating Unit (HCU).</p>\",\"order\":2,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/does-iit-bombay-have-a-hostel-qna-7779079\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":39,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-25T10:59:03\",\"context\":\"Infrastructure\",\"isStale\":false},{\"anaFaqId\":165819029,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_infrastructure\",\"questionId\":7425333,\"answerId\":7425335,\"questionText\":\"How is the campus of IIT Bombay?\",\"answerText\":\"IIT Bombay has a technologically advanced campus. IIT Bombay has one of the best campuses in India with state-of-the-art infrastructure, modern amenities and research laboratories. In addition to this, IIT Bombay also has separate hostels for boys and girls. IIT Bombay offers hostel facilities to both domestic and international students. Also, a special hostel is constructed to offer accommodation to foreign national students. The classrooms of IIT Bombay are bestowed with audio-visual aids along with digital smart boards to promote innovative and interactive learning. \",\"order\":3,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-is-the-campus-of-iit-bombay-qna-7425333\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":41,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-05-11T15:51:04\",\"context\":\"Infrastructure\",\"isStale\":false}],\"ovp_section_fAQs\":[{\"anaFaqId\":167302530,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":7926223,\"answerId\":7926233,\"questionText\":\"What is the salary of MBA in IIT Bombay SJMSOM?\",\"answerText\":\"<p>The placement rate recorded during SJMSOM IIT Bombay MBA placements 2026 was 100%. Students get a good salary package after completing MBA from a reputed institute like SJMSOM. The highest package and average package offered during SJMSOM IIT Bombay MBA placements 2026 stood at <strong>INR 53.8 LPA</strong>&nbsp;and&nbsp;<strong>INR 28.16 LPA</strong>, respectively. The top recruiters of SJMSOM IIT Bombay in 2026 included leading companies such as Google, Intel, Samasung, etc.&nbsp;</p>\",\"order\":0,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-salary-of-mba-in-iit-bombay-sjmsom-qna-7926223\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":33,\"atfCtrIndex\":0.013333,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":1,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T11:42:31\",\"context\":\"Fees\",\"isStale\":false},{\"anaFaqId\":143555391,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":8657569,\"answerId\":8657611,\"questionText\":\"Which is better for pursuing a BDes - IIT Bombay or NIFT Mumbai? \",\"answerText\":\"<p>Both IIT Bombay and NIFT Mumbai&nbsp;are recognised for their BDes course. For better comparison, below are some parameters to compare BDes programme of both the institutes:</p><table style=\\\"border-collapse: collapse; width: 99.9618%; height: 134.375px;\\\" border=\\\"1\\\"><colgroup><col style=\\\"width: 33.3693%;\\\"><col style=\\\"width: 33.3693%;\\\"><col style=\\\"width: 33.3693%;\\\"></colgroup><tbody><tr style=\\\"height: 22.3958px;\\\"><th style=\\\"height: 22.3958px;\\\">Parameter</th><th style=\\\"height: 22.3958px;\\\">IIT Bombay</th><th style=\\\"height: 22.3958px;\\\">NIFT Mumbai</th></tr><tr style=\\\"height: 22.3958px;\\\"><td style=\\\"height: 22.3958px;\\\">Total tuition fee*</td><td style=\\\"height: 22.3958px;\\\">INR 8 L</td><td style=\\\"height: 22.3958px;\\\">INR 9.32 Lacs - INR 12.96 L</td></tr><tr style=\\\"height: 22.3958px;\\\"><td style=\\\"height: 22.3958px;\\\">Overall NIRF Ranking 2025</td><td style=\\\"height: 22.3958px;\\\">3</td><td style=\\\"height: 22.3958px;\\\">NA</td></tr><tr style=\\\"height: 22.3958px;\\\"><td style=\\\"height: 22.3958px;\\\">Selection criteria</td><td style=\\\"height: 22.3958px;\\\">UCEED</td><td style=\\\"height: 22.3958px;\\\">NIFT Entrance Exam</td></tr></tbody></table><p>&nbsp;</p>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/which-is-better-for-pursuing-a-bdes-iit-bombay-or-nift-mumbai-qna-8657569\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":7,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239868,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-08-12T13:22:51\",\"context\":\"Comparison\",\"isStale\":false},{\"anaFaqId\":165819031,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":7779083,\"answerId\":7779085,\"questionText\":\"What is the hostel fee for IIT Bombay? \",\"answerText\":\"<p>Students who get the hostel facility have to pay for the hostel charges, which include various one-time and semester-wise payable components such as Mess Fee, Medical Fee, Hostel Amenities Fund, etc. Find below the bifurcation of IIT Bombay hostel charges for undergraduate courses:&nbsp;</p><table style=\\\"width: 79.89%; height: 234.109px;\\\"><tbody><tr style=\\\"height: 54.5023px;\\\"><th style=\\\"width: 47.4162%; height: 54.5023px;\\\"><p><strong>IIT Bombay Hostel Fee Component</strong></p></th><th style=\\\"width: 52.5423%; height: 54.5023px;\\\"><p><strong>Charges (in INR)</strong></p></th></tr><tr style=\\\"height: 22.4537px;\\\"><td style=\\\"width: 47.4162%; height: 22.4537px;\\\">Hostel Charges</td><td style=\\\"width: 52.5423%; height: 22.4537px;\\\">INR 9150 (Hostel Rent of INR 2,750/- included)</td></tr><tr style=\\\"height: 22.4537px;\\\"><td style=\\\"width: 47.4162%; height: 22.4537px;\\\">Electricity and Water charges&nbsp;</td><td style=\\\"width: 52.5423%; height: 22.4537px;\\\">INR 4000</td></tr><tr style=\\\"height: 22.4537px;\\\"><td style=\\\"width: 47.4162%; height: 22.4537px;\\\">Hostel Amenities Fund&nbsp;</td><td style=\\\"width: 52.5423%; height: 22.4537px;\\\">INR 1800</td></tr><tr style=\\\"height: 44.8611px;\\\"><td style=\\\"width: 47.4162%; height: 44.8611px;\\\">Hostel-Mess Security Deposit (one time)</td><td style=\\\"width: 52.5423%; height: 44.8611px;\\\">INR 5000&nbsp;</td></tr><tr style=\\\"height: 22.4537px;\\\"><td style=\\\"width: 47.4162%; height: 22.4537px;\\\">Total Hostel Fee (A)&nbsp;</td><td style=\\\"width: 52.5423%; height: 22.4537px;\\\">INR 19,950</td></tr><tr style=\\\"height: 22.4537px;\\\"><td style=\\\"width: 47.4162%; height: 22.4537px;\\\">Per Semester Mess Advance (B)&nbsp;</td><td style=\\\"width: 52.5423%; height: 22.4537px;\\\">INR 22,500</td></tr><tr style=\\\"height: 22.4769px;\\\"><td style=\\\"width: 47.4162%; height: 22.4769px;\\\">Total Fees Payable (A+B)&nbsp;</td><td style=\\\"width: 52.5423%; height: 22.4769px;\\\">INR 42,450</td></tr></tbody></table><p><strong><em>Note:</em></strong><em> The above amount are the autumn semester charges for UG courses. The final amount may differ as per the semester and course preference.</em></p>\",\"order\":2,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-hostel-fee-for-iit-bombay-qna-7779083\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":33,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239858,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T12:06:01\",\"context\":\"Fees\",\"isStale\":false},{\"anaFaqId\":167302532,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":4116822,\"answerId\":8674445,\"questionText\":\"What is the total fee of B.Tech at IIT Bombay for 4 years?\",\"answerText\":\"<p>IIT Bombay BTech programmes total tuition fees is <strong>INR 8 lakh&nbsp;</strong>(inclusive of the integrated BTech-MTech fee). Additionally, SC/ ST/ PwD candidates are exempted from paying tuition fees for UG courses. It further reserves the right to revise the fee in subsequent semesters. Moreover, given fee is as per the data collected from unofficial sources. Hence, is subject to change.</p>\",\"order\":3,\"answerCount\":3,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-total-fee-of-b-tech-at-iit-bombay-for-4-years-qna-4116822\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":33,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239478,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T12:10:55\",\"context\":\"Fees\",\"isStale\":false},{\"anaFaqId\":170289974,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":12924875,\"answerId\":12924895,\"questionText\":\"How do I prepare for admission in Design courses at IIT Bombay? \",\"answerText\":\"<p>Admission to Design courses at IIT Bombay requires qualifying the UCEED for B.Des or CEED for MDes. Check below some prepration strategies for admission in design courses at IIT Bombay:</p><ul><li>Review the exact structure of the exam, the types of questions and the time constraints.</li><li>Break the syllabus down into smaller actionable goals.&nbsp;</li><li>Dedicate specific blocks to theory, practice, and the review of incorrect answers.</li><li>Students must solve mock tests and previous year papers to build confidence so they don't run out of time on test day.</li></ul>\",\"order\":4,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-do-i-prepare-for-admission-in-design-courses-at-iit-bombay-qna-12924875\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":1,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-07-16T17:58:47\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":168799636,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":7827907,\"answerId\":7827909,\"questionText\":\"How can I get admission in IIT Mumbai?\",\"answerText\":\"<p>IIT Bombay admission to all the courses is entrance-based (Except for EMBA, where admission is merit-based and performance in the interview round). The IIT Bombay admission process includes the application process, selection round, cutoff, merit list or counselling and other steps. For BTech, candidates have to clear <a href=\\\"https://www.shiksha.com/engineering/jee-main-exam\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">JEE Main</a> and <a href=\\\"https://www.shiksha.com/engineering/jee-advanced-exam\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">JEE Advanced</a>. Further for other courses such as MTech, MBA, MSc, BDes, and MDes, aspirants need to clear GATE, CAT, IITJAM, UCEED, and CEED, respectively to qualify for further admission rounds.&nbsp;</p>\",\"order\":5,\"answerCount\":2,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-can-i-get-admission-in-iit-mumbai-qna-7827907\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":1,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239494,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":2,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2025-01-05T12:22:10\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":168799630,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":7425359,\"answerId\":10001095,\"questionText\":\"Which exam score is accepted for IIT Bombay admissions for the M.Tech course?\",\"answerText\":\"<p>GATE results will be accepted by IIT Bombay for admission to the M.Tech programme. Candidates must secure at least 60% of the total marks (55% of the total marks for SC/ST/PwD category) in any of the following degrees: BE, B.Tech, B.Sc., Bachelor of Architecture and Bachelor of Planning, M.Sc., MCA, MBBS, M.Pharm, B.Pharma, BDS or a recognised qualification equivalent to BE or B.Tech.</p>\",\"order\":6,\"answerCount\":3,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/which-exam-score-is-accepted-for-iit-bombay-admissions-for-the-m-tech-course-qna-7425359\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":5,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":274450,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2024-06-30T13:07:23\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":158021785,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":12803347,\"answerId\":12803457,\"questionText\":\"What is the IIT Bombay GATE cutoff 2026? \",\"answerText\":\"<p>IIT Bombay GATE cutoff 2026 was released till last round for admission to the MTech course for various All India categories.</p><p>For the General AI category, its last round closing rank ranged from <strong>325&nbsp;</strong>to <strong>650</strong>. Hence, a score of at least 510 is required to be eligible for admission. Students can refer to the list of pointers below to see the cutoff range of other categories.&nbsp;</p><ul><li>OBC: 585 - 459</li><li>SC: 433 - 217</li><li>ST: 433 - 217</li><li>EWS: 650 - 325</li></ul>\",\"order\":7,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-iit-bombay-gate-cutoff-2026-qna-12803347\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":23,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":1,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T12:24:51\",\"context\":\"Eligibility\",\"isStale\":false},{\"anaFaqId\":168799646,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":12964867,\"answerId\":12965045,\"questionText\":\"What is the IIT Bombay JAM cutoff for the OBC category? \",\"answerText\":\"<p><strong>IIT Bombay JAM cutoff 2026</strong> for the OBC category ranged from&nbsp;<strong>65</strong> in the first round to&nbsp;<strong>1217&nbsp;</strong>in the last round. As per this range, &nbsp;<strong>MSc in Applied Geology</strong> came out as the most preferred course for admission. Students who want admission to this course need to attain a rank of at least <strong>65</strong> to be qualified for admission. Candidates can check the table below to know the Round 1 and Last Round closing ranks for the OBC AI category.&nbsp;</p><table style=\\\"border-collapse: collapse; width: 100.005%; height: 44.7686px;\\\" border=\\\"1\\\"><colgroup><col style=\\\"width: 36.6087%;\\\"><col style=\\\"width: 30.6492%;\\\"><col style=\\\"width: 32.5222%;\\\"></colgroup><tbody><tr style=\\\"height: 22.3843px;\\\"><th style=\\\"height: 22.3843px;\\\">Course</th><th style=\\\"height: 22.3843px;\\\">Round 1 Cutoff 2026</th><th style=\\\"height: 22.3843px;\\\">Last Round Cutoff 2026</th></tr><tr style=\\\"height: 22.3843px;\\\"><td width=\\\"104\\\" height=\\\"19\\\">M.Sc. in Physics</td><td align=\\\"right\\\" width=\\\"64\\\">118</td><td align=\\\"right\\\" width=\\\"135\\\" height=\\\"19\\\">203</td></tr><tr><td height=\\\"19\\\">M.Sc. in Biotechnology</td><td align=\\\"right\\\">71</td><td align=\\\"right\\\" height=\\\"19\\\">97</td></tr><tr><td height=\\\"19\\\">M.Sc. in Applied Geology</td><td align=\\\"right\\\">65</td><td align=\\\"right\\\" height=\\\"19\\\">65</td></tr><tr><td height=\\\"19\\\">M.Sc. in Applied Geophysics</td><td align=\\\"right\\\">658</td><td align=\\\"right\\\" height=\\\"19\\\">688</td></tr><tr><td height=\\\"19\\\">M.Sc.+ Ph.D. in Environmental Science and Engineering</td><td align=\\\"right\\\">1217</td><td align=\\\"right\\\" height=\\\"19\\\">1217</td></tr><tr><td height=\\\"19\\\">M.Sc. in Mathematics</td><td align=\\\"right\\\">109</td><td align=\\\"right\\\" height=\\\"19\\\">128</td></tr><tr><td height=\\\"19\\\">M.Sc. in Applied Statistics and Informatics</td><td align=\\\"right\\\">82</td><td align=\\\"right\\\" height=\\\"19\\\">138</td></tr><tr><td height=\\\"19\\\">M.Sc. in Chemistry</td><td align=\\\"right\\\">142</td><td align=\\\"right\\\" height=\\\"19\\\">169</td></tr><tr><td height=\\\"19\\\">M.Sc. + Ph.D. in Energy Science and Engineering</td><td align=\\\"right\\\">842</td><td align=\\\"right\\\" height=\\\"19\\\">1030</td></tr><tr><td height=\\\"19\\\">M.Sc. in Operations Research</td><td align=\\\"right\\\">156</td><td align=\\\"right\\\" height=\\\"19\\\">177</td></tr></tbody></table>\",\"order\":8,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-iit-bombay-jam-cutoff-for-the-obc-category-qna-12964867\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":23,\"atfCtrIndex\":0.003289,\"showViewOther\":false,\"quesTemplateId\":242150,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-08-19T10:50:03\",\"context\":\"Eligibility\",\"isStale\":false},{\"anaFaqId\":154754861,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":12811265,\"answerId\":12811271,\"questionText\":\"What is the application fee for M.Tech admissions at IIT Bombay? \",\"answerText\":\"<p>The application fee for M.Tech at IIT Bombay differs for each category. Below is the M.Tech application fee at IITB:</p><table border=\\\"1\\\"><tbody><tr><th>Category</th><th>MTech Application fee for Regular Period</th><th>MTech Application fee for Extended period</th></tr><tr><td>Women candidates</td><td>INR 150</td><td>INR 650</td></tr><tr><td>SC/ ST/ PwD category candidates</td><td>INR 150</td><td>INR 650</td></tr><tr><td>All other candidates</td><td>INR 300</td><td>INR 800</td></tr></tbody></table>\",\"order\":9,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-application-fee-for-m-tech-admissions-at-iit-bombay-qna-12811265\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":5,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-05-15T15:00:03\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":156422913,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":7827951,\"answerId\":7827953,\"questionText\":\"Can I get MTech in IIT Bombay with GATE?\",\"answerText\":\"<p>Yes, GATE score is required to get admission to IIT Bombay course. However, aspirants who have not qualified GATE can also get admission based on written test conducted by the institute. The shortlisted candidates are further called for a personal interview round. In order to be eligible to apply for the course, an aspirant must have a BE/ BTech/ BSc/ Bachelor of Architecture and Bachelor of Planning/ MSc/ MCA/ MBBS/ MPharm/ BPharm/ BDS/ degree recognised equivalent to BE/ BTech with a minimum of 60% aggregate (55% aggregate for SC/ ST/ PwD category) earned through Associate Membership Examinations conducted by recognised professional bodies to apply for&nbsp;<a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/me-mtech-bc\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">MTech</a> course.</p>\",\"order\":10,\"answerCount\":2,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/can-i-get-mtech-in-iit-bombay-with-gate-qna-7827951\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":3,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239654,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-10-16T10:22:56\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":170289978,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":8671159,\"answerId\":8671183,\"questionText\":\"How can I get into IIT Bombay for MDes?\",\"answerText\":\"<p>IIT Bombay admission to MDes programme is entrance-based. Candidates have to follow the below steps to get a seat in the MDes programme:</p><p><strong>Step 1: </strong>Candidates meeting the eligibility requirements have to pay an application fee to register for MDes course.&nbsp;</p><p><strong>Step 2: </strong>IIT Bombay selects candidates for MDes programme based on CEED score. After qualifying CEED, the institute releases a category-wise merit list for each stream. Eligible candidates are required to appear for an IDC (written test) and an interview round.</p><p><strong>Step 3:&nbsp;</strong>After the completion of the selection rounds, IITB releases a final merit list. Selected candidates will then have to appear for the verification of documents in order to complete the admission.</p>\",\"order\":11,\"answerCount\":3,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-can-i-get-into-iit-bombay-for-mdes-qna-8671159\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":1,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239518,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":1,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2025-09-09T14:02:01\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":165819037,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":8657271,\"answerId\":8657281,\"questionText\":\"How many seats are there in IIT Bombay for BDes? \",\"answerText\":\"<p>There a total of 37 seats available in BDes course at IIT Bombay. The seats are filled based on UCEED score. As there are only a few seats, candidates must obtain a good rank in UCEED for admission. Below is category-wise intake for BDes:</p><table style=\\\"height: 135.333px; width: 86.0903%;\\\" border=\\\"1\\\"><tbody><tr style=\\\"height: 22.3889px;\\\"><th style=\\\"width: 55.8045%; height: 22.3889px;\\\">Category</th><th style=\\\"width: 40.5996%; height: 22.3889px;\\\">Intake</th></tr><tr style=\\\"height: 22.3889px;\\\"><td style=\\\"width: 55.8045%; height: 22.3889px;\\\">Open</td><td style=\\\"width: 40.5996%; height: 22.3889px;\\\">14</td></tr><tr style=\\\"height: 22.3889px;\\\"><td style=\\\"width: 55.8045%; height: 22.3889px;\\\">SC</td><td style=\\\"width: 40.5996%; height: 22.3889px;\\\">5</td></tr><tr style=\\\"height: 23.3889px;\\\"><td style=\\\"width: 55.8045%; height: 23.3889px;\\\">ST</td><td style=\\\"width: 40.5996%; height: 23.3889px;\\\">3</td></tr><tr style=\\\"height: 22.3889px;\\\"><td style=\\\"width: 55.8045%; height: 22.3889px;\\\">EWS</td><td style=\\\"width: 40.5996%; height: 22.3889px;\\\">4</td></tr><tr style=\\\"height: 22.3889px;\\\"><td style=\\\"width: 55.8045%; height: 22.3889px;\\\">OBC-NCL</td><td style=\\\"width: 40.5996%; height: 22.3889px;\\\">9</td></tr><tr><td style=\\\"width: 55.8045%;\\\">Open-PwD</td><td style=\\\"width: 40.5996%;\\\">1</td></tr><tr><td style=\\\"width: 55.8045%;\\\">OBC-NCL-PwD</td><td style=\\\"width: 40.5996%;\\\">1</td></tr></tbody></table><p><em><strong>Note: </strong></em><em>PwD reservation at 5% will be horizontal.</em></p>\",\"order\":12,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-many-seats-are-there-in-iit-bombay-for-bdes-qna-8657271\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":5,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":319038,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T13:01:42\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":167302544,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":12924935,\"answerId\":12924949,\"questionText\":\"Can I apply offline for IIT Bombay admission? \",\"answerText\":\"<p>No, students cannot apply offline for IIT Bombay admissions. The entire application process is conducted online through the relevant entrance exam portal. For all programmes including BTech, MTech, BDes, MDes, MBA, etc., students must register and submit details through their respective entrance portals.</p>\",\"order\":13,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/can-i-apply-offline-for-iit-bombay-admission-qna-12924935\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":3,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":318796,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-07-16T18:20:03\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":168799638,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":8657309,\"answerId\":8657313,\"questionText\":\"Who is eligible for BDes in IIT Bombay? \",\"answerText\":\"<p>A minimum of Class 12 is required to apply for BDes course at IIT Bombay. Below is the detailed eligibility:</p><ul><li>Aspirants should have obtained a rank in UCEED. A candidate can attempt UCEED a maximum of two times, and that too in consecutive years. UCEED score is valid for one year and only for admissions in the same corresponding academic year.</li><li>Candidates need to pass all five subjects in Class 12 or equivalent. Those who have appeared for the first time in the qualifying exam in 2022 or earlier are not eligible.</li></ul>\",\"order\":14,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/who-is-eligible-for-bdes-in-iit-bombay-qna-8657309\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":23,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239574,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-08-12T13:47:35\",\"context\":\"Eligibility\",\"isStale\":false},{\"anaFaqId\":170289980,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":9385377,\"answerId\":9385379,\"questionText\":\"Which courses does Industrial Design Centre - IIT Bombay offer? \",\"answerText\":\"Industrial Design Centre - IIT Bombay provides programmes including B.Des, M.Des in streams such as Design, Animation, and are excellent for students to build their careers. The institute has specializations in Fashion Design, UI / UX, Automotive Design.\",\"order\":15,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/which-courses-does-industrial-design-centre-iit-bombay-offer-qna-9385377\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"bulk\",\"templateId\":11,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239758,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2024-03-21T20:02:21\",\"context\":\"Courses\",\"isStale\":false},{\"anaFaqId\":168799640,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_fAQs\",\"questionId\":12965055,\"answerId\":12965101,\"questionText\":\"What is the JAM cutoff for IIT Bombay? \",\"answerText\":\"<p><strong>IIT Bombay JAM cutoff 2026</strong> has been released for admission to the MSc and MSc+ PhD courses. The cutoff was announced for different categories under the All India quota.&nbsp;</p><p>For the General AI category, the overall cutoff ranged from <strong>15&nbsp;</strong> (MSc in Biotechnology) to <strong>839 </strong> (MSc+ PhD in Environmental Science and Engineering). As per the last round closing ranks, MSc in Applied Geology (17), followed by MSc in Biotechnology (26) and MSc in Applied Statistics and Informatics (35) were the most preffered courses for admission. General AI category students can look at the table below to know the Round 1 and Last Round Closing Ranks for different courses.&nbsp;</p><table style=\\\"border-collapse: collapse; width: 100.012%; height: 447.685px;\\\" border=\\\"1\\\"><colgroup><col style=\\\"width: 33.6194%;\\\"><col style=\\\"width: 31.8134%;\\\"><col style=\\\"width: 34.3409%;\\\"></colgroup><tbody><tr style=\\\"height: 22.3843px;\\\"><th style=\\\"height: 22.3843px;\\\">Course</th><th style=\\\"height: 22.3843px;\\\">Round 1 Cutoff 2026</th><th style=\\\"height: 22.3843px;\\\">Last Round Cutoff 2026</th></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\" width=\\\"237\\\" height=\\\"19\\\">M.Sc. in Physics</td><td align=\\\"right\\\" width=\\\"64\\\" height=\\\"19\\\">39</td><td align=\\\"right\\\" width=\\\"145\\\">64</td></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\" height=\\\"19\\\">M.Sc. in Biotechnology</td><td align=\\\"right\\\" height=\\\"19\\\">15</td><td align=\\\"right\\\">26</td></tr><tr style=\\\"height: 44.7685px;\\\"><td style=\\\"height: 44.7685px;\\\" height=\\\"19\\\">M.Sc. in Applied Geology</td><td align=\\\"right\\\" height=\\\"19\\\">16</td><td align=\\\"right\\\">17</td></tr><tr style=\\\"height: 44.7685px;\\\"><td style=\\\"height: 44.7685px;\\\" height=\\\"19\\\">M.Sc. in Applied Geophysics</td><td align=\\\"right\\\" height=\\\"19\\\">390</td><td align=\\\"right\\\">451</td></tr><tr style=\\\"height: 67.1528px;\\\"><td style=\\\"height: 67.1528px;\\\" height=\\\"19\\\">M.Sc.+ Ph.D. in Environmental Science and Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">710</td><td align=\\\"right\\\">839</td></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\" height=\\\"19\\\">M.Sc. in Mathematics</td><td align=\\\"right\\\" height=\\\"19\\\">34</td><td align=\\\"right\\\">55</td></tr><tr style=\\\"height: 67.1528px;\\\"><td style=\\\"height: 67.1528px;\\\" height=\\\"19\\\">M.Sc. in Applied Statistics and Informatics</td><td align=\\\"right\\\" height=\\\"19\\\">22</td><td align=\\\"right\\\">35</td></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\" height=\\\"19\\\">M.Sc. in Chemistry</td><td align=\\\"right\\\" height=\\\"19\\\">33</td><td align=\\\"right\\\">36</td></tr><tr style=\\\"height: 67.1528px;\\\"><td style=\\\"height: 67.1528px;\\\" height=\\\"19\\\">M.Sc. + Ph.D. in Energy Science and Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">582</td><td align=\\\"right\\\">593</td></tr><tr style=\\\"height: 44.7685px;\\\"><td style=\\\"height: 44.7685px;\\\" height=\\\"19\\\">M.Sc. in Operations Research</td><td align=\\\"right\\\" height=\\\"19\\\">26</td><td align=\\\"right\\\">90</td></tr></tbody></table><p><em><strong>Note</strong>: Other categories will have different cutoffs.</em></p>\",\"order\":16,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-jam-cutoff-for-iit-bombay-qna-12965055\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":23,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239726,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-08-19T11:10:02\",\"context\":\"Eligibility\",\"isStale\":false}],\"ovp_section_cutoff\":[{\"anaFaqId\":158021779,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_cutoff\",\"questionId\":12832659,\"answerId\":12832663,\"questionText\":\"Can I get IIT Bombay at 500 rank in IIT JAM? \",\"answerText\":\"<p>Yes, you might get into IIT Bombay with a rank of 500 depending on the course and category. For the General AI category, the highest rank acceptable was <strong>839</strong>. While the more sought-after courses, like M.Sc. in Chemistry or Mathematics, Physics, etc., might not be available, other courses might still be up for grabs.&nbsp; To know the same, see below.</p><table style=\\\"height: 57.0326px; width: 536px;\\\" border=\\\"0\\\" width=\\\"494\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\"><colgroup><col style=\\\"width: 284px;\\\" width=\\\"237\\\"><col style=\\\"width: 252px;\\\" width=\\\"64\\\"></colgroup><tbody><tr style=\\\"height: 12.264px;\\\"><th style=\\\"height: 12.264px;\\\">Course</th><th style=\\\"height: 12.264px;\\\">Last Round Cutoff 2026</th></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\" width=\\\"237\\\" height=\\\"19\\\">M.Sc. + Ph.D. in Energy Science and Engineering</td><td style=\\\"height: 22.3843px; text-align: center;\\\" align=\\\"right\\\" width=\\\"64\\\">593</td></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\" height=\\\"19\\\">M.Sc.+ Ph.D. in Environmental Science and Engineering</td><td style=\\\"height: 22.3843px; text-align: center;\\\" align=\\\"right\\\">839</td></tr></tbody></table><p><em><strong>Note</strong>: Other categories, rounds, courses, etc, will have different cutoffs.</em></p>\",\"order\":0,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/can-i-get-iit-bombay-at-500-rank-in-iit-jam-qna-12832659\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":21,\"atfCtrIndex\":0.013158,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-08-18T19:00:40\",\"context\":\"Cut Off\",\"isStale\":false},{\"anaFaqId\":105095430,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_cutoff\",\"questionId\":11619714,\"answerId\":11620022,\"questionText\":\"What is the female-only OBC category BTech cutoff at IIT Bombay?\",\"answerText\":\"<p>For the OBC female category, the last round cutoff ranged from&nbsp;<strong>280&nbsp;</strong>(BTech CSE) to <strong>5353 </strong>(BS in Environmental Science and Engineering). Among all BTech courses,<strong> BTech CSE</strong> was the most sought-after course for admission, with the cutoff rank of <strong>280</strong>. In the case of BS courses, <strong>BS in Economics </strong>was the most competitive course, with the closing rank of&nbsp;<strong>3139</strong>.</p><p>Students can check the table below to know the Round 1 and Last Round closing ranks for other courses.</p><table style=\\\"border-collapse: collapse; width: 100.053%;\\\" border=\\\"1\\\"><colgroup><col style=\\\"width: 50.0984%;\\\"><col style=\\\"width: 49.9286%;\\\"></colgroup><tbody><tr><th>Course</th><th>Last Round Cutoff 2026</th></tr><tr><td width=\\\"153\\\" height=\\\"19\\\">B.Tech. in Aerospace Engineering</td><td align=\\\"right\\\" width=\\\"64\\\" height=\\\"19\\\">3632</td></tr><tr><td height=\\\"19\\\">B.Tech. in Chemical Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">3280</td></tr><tr><td height=\\\"19\\\">B.Tech. in Civil Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">4410</td></tr><tr><td height=\\\"19\\\">B.Tech. in Computer Science and Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">280</td></tr><tr><td height=\\\"19\\\">B.Tech. in Electrical Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">885</td></tr><tr><td height=\\\"19\\\">B.Tech. in Metallurgical Engineering and Materials Science</td><td align=\\\"right\\\" height=\\\"19\\\">4498</td></tr><tr><td height=\\\"19\\\">B.Tech. in Mechanical Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">2990</td></tr><tr><td height=\\\"19\\\">B.Tech. in Engineering Physics</td><td align=\\\"right\\\" height=\\\"19\\\">3840</td></tr><tr><td height=\\\"19\\\">B.S. in Chemistry</td><td align=\\\"right\\\" height=\\\"19\\\">7860</td></tr><tr><td height=\\\"19\\\">B.S. in Economics</td><td align=\\\"right\\\" height=\\\"19\\\">3139</td></tr><tr><td height=\\\"19\\\">B.S. in Mathematics</td><td align=\\\"right\\\" height=\\\"19\\\">3185</td></tr><tr><td height=\\\"19\\\">B.Tech. + M.Tech. in Electrical Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">1651</td></tr><tr><td height=\\\"19\\\">B.Tech. in Energy Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">4313</td></tr><tr><td height=\\\"19\\\">B.Tech. in Environmental Science and Engineering</td><td align=\\\"right\\\" height=\\\"19\\\">5353</td></tr><tr><td height=\\\"19\\\">B.Tech. in Industrial Engineering and Operations Research</td><td align=\\\"right\\\" height=\\\"19\\\">2608</td></tr><tr><td height=\\\"19\\\">B.S. in Applied Geophysics</td><td align=\\\"right\\\" height=\\\"19\\\">7744</td></tr></tbody></table><p>Note: Other categories, rounds, etc, will have different cutoffs.</p><p>&nbsp;</p>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-female-only-obc-category-btech-cutoff-at-iit-bombay-qna-11619714\"},\"anaFaqSource\":\"manual\",\"generationSource\":\"manual\",\"templateId\":23,\"atfCtrIndex\":0.003289,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-01T15:53:04\",\"context\":\"Eligibility\",\"isStale\":false},{\"anaFaqId\":159651779,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_cutoff\",\"questionId\":12863419,\"answerId\":12863451,\"questionText\":\"Can I get IIT Bombay with a UCEED rank of 20?\",\"answerText\":\"<p>No, you cannot get IIT Bombay with a rank of 20 no matter which category you belong to. As per the cutoff data, the highest rank admissable was <strong>16&nbsp;</strong>for the General AI category.</p><p>Howeever, with a rank of 20, you can get into IIT Delhi, if you belong to the General or OBC AI category. For both these categories, the highest admissable rank was&nbsp;<strong>28&nbsp;</strong>and&nbsp;<strong>32</strong>, respectively. Please know that other categories will have different cutoffs.&nbsp;</p>\",\"order\":2,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/can-i-get-iit-bombay-with-a-uceed-rank-of-20-qna-12863419\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":21,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":319098,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-08-18T17:50:31\",\"context\":\"Cut Off\",\"isStale\":false},{\"anaFaqId\":135653127,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_cutoff\",\"questionId\":12886777,\"answerId\":12886793,\"questionText\":\"What is the JEE Main cutoff for admission to BTech CSE at IIT Bombay? \",\"answerText\":\"<p>The JEE Main cutoff 2026 for admission to BTech CSE at IIT Bombay stood at 67 in the first round for the General AI category. For OBC, the first round closing rank was 60.&nbsp;</p><p>There has been a drop in the closing rank this year when compared to the last&nbsp; years. Below is the CSE cutoff at IIT Bombay in the last 3 years:</p><table><thead><tr><th>Course</th><th>2024</th><th>2025</th><th>2026</th></tr></thead><tbody><tr><td>B.Tech. in Computer Science and Engineering</td><td>68</td><td>66</td><td>67</td></tr></tbody></table>\",\"order\":3,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-jee-main-cutoff-for-admission-to-btech-cse-at-iit-bombay-qna-12886777\"},\"anaFaqSource\":\"manual\",\"generationSource\":\"manual\",\"templateId\":5,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-08-12T14:20:19\",\"context\":\"Admissions\",\"isStale\":false}],\"ovp_section_placements\":[{\"anaFaqId\":161206595,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_placements\",\"questionId\":7751087,\"answerId\":7751089,\"questionText\":\"How many students are placed during IIT Bombay placements? \",\"answerText\":\"<p>The complete placement report for 2026 is not yet released. The course-wise number of students placed over the past two years are presented below:</p><table style=\\\"width: 57.8767%;\\\" border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\"><tbody><tr><th style=\\\"width: 46.8053%;\\\" valign=\\\"top\\\" width=\\\"114\\\"><p><strong>Course </strong></p></th><th style=\\\"width: 28.7519%;\\\" valign=\\\"top\\\" width=\\\"119\\\"><p><strong>Students Placed (2024)</strong></p></th><th style=\\\"width: 24.4056%;\\\"><p><strong>Students Placed (2025)</strong></p></th></tr><tr><td style=\\\"width: 46.8053%;\\\" valign=\\\"top\\\" width=\\\"114\\\"><p>BTech</p></td><td style=\\\"width: 28.7519%;\\\" valign=\\\"top\\\" width=\\\"119\\\"><p>683</p></td><td style=\\\"width: 24.4056%;\\\"><p>678</p></td></tr><tr><td style=\\\"width: 46.8053%;\\\" valign=\\\"top\\\" width=\\\"114\\\"><p>Dual Degree BTech</p></td><td style=\\\"width: 28.7519%;\\\" valign=\\\"top\\\" width=\\\"119\\\"><p>152</p></td><td style=\\\"width: 24.4056%;\\\"><p>357</p></td></tr><tr><td style=\\\"width: 46.8053%;\\\" valign=\\\"top\\\" width=\\\"114\\\"><p>MTech</p></td><td style=\\\"width: 28.7519%;\\\" valign=\\\"top\\\" width=\\\"119\\\"><p>415</p></td><td style=\\\"width: 24.4056%;\\\"><p>390</p></td></tr></tbody></table>\",\"order\":0,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-many-students-are-placed-during-iit-bombay-placements-qna-7751087\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":51,\"atfCtrIndex\":0.083333,\"showViewOther\":false,\"quesTemplateId\":241172,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":3,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T18:06:05\",\"context\":\"Placements\",\"isStale\":false},{\"anaFaqId\":110858625,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_placements\",\"questionId\":7751075,\"answerId\":7751077,\"questionText\":\"How many offers were made during IIT Bombay placements? \",\"answerText\":\"<p>IITB placements 2026 complete report is not released yet. In the meantime, the department-wise offers accepted / students placed during IIT Bombay placements 2025 is presented below:</p><table style=\\\"width: 69.3622%;\\\" border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\"><tbody><tr><th style=\\\"width: 54.5133%;\\\" valign=\\\"top\\\" width=\\\"134\\\"><p><strong>Departments </strong></p></th><th style=\\\"width: 45.2259%;\\\" valign=\\\"top\\\" width=\\\"111\\\"><p><strong>Students Placed (2025)</strong></p></th></tr><tr><td style=\\\"width: 54.5133%;\\\" valign=\\\"top\\\" width=\\\"134\\\"><p>Chemical Engineering</p></td><td style=\\\"width: 45.2259%;\\\" valign=\\\"top\\\" width=\\\"111\\\"><p>98</p></td></tr><tr><td style=\\\"width: 54.5133%;\\\"><p>Electrical Engineering</p></td><td style=\\\"width: 45.2259%;\\\"><p>244</p></td></tr><tr><td style=\\\"width: 54.5133%;\\\"><p>Mechanical Engineering</p></td><td style=\\\"width: 45.2259%;\\\"><p>213</p></td></tr><tr><td style=\\\"width: 54.5133%;\\\" valign=\\\"top\\\" width=\\\"134\\\"><p>Civil Engineering</p></td><td style=\\\"width: 45.2259%;\\\" valign=\\\"top\\\" width=\\\"111\\\"><p>133</p></td></tr><tr><td style=\\\"width: 54.5133%;\\\" valign=\\\"top\\\" width=\\\"134\\\"><p>Computer Science Engineering</p></td><td style=\\\"width: 45.2259%;\\\" valign=\\\"top\\\" width=\\\"111\\\"><p>258</p></td></tr></tbody></table>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-many-offers-were-made-during-iit-bombay-placements-qna-7751075\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":51,\"atfCtrIndex\":0.013333,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":5,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-06-11T10:27:59\",\"context\":\"Placements\",\"isStale\":false}],\"ovp_section_admission_dates\":[{\"anaFaqId\":145248563,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_admission_dates\",\"questionId\":7827921,\"answerId\":7827923,\"questionText\":\"Can I join IIT Bombay after Class 12?\",\"answerText\":\"<p>Admission to the institute after Class 12 is open for BTech, BS and BDes courses. After completing Class 12, candidates must qualify JEE Main, JEE Advanced followed by the JoSAA Counselling for BTech and BS courses. For BDes, UCEED score is required for admission.</p>\",\"order\":0,\"answerCount\":2,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/can-i-join-iit-bombay-after-class-12-qna-7827921\"},\"anaFaqSource\":\"manual\",\"generationSource\":\"manual\",\"templateId\":3,\"atfCtrIndex\":0.003333,\"showViewOther\":false,\"quesTemplateId\":241466,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-09-19T14:51:40\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":168799626,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_admission_dates\",\"questionId\":12924909,\"answerId\":12924911,\"questionText\":\"Is JEE Main required for admission in IIT Bombay? \",\"answerText\":\"<p>Yes, JEE Main is required for admission to IIT Bombay's BTech programmes. It is an eligibility requirement for JEE Advanced. Students cannot get admission to IIT Bombay using only the JEE Main score. Aspirants must appear for JEE Advanced and participate in JoSAA counselling for final seat allotment in BTech course.</p>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/is-jee-main-required-for-admission-in-iit-bombay-qna-12924909\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":3,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239950,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-07-16T18:04:55\",\"context\":\"Admissions\",\"isStale\":false},{\"anaFaqId\":170289970,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_admission_dates\",\"questionId\":8740845,\"answerId\":8740847,\"questionText\":\"How can I get admission to the MA by Research course at IIT Bombay? \",\"answerText\":\"<p>Students holding Bachelor's degree with 60 percent marks (55 percent for reserved category) are eligible to apply. Eligible students should visit the IIT Bombay website to fill the application form. The selection is through GATE or MAAT exam followed by an interview round.</p>\",\"order\":2,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-can-i-get-admission-to-the-ma-by-research-course-at-iit-bombay-qna-8740845\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":1,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2025-10-17T13:47:05\",\"context\":\"Admissions\",\"isStale\":false}],\"ovp_section_scholarships\":[{\"anaFaqId\":148450225,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_scholarships\",\"questionId\":7827925,\"answerId\":7827927,\"questionText\":\"Is there any scholarship for IIT Bombay? \",\"answerText\":\"<p>The institute offers Merit-cum-Means Scholarship to a maximum of 25% of the sanctioned intake of UG and MSc students. Facilities of Free Messing is also available to SC/ ST students under which they get an exemption from paying the tuition fees. In addition, the Office of the Dean Alumni &amp; Corporate Relations manages the Named scholarship endowed by the alumni of the Institute and other wellwishers. In order to avail of any of the offered scholarships, candidates must meet the eligibility conditions set for the respective scholarships. For more information about the offered scholarships, <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/scholarships\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">click here</a>.</p>\",\"order\":0,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/is-there-any-scholarship-for-iit-bombay-qna-7827925\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":63,\"atfCtrIndex\":0.013333,\"showViewOther\":false,\"quesTemplateId\":240816,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-09-19T14:52:08\",\"context\":\"Scholarship\",\"isStale\":false},{\"anaFaqId\":167302528,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_scholarships\",\"questionId\":13037251,\"answerId\":13037257,\"questionText\":\"What types of scholarships are offered by IIT Bombay? \",\"answerText\":\"<p>IIT Bombay offers many financial aids like <strong>Merit-cum-Means scholarship</strong>, full or partial fee waivers schemes, and&nbsp;<strong>SC/ST Support Facilities</strong>. Additionally, female undergraduate students can apply for <strong>Women Merit Scholarships</strong>, and top-performing students can receive <strong>Donor &amp; Alumni Named Scholarships</strong>.</p>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-types-of-scholarships-are-offered-by-iit-bombay-qna-13037251\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":63,\"atfCtrIndex\":0.003289,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-02T12:16:57\",\"context\":\"Scholarship\",\"isStale\":false},{\"anaFaqId\":71496534,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_scholarships\",\"questionId\":8657501,\"answerId\":8657515,\"questionText\":\"Does IIT Bombay offer any merit scholarship?\",\"answerText\":\"<p>Yes, IIT Bombay offers Merit-cum-Means Scholarship to UG students. It is awarded to a maximum of 25% of sanctioned intake. For Dual degree, it is available only up to fourth year.&nbsp;</p><p><strong>Merit Criterion: </strong>For new entrants of BDes their UCEED Rank, will be the criterion. In subsequent years, the criterion will be their academic performance during the preceding academic year.</p><p><strong>Means Criterion:&nbsp;</strong>The parental income is the basis for the &lsquo;means' criterion of the scholarship. At present, &nbsp;students with parents annual gross income from all sources for the previous Financial year does not exceed INR 5 Lacs are eligible to apply for Merit&shy; cum&shy; Means Scholarship.&nbsp;</p>\",\"order\":2,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/does-iit-bombay-offer-any-merit-scholarship-qna-8657501\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":63,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":243032,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-11-17T11:50:07\",\"context\":\"Scholarship\",\"isStale\":false},{\"anaFaqId\":148450227,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_scholarships\",\"questionId\":8657479,\"answerId\":8657483,\"questionText\":\"What are the scholarships offered by BDes programme of IIT Bombay? \",\"answerText\":\"<p>IIT Bombay offers merit-based scholarships to BDes students. Applications for the scholarships are forwarded through IIT. The available scholarships are further as follows:</p><ul><li>Institute Merit-cum-Means</li><li>Free Mess Facilities (SC/ST)</li><li>Remission of Fees</li><li>Named Scholarships</li></ul>\",\"order\":3,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-are-the-scholarships-offered-by-bdes-programme-of-iit-bombay-qna-8657479\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":63,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-11-17T11:37:49\",\"context\":\"Scholarship\",\"isStale\":false}],\"ovp_section_popular_courses\":[{\"anaFaqId\":165819019,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_popular_courses\",\"questionId\":8674457,\"answerId\":10749402,\"questionText\":\"Which course is best in IIT Bombay? \",\"answerText\":\"<p>IIT Bombay is one of the top Engineering institute in the country. It is ranked by various bodies. National Institutional Ranking Framework (NIRF) 2026 has ranked IIT Bombay,&nbsp;<strong>#3</strong> in the \\\"Engineering\\\" category. BTech is the flagship programme of the institute. Moreover, the institute also offers MBA programme. IIT Bombay is also well-known for its Management course. It has secured #10 position in the NIRF 2024 rankings in the Management category.</p>\",\"order\":0,\"answerCount\":3,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/which-course-is-best-in-iit-bombay-qna-8674457\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":13,\"atfCtrIndex\":0.03,\"showViewOther\":false,\"quesTemplateId\":239550,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":3,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-08-12T16:22:38\",\"context\":\"Courses\",\"isStale\":false},{\"anaFaqId\":145243337,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_popular_courses\",\"questionId\":7935517,\"answerId\":7935525,\"questionText\":\"What is the eligibility to join in IIT Bombay? \",\"answerText\":\"<p>IIT Bombay admissions are entrance-based. Candidates must also fulfil the requirements specified by the institute. The eligibility criteria varies course-wise at IIT Bombay. Check below the eligibility of top IIT Bombay courses:</p><table style=\\\"width: 99.9746%;\\\" border=\\\"1\\\"><tbody><tr><th style=\\\"width: 32.9759%;\\\">Course Name</th><th style=\\\"width: 66.9969%;\\\">Common Eligibility</th></tr><tr><td style=\\\"width: 32.9759%;\\\">BTech</td><td style=\\\"width: 66.9969%;\\\"><p>Class 12 with a minimum of 75% aggregate in PCM</p></td></tr><tr><td style=\\\"width: 32.9759%;\\\">BS</td><td style=\\\"width: 66.9969%;\\\"><p>Class 12 with a minimum of 75% aggregate in PCM</p></td></tr><tr><td style=\\\"width: 32.9759%;\\\">MBA</td><td style=\\\"width: 66.9969%;\\\"><p>Bachelor’s degree or a Master’s degree with at least 60% marks (55% in case of candidates belonging to SC/ST/PWD category)</p></td></tr><tr><td style=\\\"width: 32.9759%;\\\">MTech</td><td style=\\\"width: 66.9969%;\\\"><p>Bachelor's degree with a minimum of 60% aggregate (55% aggregate for SC/ ST/ PwD category)</p></td></tr><tr><td style=\\\"width: 32.9759%;\\\">&lt;a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/phd-bc\\\"&gt;PhD&lt;/a&gt;</td><td style=\\\"width: 66.9969%;\\\"><p>Bachelor or Masters or equivalent degree with a minimum of 60% aggregate (55% aggregate for SC/ ST/ PwD category)</p></td></tr></tbody></table>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-eligibility-to-join-in-iit-bombay-qna-7935517\"},\"anaFaqSource\":\"manual\",\"generationSource\":\"manual\",\"templateId\":23,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239636,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":1,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2025-12-03T10:56:49\",\"context\":\"Eligibility\",\"isStale\":false},{\"anaFaqId\":170289968,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_popular_courses\",\"questionId\":5185221,\"answerId\":7926221,\"questionText\":\"Is IIT Bombay good for MBA courses?\",\"answerText\":\"<p>MBA is one of the popular courses at IIT Bombay, offered through the Shailesh J. Mehta School of Management. The institute has a good ranking in the Management category. Here are a few parameters that will help candidates decide if IIT Bombay is a good option for pursuing an MBA:</p><ul><li><strong><span style=\\\"text-decoration: underline;\\\">Rankings</span>: </strong>IIT Bombay has ranked <strong>#3</strong> under the <strong>'Engineering'</strong> category by <strong>Outlook Rankings 2026</strong>. In 2025, NIRF ranked the institute <strong>#3</strong> in the 'Engineering' category, same as last year's rank.&nbsp;</li><li><strong><span style=\\\"text-decoration: underline;\\\">Placements</span>:&nbsp;</strong>IIT Bombay conducts a placement drive every year. Students pursuing an MBA can get placed in the top companies through the placement drive. The&nbsp;<strong>highest</strong>&nbsp;and&nbsp;<strong>average package&nbsp;</strong>offered during SJMSOM IIT Bombay&nbsp;<strong>MBA</strong> placements 2026 stood at <strong>INR 53.8 LPA</strong>&nbsp;and&nbsp;<strong>INR 28.16 LPA</strong>. Further, the&nbsp;<strong>placement rate</strong> recorded during SJMSOM MBA placements 2026 was <strong>100% </strong>and <strong>51&nbsp;companies</strong> visited the placement drive.</li><li><strong><span style=\\\"text-decoration: underline;\\\">Faculty</span>: </strong>As per&nbsp;IIT Bombay Shiksha Reviews, every faculty member here is highly qualified, and many of them have multiple publications in renowned research journals.&nbsp;</li></ul>\",\"order\":2,\"answerCount\":4,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/is-iit-bombay-good-for-mba-courses-qna-5185221\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":13,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239490,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":2,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T15:00:22\",\"context\":\"Courses\",\"isStale\":false},{\"anaFaqId\":168799622,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_popular_courses\",\"questionId\":7827941,\"answerId\":7827943,\"questionText\":\"Is BTech available in IIT Bombay?\",\"answerText\":\"<p>Yes, IIT Bombay offers a four-year BTech in various specialisations. Admission to these programmes is based on merit in JEE Advanced. Only the students who pass JEE main can take the advanced exam. The aspirants who furher meet the cutoff criteria can participate in JoSAA counselling.</p><p>Some of the BTech specialisations offered by IIT Bombay are enlisted below:</p><ol start=\\\"1\\\" type=\\\"1\\\"><li>Aerospace Engineering</li><li>Electrical Engineering</li><li>Mechanical Engineering</li><li>Chemical Engineering</li><li>Computer Science &amp; Engineering</li><li>Metallurgical Engineering &amp; Materials Science</li><li>Engineering Physics</li><li>Civil Engineering</li></ol>\",\"order\":3,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/is-btech-available-in-iit-bombay-qna-7827941\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":11,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239552,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":5,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T17:56:07\",\"context\":\"Courses\",\"isStale\":false}],\"ovp_section_rankings\":[{\"anaFaqId\":134020973,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_rankings\",\"questionId\":7926291,\"answerId\":7926299,\"questionText\":\"Is IIT Bombay MBA ranked? \",\"answerText\":\"<p>IIT Bombay Management course is ranked by various agencies. In <strong>NIRF 2025</strong>, the institute was ranked at <strong>3rd</strong> position in the <strong>'Business &amp; Management Studies'</strong> and <strong>'BE/ BTech'</strong> category. In its engineering, IIT Bombay ranked <strong>#1&nbsp;</strong>under <strong>'BE/ BTech'</strong> and <strong>'Engineering'</strong> category in The Week Ranking 2026. Additionally, in the Outlook Ranking 2026, the institute ranked <strong>#3 </strong>in the <strong>'Engineering'</strong> category.</p>\",\"order\":0,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/is-iit-bombay-mba-ranked-qna-7926291\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":57,\"atfCtrIndex\":0.03,\"showViewOther\":false,\"quesTemplateId\":274604,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T13:12:11\",\"context\":\"Rank\",\"isStale\":false},{\"anaFaqId\":167302524,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_rankings\",\"questionId\":13037385,\"answerId\":13037429,\"questionText\":\"What is the overall NIRF ranking of IIT Bombay?\",\"answerText\":\"<p>In the officially NIRF rankings released by the Ministry of Eduication, IIT Bombay consistently secures <strong>3rd position in both Overall and Engineering categories</strong>. Additionally, the insititute ranks <strong>2nd in Innovation</strong>, <strong>4th in Research.</strong> Also, holds&nbsp;<strong>14th position in Management</strong> nationally.</p>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-overall-nirf-ranking-of-iit-bombay-qna-13037385\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":57,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":240646,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-02T13:18:21\",\"context\":\"Rank\",\"isStale\":false},{\"anaFaqId\":167302526,\"entityId\":54212,\"entityType\":\"institutePage\",\"childPage\":\"overviewPage\",\"wikiIdentifier\":\"ovp_section_rankings\",\"questionId\":13037435,\"answerId\":13037449,\"questionText\":\"What is IIT Bombay's ranking on global platforms like QS?\",\"answerText\":\"<p>IIT Bombay is recognised among the world's top higher education insititutions. It holds high ranks among both national and international bodies. In the QS world ranking 2027,<strong> </strong>it has been ranked <strong>#134</strong> globally<strong>,</strong>&nbsp;<strong>#4 </strong>in <strong>'Asia University Rankings'</strong> and <strong>#267</strong> in <strong>'QS Sustainability Ranking'</strong><strong>.</strong></p>\",\"order\":2,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-iit-bombay-039-s-ranking-on-global-platforms-like-qs-qna-13037435\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":57,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-23T14:41:37\",\"context\":\"Rank\",\"isStale\":false}]},\"showImagePanning\":false,\"compareRecommendedTuples\":{\"10\":[{\"instituteId\":54212,\"instituteName\":\"IIT Bombay\",\"instituteUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212\",\"minFees\":800000,\"maxFees\":800000,\"minMedianSalary\":1792000,\"maxMedianSalary\":1792000,\"rankString\":\"#3\",\"rankSourceString\":\"NIRF, 2025\",\"instituteCompareUrl\":\"/compare-iit-bombay-54212\",\"showFeeDetailsCTA\":true,\"logoUrl\":\"https://images.shiksha.com/mediadata/images/1605086820phpSFQlAR.jpg\",\"ownership\":\"public\",\"cityName\":\"Mumbai\",\"responseCourseId\":109575},{\"instituteId\":53938,\"instituteName\":\"IIT Delhi\",\"instituteUrl\":\"/university/iit-delhi-indian-institute-of-technology-53938\",\"minFees\":800000,\"maxFees\":800000,\"minMedianSalary\":1908000,\"maxMedianSalary\":2430000,\"rankString\":\"#2\",\"rankSourceString\":\"NIRF, 2025\",\"instituteCompareUrl\":\"/compare-iit-bombay-vs-iit-delhi-54212-53938\",\"showFeeDetailsCTA\":true,\"logoUrl\":\"https://images.shiksha.com/mediadata/images/1687868166php8yeOso.jpeg\",\"ownership\":\"public\",\"cityName\":\"Delhi\",\"responseCourseId\":110582},{\"instituteId\":3031,\"instituteName\":\"IIT Madras\",\"instituteUrl\":\"/college/iit-madras-indian-institute-of-technology-adyar-chennai-3031\",\"minFees\":800000,\"maxFees\":800000,\"minMedianSalary\":1500000,\"maxMedianSalary\":4600000,\"rankString\":\"#1\",\"rankSourceString\":\"NIRF, 2025\",\"instituteCompareUrl\":\"/compare-iit-bombay-vs-iit-madras-54212-3031\",\"showFeeDetailsCTA\":true,\"logoUrl\":\"https://images.shiksha.com/mediadata/images/1630668488phpf8KwKV.jpeg\",\"ownership\":\"public\",\"cityName\":\"Chennai\",\"responseCourseId\":90880},{\"instituteId\":2996,\"instituteName\":\"NIT Trichy\",\"instituteUrl\":\"/university/nit-trichy-national-institute-of-technology-tiruchirappalli-2996\",\"minFees\":500000,\"maxFees\":500000,\"minMedianSalary\":0,\"maxMedianSalary\":0,\"rankString\":\"#9\",\"rankSourceString\":\"NIRF, 2025\",\"instituteCompareUrl\":\"/compare-iit-bombay-vs-nit-trichy-54212-2996\",\"showFeeDetailsCTA\":true,\"logoUrl\":\"https://images.shiksha.com/mediadata/images/1569393544phpF4H6mc.jpg\",\"ownership\":\"public\",\"cityName\":\"Tiruchirappalli\",\"responseCourseId\":7948},{\"instituteId\":3011,\"instituteName\":\"IIT BHU\",\"instituteUrl\":\"/college/indian-institute-of-technology-bhu-varanasi-3011\",\"minFees\":800000,\"maxFees\":800000,\"minMedianSalary\":0,\"maxMedianSalary\":0,\"rankString\":\"#10\",\"rankSourceString\":\"NIRF, 2025\",\"instituteCompareUrl\":\"/compare-iit-bombay-vs-iit-bhu-54212-3011\",\"showFeeDetailsCTA\":true,\"logoUrl\":\"https://images.shiksha.com/mediadata/images/1571917722php4T9xSb.jpg\",\"ownership\":\"public\",\"cityName\":\"Varanasi\",\"responseCourseId\":110648},{\"instituteId\":25116,\"instituteName\":\"IIT Kanpur\",\"instituteUrl\":\"/college/iit-kanpur-indian-institute-of-technology-25116\",\"minFees\":800000,\"maxFees\":800000,\"minMedianSalary\":1900000,\"maxMedianSalary\":1940000,\"rankString\":\"#4\",\"rankSourceString\":\"NIRF, 2025\",\"instituteCompareUrl\":\"/compare-iit-bombay-vs-iit-kanpur-54212-25116\",\"showFeeDetailsCTA\":true,\"logoUrl\":\"https://images.shiksha.com/mediadata/images/1570693266php1HVCm6.jpg\",\"ownership\":\"public\",\"cityName\":\"Kanpur\",\"responseCourseId\":109925}]},\"whatsNewBacs\":[{\"id\":10,\"name\":\"B.E. / B.Tech\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/be-btech-bc\",\"topCourseUrl\":null,\"courseCount\":26,\"feeDetailUrl\":null,\"courseDetails\":null},{\"id\":86,\"name\":\"M.E./M.Tech\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/me-mtech-bc\",\"topCourseUrl\":null,\"courseCount\":74,\"feeDetailUrl\":null,\"courseDetails\":null},{\"id\":100,\"name\":\"M.Sc.\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/msc-bc\",\"topCourseUrl\":null,\"courseCount\":12,\"feeDetailUrl\":null,\"courseDetails\":null},{\"id\":124,\"name\":\"Ph.D.\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/phd-bc\",\"topCourseUrl\":null,\"courseCount\":26,\"feeDetailUrl\":null,\"courseDetails\":null},{\"id\":82,\"name\":\"M.A.\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/ma-bc\",\"topCourseUrl\":null,\"courseCount\":3,\"feeDetailUrl\":null,\"courseDetails\":null},{\"id\":169,\"name\":\"MS\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/ms-bc\",\"topCourseUrl\":null,\"courseCount\":2,\"feeDetailUrl\":null,\"courseDetails\":null},{\"id\":85,\"name\":\"M.Des\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/mdes-bc\",\"topCourseUrl\":null,\"courseCount\":5,\"feeDetailUrl\":null,\"courseDetails\":null},{\"id\":193,\"name\":\"Certificate\",\"url\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/certificate-bc\",\"topCourseUrl\":null,\"courseCount\":3,\"feeDetailUrl\":null,\"courseDetails\":null}],\"description\":\"<p><strong>IIT Bombay admissions </strong>updates are as follows:</p>\\n<ul>\\n<li>GATE 2027 City allotment notification for admission to the ME/MTech and Phd will be announced on <strong>Jan 4, 2027</strong>. The exam will be held from <strong>Feb 6 to Feb 7, 2027; Feb 13 to Feb 14, 2027; and Feb 20 to Feb 21, 2027</strong>.</li>\\n<li>IIT JAM 2027 registration process for admission to the MSc course has concluded. The exam will be conducted on <strong>Feb 14, 2027</strong>.</li>\\n<li>JEE Main 2027 session 1 online application form is now available on the official website for admission to the BTech, BArch and BPlan courses till <strong>Nov 22, 2026</strong>. The exam will be held on <strong>Jan 22,2027 to Jan 24,2027 and Jan 28, 2027 to Jan 30, 2027</strong> respectively.</li>\\n<li>CEED 2027&nbsp;exam will be conducted in offline mode on <strong>Jan 17, 2027</strong>.</li>\\n<li>UCEED 2027&nbsp;exam will be held on <strong>Jan 17, 2027.</strong></li>\\n</ul>\",\"instituteSectionData\":{\"ovp_section_highlights\":{\"description\":\"<p><strong>IIT Bombay</strong> operates independently in accordance with the rules of <strong>IIT Council (Ministry of Education)</strong>. According to its Strategy Plan Report 2026-2030 and Beyond, the institute intends to develop globalised academic programmes along with the best 50 global universities. Check below <strong>IITB</strong> highlights:</p>\\n<ul>\\n<li><strong>Courses:</strong> <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses\\\">IIT Bombay courses</a> include BTech, MTech, BDes, etc. BTech is the <strong>flagship course of IIT Bombay. </strong></li>\\n<li><strong>IITB Fees:</strong> The total tuition fee is between INR 21,300 and INR 8 lakh. The lowest fees is for PhD courses and most expensive course is <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/be-btech-bc\\\">BTech</a>.</li>\\n<li><strong>Admissions:</strong> Admission to IIT Bombay is through JEE Main + JEE Advanced, followed by JoSAA counselling. MTech admissions are based on GATE scores. BDes &amp; <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/mba-pgdm-bc\\\">MBA</a> admissions are through UCEED and CAT, respectively.</li>\\n<li><strong>Cut-off: </strong>Cut-off for IIT Bombay BTech 2026 is between <strong>67 and 7838</strong>, where the most preferred specialisation for admission is <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/course-b-tech-in-computer-science-and-engineering-109575\\\">BTech in CSE</a> with the lowest JEE Advanced cut-off rank.</li>\\n<li><strong>Placements: </strong>Overall placement 2026 report hs not been released yet. Meanwhile, as per media reports, IIT Bombay recorded an International placements were the highest with INR 1.5 crore LPA in 2026. Also, as per 2025 report, average package is <strong>INR 26.45 LPA</strong>, while median package was <strong>INR 20 LPA</strong>.</li>\\n<li><strong>Ranking:</strong> IIT Bombay ranks <strong>134th</strong> worldwide in <strong>QS World Rankings 2027</strong> and <strong>3rd</strong> in the Engineering category according to <strong>Outlook Rankings 2026. </strong></li>\\n<li><strong>Notable Alumni:</strong> Notable alumni includes former CEO of Twitter <strong>Parag Agrawal</strong> and former Chairman of ISRO,<strong> Kailasavadivoo Sivan.</strong></li>\\n</ul>\\n<div style=\\\"background: #fff4ea; border-radius: 10px; padding: 14px 16px; margin: 16px 0; border-left: 4px solid #f26922; box-shadow: 0 2px 12px rgba(242,105,34,.12); display: flex; flex-direction: column; align-items: center; text-align: center !important;\\\">\\n<div style=\\\"margin: 0 0 4px; font-size: 14px; font-weight: 800; color: #1a1a1a; width: 100%; text-align: center !important;\\\">Wondering \\\"Is IIT Bombay Worth It?\\\"</div>\\n<div style=\\\"margin: 0 0 10px; font-size: 12px; color: #555; width: 100%; text-align: center !important;\\\">BTech tuition fee is INR 8 Lakh. Access the Complete Fee Structure PDF.</div>\\n<a class=\\\"smce-docs pdf regn-btn\\\" style=\\\"display: inline-block; background: #f26922; color: #fff; padding: 8px 18px; border-radius: 5px; text-decoration: none; font-size: 12px; font-weight: 600; text-align: center !important;\\\" title=\\\"IIT Bombay Fee Details PDF\\\" href=\\\"https://images.shiksha.com/mediadata/pdf/1794557632phphCwH7e.pdf\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">IIT Bombay Fees PDF</a></div>\",\"sectionName\":\"ovp_section_highlights\",\"sectionHeading\":\"IIT Bombay – An Overview\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":false,\"hideAtf\":true,\"desktopReadMoreLimit\":100000,\"mobileReadMoreLimit\":100000},\"ovp_section_bac_wise_courses\":{\"description\":null,\"sectionName\":\"ovp_section_bac_wise_courses\",\"sectionHeading\":\"Popular Courses\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_fAQs\":{\"description\":null,\"sectionName\":\"ovp_section_fAQs\",\"sectionHeading\":\"IIT Bombay FAQs\",\"categoryType\":\"editorial\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_whats_trending\":{\"description\":null,\"sectionName\":\"ovp_section_whats_trending\",\"sectionHeading\":\"IIT Bombay: What's Trending\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":33842,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_scholarships\":{\"description\":\"<p>IIT Bombay offers scholarships in the form of free messing, remission of fees, assistantships, etc. It also accepts nearly all national scholarships offered by the Government of India. Check out some of the top <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/scholarships\\\">IIT Bombay scholarships</a> offered to UG, PG and PhD students in the table below:</p>\\n<table width=\\\"100%\\\">\\n<tbody>\\n<tr>\\n<th width=\\\"28%\\\">\\n<p>Scholarship</p>\\n</th>\\n<th width=\\\"71%\\\">\\n<p>Details</p>\\n</th>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>Free messing (SC/ ST)</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>The facilities of free messing will be granted to eligible SC/ST students</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>Institute merit-cum-means</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>Academic merit, as well as means, will be taken into account to determine eligibility</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>Named scholarships</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>Office of the Dean Alumni &amp; Corporate Relations manages the Named scholarship endowed by the alumni of IIT Bombay and other well-wishers</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>Remission of fees</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>The students whose gross income of parents for the previous financial year is not more than INR 5 LPA are eligible to apply for Remission of fees</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>Free messing (SC/ ST) - MSc</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>All SC/ ST students are exempted from the payment of tuition fees</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>Named scholarships - MSc</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>Office of the Dean Alumni &amp; Corporate Relations manages the named scholarship endowed by the alumni of the IIT Bombay and other well-wishers</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>Institute merit-cum-means - MSc</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>The scholarship is given to students with income up to INR 1 lakh - 5 lakh per annum</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>PG assistantship</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>The amount of fellowship granted to students</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>Research assistantship - PhD</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>The amount of fellowship granted to students</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"28%\\\">\\n<p>Teaching assistantship - PhD</p>\\n</td>\\n<td width=\\\"71%\\\">\\n<p>The amount of fellowship granted to students</p>\\n</td>\\n</tr>\\n<tr>\\n<td>\\n<p>National Scholarships Portal (NSP) Schemes</p>\\n</td>\\n<td>\\n<p>Central/State government scholarships (e.g., Top Class Education for SC/ST, CSSS, PM-USP) verified and forwarded via the IITB Academic Office / SC-ST Cell</p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n<h3>UG Merit-cum-Means (MCM) Scholarship</h3>\\n<p>IIT Bombay awards Merit-cum-Means scholarship to maximum 25% of the seat intake of UG students. For this IIT Mumbai scholarship, academic merit and means criteria is taken into consideration, which is presented below:</p>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\">\\n<tbody>\\n<tr>\\n<th valign=\\\"top\\\" width=\\\"151\\\">\\n<p>Income Limit</p>\\n</th>\\n<th valign=\\\"top\\\" width=\\\"160\\\">\\n<p>UG Women Students Benefit</p>\\n</th>\\n<th valign=\\\"top\\\" width=\\\"160\\\">\\n<p>Other UG Students Benefit</p>\\n</th>\\n</tr>\\n<tr>\\n<td valign=\\\"top\\\" width=\\\"151\\\">\\n<p>Up to INR 1 lakh</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"160\\\">\\n<p>Exemption from tuition fee payment</p>\\n<p>Scholarship of INR 40,000 per year</p>\\n<p>Women merit scholarship of INR 10,000 per year</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"160\\\">\\n<p>Exemption from tuition fee payment</p>\\n<p>Scholarship of INR 40,000 per year</p>\\n<p> </p>\\n</td>\\n</tr>\\n<tr>\\n<td valign=\\\"top\\\" width=\\\"151\\\">\\n<p>Above INR 1 lakh up to INR 3 lakh</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"160\\\">\\n<p>Exemption from tuition fee payment</p>\\n<p>Scholarship of INR 30,000 per year</p>\\n<p>Women merit scholarship of INR 10,000 per year</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"160\\\">\\n<p>Exemption from tuition fee payment</p>\\n<p>Scholarship of INR 40,000 per year</p>\\n<p> </p>\\n</td>\\n</tr>\\n<tr>\\n<td valign=\\\"top\\\" width=\\\"151\\\">\\n<p>Above INR 3 lakh up to INR 5 lakh</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"160\\\">\\n<p>Exemption from tuition fee payment</p>\\n<p>Scholarship of INR 20,000 per year</p>\\n<p>Women merit scholarship of INR 10,000 per year</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"160\\\">\\n<p>Exemption from tuition fee payment</p>\\n<p>Scholarship of INR 40,000 per year</p>\\n<p> </p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n<h3>UG Free Messing Facilities for SC / ST Students </h3>\\n<p>At IIT Mumbai, all SC and ST students are exempted from tuition fee payment. Free mess facility details for SC and ST students of BTech, BDes, Dual Degree BTech courses are presented below:  </p>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\">\\n<tbody>\\n<tr>\\n<th valign=\\\"top\\\" width=\\\"152\\\">\\n<p>Income Limit</p>\\n</th>\\n<th valign=\\\"top\\\" width=\\\"160\\\">\\n<p>UG Women Students Benefit</p>\\n</th>\\n<th valign=\\\"top\\\" width=\\\"159\\\">\\n<p>UG Other Students Benefit</p>\\n</th>\\n</tr>\\n<tr>\\n<td valign=\\\"top\\\" width=\\\"152\\\">\\n<p> </p>\\n<p> </p>\\n<p> </p>\\n<p>Up to INR 5 lakh</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"160\\\">\\n<p>Exemption from tuition fee payment</p>\\n<p>Free mess facility</p>\\n<p>Pocket allowance of INR 500 per month</p>\\n<p>Exemption from hostel room rent payment</p>\\n<p>Women merit scholarship of INR 10,000 per year</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"159\\\">\\n<p>Exemption from tuition fee payment</p>\\n<p>Free mess facility</p>\\n<p>Pocket allowance of INR 500 per month</p>\\n<p>Exemption from hostel room rent payment</p>\\n<p> </p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n<p> </p>\",\"sectionName\":\"ovp_section_scholarships\",\"sectionHeading\":\"IIT Bombay Scholarships 2027\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_editorial_videos\":{\"description\":null,\"sectionName\":\"ovp_section_editorial_videos\",\"sectionHeading\":\"IIT Bombay 2026\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_rcb_mini\":{\"description\":null,\"sectionName\":\"ovp_section_rcb_mini\",\"sectionHeading\":null,\"categoryType\":\"productized\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_popular_courses\":{\"description\":\"<p>IIT Bombay offers many courses at different levels, including UG, PG and Doctorate. Programme fee structure generally includes tuition fees, hostel charges (if applicable), and some other one-time charges. Its flaghships courses are BTech, MTech and MBA, candidates can check <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses\\\">IIT Bombay courses</a> fee structure in the below table:</p>\\n<table style=\\\"width: 100%; height: 213.802px;\\\" border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\">\\n<tbody>\\n<tr style=\\\"height: 24.8047px;\\\">\\n<th style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p>Course</p>\\n</th>\\n<th style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p>Total Tuition Fee</p>\\n</th>\\n<th style=\\\"width: 11.3635%;\\\" valign=\\\"top\\\" width=\\\"155\\\">\\n<p>Total Fee</p>\\n</th>\\n</tr>\\n<tr style=\\\"height: 37.7995px;\\\">\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p><a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/be-btech-bc\\\">BTech</a></p>\\n</td>\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p>INR 8 lakh</p>\\n</td>\\n<td style=\\\"width: 11.3635%;\\\" valign=\\\"top\\\" width=\\\"155\\\">\\n<p>INR 11.37 lakh – INR 11.98 lakh</p>\\n</td>\\n</tr>\\n<tr style=\\\"height: 37.7995px;\\\">\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p><a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/me-mtech-bc\\\">MTech</a></p>\\n</td>\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p>INR 2.4 lakh</p>\\n</td>\\n<td style=\\\"width: 11.3635%;\\\" valign=\\\"top\\\" width=\\\"155\\\">\\n<p>INR 5.1 lakh – INR 5.39 lakh</p>\\n</td>\\n</tr>\\n<tr style=\\\"height: 37.7995px;\\\">\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p><a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/mba-pgdm-bc\\\">MBA</a></p>\\n</td>\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p>INR 8 lakh</p>\\n</td>\\n<td style=\\\"width: 11.3635%;\\\" valign=\\\"top\\\" width=\\\"155\\\">\\n<p>INR 15.55 lakh</p>\\n</td>\\n</tr>\\n<tr style=\\\"height: 37.7995px;\\\">\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p><a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/bdes-bc\\\">BDes</a></p>\\n</td>\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p>INR 8 lakh</p>\\n</td>\\n<td style=\\\"width: 11.3635%;\\\" valign=\\\"top\\\" width=\\\"155\\\">\\n<p>INR 11.88 lakh</p>\\n</td>\\n</tr>\\n<tr style=\\\"height: 37.7995px;\\\">\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p><a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/bsc-bc\\\">BS Degree</a></p>\\n</td>\\n<td style=\\\"width: 11.5835%;\\\" valign=\\\"top\\\" width=\\\"158\\\">\\n<p>INR 8 lakh</p>\\n</td>\\n<td style=\\\"width: 11.3635%;\\\" valign=\\\"top\\\" width=\\\"155\\\">\\n<p>INR 11.63 lakh – INR 11.71 lakh</p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n<h3>IIT Bombay Hostel &amp; Mess Fees</h3>\\n<table border=\\\"1\\\"><colgroup><col><col><col></colgroup>\\n<tbody>\\n<tr>\\n<th>Courses</th>\\n<th>Hostel</th>\\n<th>Mess</th>\\n</tr>\\n<tr>\\n<td>UG</td>\\n<td>INR 19,950</td>\\n<td>INR 22,500</td>\\n</tr>\\n<tr>\\n<td>PG and PhD</td>\\n<td>INR 20,250</td>\\n<td>INR 27,000</td>\\n</tr>\\n</tbody>\\n</table>\\n<p>Payment Deadline: Candidates must pay their total semester fee within 7 working days after course registration.</p>\\n<h3>IIT Bombay Fee Refund Policy</h3>\\n<ul>\\n<li>If an aspirant withdraw their admission before the fee payment deadline then their semester fee will be refunded after the deduction of seat acceptence fee and processing fee (INR 5000).</li>\\n<li>If candidates cancel their admisson after the last date of fee payment, only Security Deposits like Institute, Library, and Hostel Caution Money refund. The semester fee will not be refunded.</li>\\n</ul>\",\"sectionName\":\"ovp_section_popular_courses\",\"sectionHeading\":\"What is the fee of IIT Bombay?\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses\",\"isPwa\":true,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":false,\"hideAtf\":true,\"desktopReadMoreLimit\":100000,\"mobileReadMoreLimit\":100000},\"ovp_section_insights\":{\"description\":null,\"sectionName\":\"ovp_section_insights\",\"sectionHeading\":\"IIT Bombay: Insights\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":31942,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_feedback_widget\":{\"description\":null,\"sectionName\":\"ovp_section_feedback_widget\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_application_process\":{\"description\":null,\"sectionName\":\"ovp_section_application_process\",\"sectionHeading\":\"Application process\",\"categoryType\":\"editorial\",\"showToc\":true,\"childPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/admission\",\"isPwa\":true,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_college_comparison\":{\"description\":null,\"sectionName\":\"ovp_section_college_comparison\",\"sectionHeading\":\"College comparison\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_polls\":{\"description\":null,\"sectionName\":\"ovp_section_polls\",\"sectionHeading\":\"Polls\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_reviews\":{\"description\":null,\"sectionName\":\"ovp_section_reviews\",\"sectionHeading\":\"Student Reviews\",\"categoryType\":\"productized\",\"showToc\":true,\"childPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/reviews\",\"isPwa\":true,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_results\":{\"description\":null,\"sectionName\":\"ovp_section_results\",\"sectionHeading\":\"Results\",\"categoryType\":\"editorial\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_notable_alumni\":{\"description\":\"<p>The alumni of IIT Bombay are placed in different sectors such as <strong>Engineering, Business Development, Marketing, Human Resources, Programme &amp; Product Management,</strong> among others. Apart from this, IIT Bombay's alumni have also been active participants in our society and represent the country nationally and internationally as social workers and entrepreneurs. Some of the <strong>notable alumni</strong> who have added value to the system of IIT Bombay are enlisted below:</p>\\n<table border=\\\"1\\\">\\n<tbody>\\n<tr>\\n<th style=\\\"width: 707.438px;\\\">\\n<p>Alumni Name</p>\\n</th>\\n<th style=\\\"width: 338.229px;\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\">Alumni Photograph</div>\\n</div>\\n</div>\\n</div>\\n</div>\\n</div>\\n</div>\\n</div>\\n</div>\\n</div>\\n</div>\\n</div>\\n</th>\\n</tr>\\n<tr>\\n<td style=\\\"width: 707.438px;\\\">\\n<p><strong>Twitter CEO - Parag Agrawal:</strong> The former CEO of Twitter has pursued BTech in Computer Science Engineering from IIT Bombay. He joined Twitter in 2011 as a Software Engineer and was later appointed the Chief Technology Officer in October 2017.</p>\\n</td>\\n<td style=\\\"width: 338.229px;\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\"><picture><source media=\\\"(max-width: 500px)\\\" data-originalset=\\\"https://images.shiksha.com/mediadata/images/articles/1642578606phpC96mbF_480x360.jpeg\\\"><img class=\\\"lazy\\\" style=\\\"display: block; margin-left: auto; margin-right: auto;\\\" src=\\\"https://images.shiksha.com/mediadata/images/articles/1642578606phpC96mbF.jpeg\\\" alt=\\\"Top Alumni of IIT Bombay\\\" width=\\\"172\\\" height=\\\"163\\\"></picture></div>\\n</div>\\n</div>\\n</div>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"width: 707.438px;\\\">\\n<p><strong>ISRO Chairman - Kailasavadivoo Sivan: </strong>Dr. K. Sivan completed his PhD in Aerospace engineering from IIT Bombay in 2006. He was the former Director of Vikram Sarabhai Space Center in Thiruvananthapuram.</p>\\n</td>\\n<td style=\\\"width: 338.229px;\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\"><picture><source media=\\\"(max-width: 500px)\\\" data-originalset=\\\"https://images.shiksha.com/mediadata/images/articles/1642578677phpguMQYD_480x360.jpeg\\\"></picture>\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\"><picture><source media=\\\"(max-width: 500px)\\\" data-originalset=\\\"https://images.shiksha.com/mediadata/images/articles/1642578752phpCTUNCa_480x360.jpeg\\\"><img class=\\\"lazy\\\" style=\\\"display: block; margin-left: auto; margin-right: auto;\\\" src=\\\"https://images.shiksha.com/mediadata/images/articles/1642578752phpCTUNCa.jpeg\\\" alt=\\\"Top Alumni of IIT Bombay\\\" width=\\\"172\\\" height=\\\"135\\\"></picture></div>\\n</div>\\n</div>\\n</div>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"width: 707.438px;\\\">\\n<p><strong>Non-Executive Chairman, Infosys - Nandan Nilekani: </strong>Nandan Nilekani pursued a BTech in Electrical Engineering from IIT Bombay and is one of the founders of Infosys.</p>\\n</td>\\n<td style=\\\"width: 338.229px;\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<p><picture><source media=\\\"(max-width: 500px)\\\" data-originalset=\\\"https://images.shiksha.com/mediadata/images/articles/1642578880php5sFtUd_480x360.jpeg\\\"><img class=\\\"lazy\\\" style=\\\"display: block; margin-left: auto; margin-right: auto;\\\" src=\\\"https://images.shiksha.com/mediadata/images/articles/1642578880php5sFtUd.jpeg\\\" alt=\\\"Top Alumni of IIT Bombay\\\" width=\\\"175\\\" height=\\\"123\\\"></picture></p>\\n</div>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"width: 707.438px;\\\">\\n<p><strong>Co-founder of Ola Cabs - Bhavish Aggarwal: </strong>Bhavish Aggarwal studied for a Bachelor’s degree in Computer Science Engineering from IIT-Bombay in 2008. In January, he co-founded Ola cabs with Ankit Bhati in Bengaluru.</p>\\n</td>\\n<td style=\\\"width: 338.229px;\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\"><picture><source media=\\\"(max-width: 500px)\\\" data-originalset=\\\"https://images.shiksha.com/mediadata/images/articles/1642578981phpbtYz7t_480x360.jpeg\\\"></picture>\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\"><picture><source media=\\\"(max-width: 500px)\\\" data-originalset=\\\"https://images.shiksha.com/mediadata/images/articles/1642662375phpPySjbi_480x360.jpeg\\\"><img class=\\\"lazy\\\" style=\\\"display: block; margin-left: auto; margin-right: auto;\\\" src=\\\"https://images.shiksha.com/mediadata/images/articles/1642662375phpPySjbi.jpeg\\\" alt=\\\"Top alumni of IIT Bombay\\\" width=\\\"150\\\" height=\\\"168\\\"></picture></div>\\n</div>\\n</div>\\n</div>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"width: 707.438px;\\\">\\n<p><strong>Indian Comedian - Vipul Goyal: </strong>Vipul is one of the best entertainers and stand-up comedians in India. He was also featured in the web series named ‘Humourly Yours’. He studied Electrical Engineering from IIT Bombay.</p>\\n</td>\\n<td style=\\\"width: 338.229px;\\\">\\n<div class=\\\"photo-widget-full\\\">\\n<div class=\\\"figure\\\"><picture><source media=\\\"(max-width: 500px)\\\" data-originalset=\\\"https://images.shiksha.com/mediadata/images/articles/1642579067phprFmcGf_480x360.jpeg\\\"><img class=\\\"lazy\\\" style=\\\"display: block; margin-left: auto; margin-right: auto;\\\" src=\\\"https://images.shiksha.com/mediadata/images/articles/1642579067phprFmcGf.jpeg\\\" alt=\\\"Top Alumni of IIT Bombay\\\" width=\\\"179\\\" height=\\\"134\\\"></picture></div>\\n</div>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n<p> </p>\\n<div class=\\\"vcmsEmbed\\\" style=\\\"margin: 5px 0;\\\"> </div>\",\"sectionName\":\"ovp_section_notable_alumni\",\"sectionHeading\":\"IIT Bombay Notable Alumni\",\"categoryType\":\"editorial\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_cutoff\":{\"description\":\"<p>IIT Bombay cutoffs for its BTech admissions are based on JEE Advanced ranks and released through JoSAA counselling rounds. The cutoff varies by specialisation and category, which candidates can check below:</p>\\n<ul>\\n<li><strong>IIT Bombay BTech Cutoff: </strong>In Round 5 of JEE Advanced 2026, closing ranks for General category ranged from <strong>67 </strong>to<strong> 7838</strong> across all BTech branches.</li>\\n<li><strong>Competition: </strong>Computer Science and Engineering recorded the toughest cutoff, closing at rank <strong>67</strong> in <strong>Round 5</strong> for General category candidates. <strong>BTech in Chemistry</strong> was the least competitive specialisation, with a closing rank of <strong>7838</strong>.</li>\\n</ul>\\n<p>Candidates can check the table below to know more about BTech cutoff trends across specialisations:</p>\",\"sectionName\":\"ovp_section_cutoff\",\"sectionHeading\":\"IIT Bombay Cutoff 2026\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/cutoff\",\"isPwa\":true,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":false,\"hideAtf\":true,\"desktopReadMoreLimit\":100000,\"mobileReadMoreLimit\":100000},\"ovp_section_placements\":{\"description\":\"<p><strong>IIT Bombay final placement report 2026</strong> has not released yet. However, As per media reports, during the recent placement drive, highest package offered was <strong style=\\\"mso-bidi-font-weight: normal;\\\">above</strong> <strong style=\\\"mso-bidi-font-weight: normal;\\\">INR 1 Crore per Annum</strong>. Average package stood at around <strong style=\\\"mso-bidi-font-weight: normal;\\\">INR 25 LPA</strong> in <strong style=\\\"mso-bidi-font-weight: normal;\\\">2026</strong>.</p>\\n<p class=\\\"MsoNormal\\\"><strong>Placement Highlights (2026)</strong></p>\\n<ul style=\\\"margin-top: 0in;\\\" type=\\\"disc\\\">\\n<li class=\\\"MsoNormal\\\" style=\\\"mso-list: l0 level1 lfo1; tab-stops: list .5in;\\\"><strong>Day 1 Offers:</strong> On the first day of the 2026 placement drive, <strong>42 companies</strong> visited the campus. Top<strong> 75 percentile students</strong> received <strong>median package of INR 30.95 LPA</strong>. Whereas the top 50 percentile students got <strong>median salary of 32 LPA</strong>.</li>\\n<li class=\\\"MsoNormal\\\" style=\\\"mso-list: l0 level1 lfo1; tab-stops: list .5in;\\\"><strong>Highest International Package:</strong> The highest international package on the Day 1 stood at <strong>INR 1.50 Crore per annum</strong>.</li>\\n</ul>\\n<p class=\\\"MsoNormal\\\"><strong>Course-Specific Placement Statistics</strong></p>\\n<p class=\\\"MsoNormal\\\"><strong>1. MBA (SJMSOM)</strong></p>\\n<p class=\\\"MsoNormal\\\">The MBA programme recorded a <strong>100% placement rate</strong> for the batch. Where the <strong>highest, median </strong>and<strong> average package </strong>was <strong>INR 53.80 LPA</strong>, <strong>INR 28.16 LPA </strong>and <strong>INR 26.64 LPA</strong>.</p>\\n<p class=\\\"MsoNormal\\\"><strong>2. BTech Programme</strong></p>\\n<p class=\\\"MsoNormal\\\">The placement performance for the flagship <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/courses/be-btech-bc\\\">BTech programme</a> can be reviewed in the table:</p>\\n<table>\\n<thead>\\n<tr>\\n<th>Particulars</th>\\n<th>Statistics (2023)</th>\\n<th>Statistics (2024)</th>\\n<th>Statistics (2025)</th>\\n</tr>\\n</thead>\\n<tbody>\\n<tr>\\n<td>Students Placed</td>\\n<td>598</td>\\n<td>683</td>\\n<td>678</td>\\n</tr>\\n<tr>\\n<td>Placement Percentage</td>\\n<td>88%</td>\\n<td>83.39%</td>\\n<td>81.79%</td>\\n</tr>\\n<tr>\\n<td>Students Participated</td>\\n<td>679</td>\\n<td>819</td>\\n<td>829</td>\\n</tr>\\n<tr>\\n<td>Students Registered</td>\\n<td>791</td>\\n<td>930</td>\\n<td>– / –</td>\\n</tr>\\n</tbody>\\n</table>\\n<p class=\\\"MsoNormal\\\"><strong>Recruiters: </strong>Top recruiters participating in the IIT Bombay placement drives 2026 was Deloitte, Flipkart, Accenture, Amazon, Asian Paints and EY.</p>\",\"sectionName\":\"ovp_section_placements\",\"sectionHeading\":\"How are the placements at IIT Bombay?\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/placement\",\"isPwa\":true,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":true,\"hideAtf\":true,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_other_popular_GOCs\":{\"description\":null,\"sectionName\":\"ovp_section_other_popular_GOCs\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_affiliated_colleges/departments\":{\"description\":null,\"sectionName\":\"ovp_section_affiliated_colleges/departments\",\"sectionHeading\":\"Colleges/Departments\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_about_college\":{\"description\":\"<p><strong>IIT Bombay admissions </strong>updates are as follows:</p>\\n<ul>\\n<li>GATE 2027 City allotment notification for admission to the ME/MTech and Phd will be announced on <strong>Jan 4, 2027</strong>. The exam will be held from <strong>Feb 6 to Feb 7, 2027; Feb 13 to Feb 14, 2027; and Feb 20 to Feb 21, 2027</strong>.</li>\\n<li>IIT JAM 2027 registration process for admission to the MSc course has concluded. The exam will be conducted on <strong>Feb 14, 2027</strong>.</li>\\n<li>JEE Main 2027 session 1 online application form is now available on the official website for admission to the BTech, BArch and BPlan courses till <strong>Nov 22, 2026</strong>. The exam will be held on <strong>Jan 22,2027 to Jan 24,2027 and Jan 28, 2027 to Jan 30, 2027</strong> respectively.</li>\\n<li>CEED 2027&nbsp;exam will be conducted in offline mode on <strong>Jan 17, 2027</strong>.</li>\\n<li>UCEED 2027&nbsp;exam will be held on <strong>Jan 17, 2027.</strong></li>\\n</ul>\",\"sectionName\":\"ovp_section_about_college\",\"sectionHeading\":\"Introduction\",\"categoryType\":null,\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_faculty\":{\"description\":null,\"sectionName\":\"ovp_section_faculty\",\"sectionHeading\":\"Faculty\",\"categoryType\":\"editorial\",\"showToc\":true,\"childPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/faculty\",\"isPwa\":true,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_college_counselling\":{\"description\":null,\"sectionName\":\"ovp_section_college_counselling\",\"sectionHeading\":null,\"categoryType\":\"productized\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_dfp_ada_3_and_4\":{\"description\":null,\"sectionName\":\"ovp_section_dfp_ada_3_and_4\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_reco_widget_1\":{\"description\":null,\"sectionName\":\"ovp_section_reco_widget_1\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_billboard\":{\"description\":null,\"sectionName\":\"ovp_section_billboard\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_infrastructure\":{\"description\":\"<p>IIT Bombay infrastructure is spreads across 545 acres, featuring a fully residential green area. It operates as a self-contained academic township offering modern academic, residential, civic, and sports infrastructure. Check below for more information about <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/infrastructure\\\">IIT Bombay campus</a>:</p>\\n<ul>\\n<li>\\n<p><strong>Connectivity: </strong>The Institute is about an hour away from central Mumbai and is easily reached by local buses and trains.</p>\\n</li>\\n<li>\\n<p><strong>Living on Campus: </strong>Most students live in hostels, and teachers live in staff quarters on campus.</p>\\n</li>\\n<li>\\n<p><strong>Daily Facilities:</strong> IIT Bombay campus acts like a small town. It has a hospital, two banks, a shopping center, etc.</p>\\n</li>\\n<li>\\n<p><strong>Sports Facilities: </strong>Students can use a swimming pool, badminton, and squash courts, along with large grounds for outdoor sports.</p>\\n</li>\\n<li>\\n<p><strong>Student Activities: </strong>There are clubs for music, drama, films, debating, and outdoor activities like trekking.</p>\\n</li>\\n</ul>\\n<h3><strong style=\\\"mso-bidi-font-weight: normal;\\\">IIT Bombay Hostel Structure and Facilities <span style=\\\"mso-spacerun: yes;\\\"> </span></strong></h3>\\n<p class=\\\"MsoNormal\\\">First year Boys students are allotted Hostel 15 or 16 and Girls students are allotted Hostel 16C in a separate wing. On each floor, there are 3 subsections and every subsection has 6 rooms. Each room is shared by 2 students. Students get the Hostel room on the day of registration after arriving and mentioning the details at the warden’s office.</p>\\n<p class=\\\"MsoNormal\\\">Each Hostel at IIT Bombay has a mess, TV, gym, computer room and sports facilities for indoor &amp; outdoor games. At Hostel 15 and 16, stationery and photocopy shops are also present.</p>\",\"sectionName\":\"ovp_section_infrastructure\",\"sectionHeading\":\"Infrastructure and Facilities at IIT Bombay\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/infrastructure\",\"isPwa\":true,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_reco_widget_2\":{\"description\":null,\"sectionName\":\"ovp_section_reco_widget_2\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_ai_overview\":{\"description\":null,\"sectionName\":\"ovp_section_ai_overview\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_dfp_ada_5_and_6\":{\"description\":null,\"sectionName\":\"ovp_section_dfp_ada_5_and_6\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_dfp_ada_1_and_2\":{\"description\":null,\"sectionName\":\"ovp_section_dfp_ada_1_and_2\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_similar_webinar\":{\"description\":null,\"sectionName\":\"ovp_section_similar_webinar\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_online_courses\":{\"description\":null,\"sectionName\":\"ovp_section_online_courses\",\"sectionHeading\":\"Top online courses you might be interested in\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_college_counselling_non_paid\":{\"description\":null,\"sectionName\":\"ovp_section_college_counselling_non_paid\",\"sectionHeading\":\"College Counselling Non Paid\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_comments\":{\"description\":null,\"sectionName\":\"ovp_section_comments\",\"sectionHeading\":\"Student Forum\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/questions\",\"isPwa\":false,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_admission_dates\":{\"description\":\"<p>IIT Bombay grants admission to its programmes based on national-level entrance test ranks followed by centralised counselling or direct departmental evaluations. Candidates must meet the eligibility rules specific to their chosen course. Complete guide of IIT Bombay admission is mentioned below:</p>\\n<h3>IIT Bombay Selection Criteria</h3>\\n<ul type=\\\"disc\\\">\\n<li>BTech / BS / Dual Degree: Based on rank in <a href=\\\"https://www.shiksha.com/engineering/jee-advanced-exam\\\">JEE Advanced</a>, followed by JoSAA / CSAB centralised counselling.</li>\\n<li>MTech: <a href=\\\"https://www.shiksha.com/engineering/gate-exam\\\">GATE </a>marks via the COAP portal. Some departments may also conduct a written test or personal interview.</li>\\n<li>MBA: It is based on valid CAT marks, followed by a personal interview round held by SJMSOM, IIT Bombay.</li>\\n<li>MSc: Admission is based on marks in IIT JAM examination, followed by CCMN or JAM counselling.</li>\\n<li>PhD / MS (Research): Based on GATE / UGC-NET / CSIR-NET / CEED marks, followed by a departmental written test and interview.</li>\\n</ul>\\n<h3>IIT Bombay Eligibility Criteria</h3>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\">\\n<tbody>\\n<tr>\\n<th valign=\\\"top\\\" width=\\\"230\\\">\\n<p>Courses</p>\\n</th>\\n<th valign=\\\"top\\\" width=\\\"241\\\">\\n<p>Eligibility</p>\\n</th>\\n</tr>\\n<tr>\\n<td valign=\\\"top\\\" width=\\\"230\\\">\\n<p>BTech</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"241\\\">\\n<p>Class 12 pass with 5 subjects (PCM) with minimum 75% marks. For SC / ST / PwD students aggregate marks required is 65%</p>\\n</td>\\n</tr>\\n<tr>\\n<td valign=\\\"top\\\" width=\\\"230\\\">\\n<p>MTech</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"241\\\">\\n<p>BTech / BSc 9Engineering) or relevant Bachelor’s degree with 60% marks, for reserved category 55% marks required</p>\\n</td>\\n</tr>\\n<tr>\\n<td valign=\\\"top\\\" width=\\\"230\\\">\\n<p>BDes</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"241\\\">\\n<p>Class 12 pass in any stream</p>\\n</td>\\n</tr>\\n<tr>\\n<td valign=\\\"top\\\" width=\\\"230\\\">\\n<p>MBA</p>\\n</td>\\n<td valign=\\\"top\\\" width=\\\"241\\\">\\n<p>Bachelor’s degree with 60% marks, for reserved category 55% marks required</p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n<div style=\\\"background: #fff4ea; border-radius: 10px; padding: 14px 16px; margin: 16px 0; border-left: 4px solid #f26922; box-shadow: 0 2px 12px rgba(242,105,34,.12); display: flex; flex-direction: column; align-items: center; text-align: center !important;\\\">\\n<div style=\\\"margin: 0 0 4px; font-size: 14px; font-weight: 800; color: #1a1a1a; width: 100%; text-align: center !important;\\\">\\\"Start Your Application Today\\\"</div>\\n<div style=\\\"margin: 0 0 10px; font-size: 12px; color: #555; width: 100%; text-align: center !important;\\\">Follow step-by-step guidance and submit your application without confusion.</div>\\n<a class=\\\"smce-docs pdf regn-btn\\\" style=\\\"display: inline-block; background: #f26922; color: #fff; padding: 8px 18px; border-radius: 5px; text-decoration: none; font-size: 12px; font-weight: 600; text-align: center !important;\\\" title=\\\"IIT Bombay Admission PDF\\\" href=\\\"https://images.shiksha.com/mediadata/pdf/1795433532phpwmdIkK.pdf\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Official IIT Bombay Application Process PDF</a></div>\\n<p dir=\\\"ltr\\\"> </p>\\n<h3>IIT Bombay Application Process</h3>\\n<p>UG Candidates (BTech / BDes): Register via JoSAA website (for JEE Advanced) or the UCEED website.</p>\\n<p>PG and PhD: Visit IIT Bombay website and create an account.</p>\\n<ol start=\\\"1\\\" type=\\\"1\\\">\\n<li>Share application form with personal, academic, and national exam details.</li>\\n<li>Upload documents and submit the form online.</li>\\n<li>Pay non-refundable application fee and download final application for document verification.</li>\\n</ol>\\n<p><strong>Application Fee Structure (Direct PG or PhD)</strong></p>\\n<ul type=\\\"disc\\\">\\n<li>General / OBC-NCL / EWS Male: INR 300 (INR 1,600 for MBA)</li>\\n<li>SC / ST / PwD / Female Candidates: INR 150 (INR 800 for MBA)</li>\\n</ul>\\n<p><strong>Required Documents for Admission</strong></p>\\n<ul type=\\\"disc\\\">\\n<li>Class 10 and 12 mark sheets</li>\\n<li>Graduation mark sheets (for PG or PhD courses)</li>\\n<li>Entrance Exam scorecard and admit card (JEE / GATE / CAT / JAM / CEED)</li>\\n<li>Category or Reservation Proof (if applicable)</li>\\n<li>Government-issued ID Proof and Passport-Size Photographs</li>\\n</ul>\",\"sectionName\":\"ovp_section_admission_dates\",\"sectionHeading\":\"IIT Bombay Admission, Eligibility & Application Process 2027\",\"categoryType\":\"ed_and_prod\",\"showToc\":true,\"childPageUrl\":\"/university/iit-bombay-indian-institute-of-technology-mumbai-54212/admission\",\"isPwa\":true,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":false,\"hideProductized\":true,\"hideAtf\":true,\"desktopReadMoreLimit\":100000,\"mobileReadMoreLimit\":100000},\"ovp_section_others_1\":{\"description\":null,\"sectionName\":\"ovp_section_others_1\",\"sectionHeading\":\"Additional Details\",\"categoryType\":\"editorial\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_assistant_card\":{\"description\":null,\"sectionName\":\"ovp_section_assistant_card\",\"sectionHeading\":\"\",\"categoryType\":\"productized\",\"showToc\":false,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_collaboration_and_partnerships\":{\"description\":null,\"sectionName\":\"ovp_section_collaboration_and_partnerships\",\"sectionHeading\":\"Collaboration and partnerships\",\"categoryType\":\"editorial\",\"showToc\":true,\"childPageUrl\":null,\"isPwa\":null,\"entityId\":null,\"uspData\":null,\"h3IdToNameMap\":null,\"h3IdsOrder\":null,\"helpfulCount\":null,\"customDefaultSectionOrder\":false,\"sectionExist\":false,\"dynamicOrder\":true,\"productized\":true,\"hideProductized\":false,\"hideAtf\":false,\"desktopReadMoreLimit\":null,\"mobileReadMoreLimit\":null},\"ovp_section_rankings\":{\"description\":\"<div id=\\\"sectionranking\\\">\\n<p>IIT Bombay has been ranked among the <strong>top 3 engineering institutes in India</strong> for more than <strong>10</strong> years by <strong>NIRF</strong>. Over the past few years, IITB rankings have grown under multiple streams, including Management, Engineering, etc.</p>\\n<ul>\\n<li><strong>QS World University Rankings 2027 </strong>has been released. QS releases its rankings a year ahead. IIT Bombay ranked <strong>134 </strong>in the <strong>World University</strong> category. The rank dropped 5 positions when compared with the 2026 rankings.</li>\\n<li>In the <strong>Outlook ranking 2026</strong>, IIT Bombay secured <strong>#3</strong> position in the 'Engineering catgory', same as last year.</li>\\n<li>In the <strong>Week Ranking 2026</strong>, IIT Bombay ranked <strong>#1</strong> in the <strong>'BE/BTech'</strong> and <strong>'Engineering category'</strong>.</li>\\n<li>IIT Bombay secured the <strong>#3</strong> position in the '<strong>Overall</strong>' and <strong>'Engineering'</strong> categories, respectively, by the <strong>NIRF Rankings 2025</strong>.</li>\\n</ul>\\n<p>Tabulated below are the important <a href=\\\"https://www.shiksha.com/university/iit-bombay-indian-institute-of-technology-mumbai-54212/ranking\\\">IIT Bombay rankings</a>:</p>\\n<table style=\\\"width: 1186px; height: 393px;\\\">\\n<tbody>\\n<tr style=\\\"height: 28px;\\\">\\n<th style=\\\"width: 1167.33px; height: 28px;\\\" colspan=\\\"3\\\">\\n<p>IIT Bombay International Rankings</p>\\n</th>\\n</tr>\\n<tr style=\\\"height: 28px;\\\">\\n<td style=\\\"width: 291.021px; background-color: #bfedd2; border-style: solid; text-align: center; height: 28px;\\\">\\n<p><strong>Ranking Body</strong></p>\\n</td>\\n<td style=\\\"width: 410.667px; background-color: #bfedd2; border-style: solid; text-align: center; height: 28px;\\\">\\n<p><strong>Category</strong></p>\\n</td>\\n<td style=\\\"width: 430.979px; background-color: #bfedd2; border-style: solid; text-align: center; height: 28px;\\\">\\n<p><strong>Rank</strong></p>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"width: 291.021px;\\\">\\n<p>QS World Rankings 2027</p>\\n</td>\\n<td style=\\\"width: 410.667px;\\\">\\n<p>World University</p>\\n</td>\\n<td style=\\\"width: 430.979px;\\\"><strong>134</strong></td>\\n</tr>\\n<tr style=\\\"height: 28px;\\\">\\n<td style=\\\"width: 291.021px; height: 28px;\\\">\\n<p>QS World Rankings 2026</p>\\n</td>\\n<td style=\\\"width: 410.667px; height: 28px;\\\">\\n<p>World University</p>\\n</td>\\n<td style=\\\"width: 430.979px; height: 28px;\\\"><strong>129</strong></td>\\n</tr>\\n<tr style=\\\"height: 28px;\\\">\\n<td style=\\\"width: 291.021px; height: 28px;\\\">\\n<p>QS World Rankings 2026</p>\\n</td>\\n<td style=\\\"width: 410.667px; height: 28px;\\\">\\n<p>Asia</p>\\n</td>\\n<td style=\\\"width: 430.979px; height: 28px;\\\"><strong>71</strong></td>\\n</tr>\\n<tr style=\\\"height: 29px;\\\">\\n<td style=\\\"width: 291.021px; height: 29px;\\\">\\n<p>QS World Rankings 2026</p>\\n</td>\\n<td style=\\\"width: 410.667px; height: 29px;\\\">\\n<p>Southern Asia</p>\\n</td>\\n<td style=\\\"width: 430.979px; height: 29px;\\\"><strong>5</strong></td>\\n</tr>\\n<tr style=\\\"height: 28px;\\\">\\n<td style=\\\"width: 291.021px; height: 28px;\\\">\\n<p>QS World Rankings 2025</p>\\n</td>\\n<td style=\\\"width: 410.667px; height: 28px;\\\">\\n<p>World University</p>\\n</td>\\n<td style=\\\"width: 430.979px; height: 28px;\\\"><strong>118</strong></td>\\n</tr>\\n<tr style=\\\"height: 28px;\\\">\\n<td style=\\\"width: 291.021px; height: 28px;\\\">\\n<p>QS World Rankings 2024</p>\\n</td>\\n<td style=\\\"width: 410.667px; height: 28px;\\\">\\n<p>World University</p>\\n</td>\\n<td style=\\\"width: 430.979px; height: 28px;\\\"><strong>149</strong></td>\\n</tr>\\n<tr style=\\\"height: 28px;\\\">\\n<th style=\\\"width: 1167.33px; height: 28px;\\\" colspan=\\\"3\\\">\\n<p>IIT Bombay National Rankings</p>\\n</th>\\n</tr>\\n<tr style=\\\"height: 28px;\\\">\\n<td sty