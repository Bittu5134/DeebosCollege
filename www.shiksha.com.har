l Life\",\"Eligibility & Cut Offs\",\"Compare\"],\"openFormatReelsInfo\":null,\"visibility\":\"ONLY_CIRCLE_FORMAT\"},\"drivePollsFromFE\":false,\"crawl\":true,\"usersInfo\":{\"3380451\":{\"userId\":3380451,\"firstName\":\"Shobhit\",\"lastName\":\"Saini\",\"name\":\"Shobhit Saini\",\"displayName\":\"shobhit52727\",\"city\":10675,\"locality\":null,\"country\":2,\"imageURL\":\"\",\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/shobhit52727\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":\"2014-03-31 00:00:00\",\"prefYear\":2026,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"After 10th\",\"desiredCourse\":1376,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"NO\",\"ldbuser\":\"YES\",\"ndnc\":\"YES\",\"abroadUser\":false,\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"1\"},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/shobhit52727\",\"isAbroad\":false,\"description\":\"<hr>\\n<p dir=\\\"ltr\\\"><strong>Shobhit Saini</strong> is a Senior Executive (Editorial) at Shiksha.com, where he covers one of the most closely watched beats in Indian education: board exams. With five years of experience in journalism and multimedia production, and a B.A. in Journalism and Mass Communication, he specialises in turning fast-moving academic updates into content students can actually act on.</p>\\n<p dir=\\\"ltr\\\">At Shiksha, his work centres on board exam coverage — dates, admit cards, syllabus changes and results — the updates that can shape a student's exam-day plans. He tracks board schedules and announcements closely, writing and editing news pieces and guides so students get accurate information when they need it, not after the fact. SEO plays a steady role in his process too, helping the right content reach students at the exact moment they're searching for it.</p>\\n<p dir=\\\"ltr\\\">Beyond daily news, Shobhit focuses on prep-and-strategy content — guides built to answer not just \\\"what happened\\\" but \\\"what to do next.\\\" His approach stays simple: clear, accurate information gives students the confidence to walk into an exam room without last-minute panic.</p>\\n<p dir=\\\"ltr\\\"><strong>Get in touch:</strong> <a href=\\\"mailto:shobhit.saini@shiksha.com\\\" rel=\\\"nofollow\\\">shobhit.saini@shiksha.com</a><br><strong>Beat:</strong> Board Exams | Educational News | Student Guidance</p>\",\"twitterLink\":\"https://twitter.com/shobhitsaini619\",\"facebookLink\":null,\"linkedinLink\":\"https://www.linkedin.com/in/shobhit-saini-812a67411/\",\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":71,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"no\"},\"78007874\":{\"userId\":78007874,\"firstName\":\"Al\",\"lastName\":\"Kashaf\",\"name\":\"Al Kashaf\",\"displayName\":\"Sarfaraz200136713\",\"city\":74,\"locality\":null,\"country\":2,\"imageURL\":\"\",\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/Sarfaraz200136713\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":null,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"UG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"NO\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"abroadUser\":false,\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"0\"},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/Sarfaraz200136713\",\"isAbroad\":false,\"description\":\"<p><strong>Role:</strong> Content Author</p>\\n<p><strong>Specializes In:</strong> Creative Writing &amp; University Content</p>\\n<p>Al Kashaf is an experienced content writer and editor with 2 years of experience in content writing, editing and publishing. She has done her Bachelor’s degree in Journalism and Mass Communication. At Shiksha.com, Al Kashaf mainly deals with updating the university pages with accurate and detailed information. Her efforts help the aspirants get all the information about admissions, courses, fees structure and university campus life that helps them make informed decisions for enrollment.</p>\\n<p><strong>Highlights</strong></p>\\n<ul>\\n<li>2 years of experience in content writing, editing and education publishing.</li>\\n<li>Bachelor's Degree in Journalism and Mass Communication provides her with a solid base in research, media and communication.</li>\\n<li>Specialization in University Pages &amp; Creative Writing makes her an expert in writing complex institutional information in a simpler form.</li>\\n</ul>\\n<p>&nbsp;</p>\",\"twitterLink\":null,\"facebookLink\":null,\"linkedinLink\":\"https://in.linkedin.com/in/al-kashaf-chaudhari-bab035246\",\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":79,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"implicit\"},\"29781649\":{\"userId\":29781649,\"firstName\":\"Satyendra\",\"lastName\":\"Singh\",\"name\":\"Satyendra Singh\",\"displayName\":\"Satyendra118347\",\"city\":74,\"locality\":null,\"country\":2,\"imageURL\":\"\",\"workExperience\":9,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/Satyendra118347\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":\"2027-09-03 00:00:00\",\"prefYear\":2025,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"UG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"YES\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"abroadUser\":false,\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"0\"},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/Satyendra118347\",\"isAbroad\":false,\"description\":\"<p style=\\\"text-align: justify;\\\"><strong><span class=\\\"cf0\\\">Engineering Education &amp; Entrance Exam Expert</span></strong></p>\\n<p style=\\\"text-align: justify;\\\"><span class=\\\"cf0\\\"><strong>Role</strong>:</span><span class=\\\"cf1\\\"> Senior News Writer &amp; Content Editor, Shiksha.com</span></p>\\n<p style=\\\"text-align: justify;\\\"><strong><span class=\\\"cf0\\\">Education:</span></strong> <span class=\\\"cf1\\\">B.Tech</span><span class=\\\"cf1\\\"> in Mechanical Engineering [IET], MA Education Philosophy</span></p>\\n<p style=\\\"text-align: justify;\\\">Satyendra Singh is an Engineering graduate with a Master degree in Education Philosophy, working in Education journalism for the past 10 years. At Shiksha.com, he writes specifically in engineering entrance exams like JEE Main, GATE, MHT CET covering the admission process, syllabus &amp; exam pattern updates and preparation modules. His engineering background helps him produce the right content required for engineering aspirants backed with factual accuracy. He has authored more than 500 articles, helping millions of aspirants make a decisive exam and career choice.</p>\\n<p style=\\\"text-align: justify;\\\"><strong>Highlights:</strong></p>\\n<p style=\\\"text-align: justify;\\\"><strong>Domain Expertise:</strong> Engineering education background helps him developing content for preparation as well as admission process as per the demand of various exams and their aspirants.</p>\\n<p style=\\\"text-align: justify;\\\"><strong>Teaching Experience:</strong> Before shifting to education journalism, he has a brief stint as a Mathematics faculty guiding JEE and Olympiads aspirants. This helps him in understanding the dilemmas and tyranny of aspirants and write content accordingly.</p>\\n<p style=\\\"text-align: justify;\\\"><strong>Trusted Voice:</strong> Articles written by him has around 44 million page views, a testament of faith in his content put by aspirants.</p>\\n<p style=\\\"text-align: justify;\\\">Satyendra always believes that every student has the potential to shine, if guided with right and meaningful content.</p>\\n<p style=\\\"text-align: justify;\\\"><strong>Contact:</strong> <a href=\\\"mailto:satyendra.singh@shiksha.com\\\" rel=\\\"nofollow\\\">satyendra.singh@shiksha.com</a></p>\\n<p style=\\\"text-align: justify;\\\"><strong>LinkedIn:</strong> <a href=\\\"https://www.linkedin.com/in/satyendra-singh-6764bb119/\\\" rel=\\\"nofollow\\\">Satyendra Singh</a></p>\",\"twitterLink\":null,\"facebookLink\":null,\"linkedinLink\":\"https://www.linkedin.com/in/satyendra-singh-6764bb119/\",\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":77,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"yes\"},\"34019423\":{\"userId\":34019423,\"firstName\":\"Mamona\",\"lastName\":\"Majumder\",\"name\":\"Mamona Majumder\",\"displayName\":\"Mamona194186\",\"city\":74,\"locality\":null,\"country\":2,\"imageURL\":\"\",\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/Mamona194186\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":2025,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"UG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"YES\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"abroadUser\":false,\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"0\"},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/Mamona194186\",\"isAbroad\":false,\"description\":\"<p><strong>Currently -</strong> Deputy Manager, Content</p>\\n<p><strong>Role -</strong> News and Feature Writer, Content Editor</p>\\n<p><strong>Expertise -</strong> Engineering Education and Counselling</p>\\n<p>Mamona Majumder specialises in news and feature writing and content editing. With nearly eight years of professional experience, she has been curating and writing informative and student centric educational content since 2018.</p>\\n<p>Her work primarily revolves around engineering entrance exams (<a href=\\\"https://www.shiksha.com/engineering/jee-main-exam\\\">JEE Main</a>, <a href=\\\"https://www.shiksha.com/engineering/keam-exam\\\">KEAM</a>, <a href=\\\"https://www.shiksha.com/engineering/ts-eamcet-exam\\\">TS EAMCET</a> etc), exam preparation, admission trends, and counselling processes like&nbsp;<a href=\\\"https://www.shiksha.com/b-tech/josaa-counselling\\\">JoSAA</a>, <a href=\\\"https://www.shiksha.com/b-tech/csab-counselling\\\">CSAB</a>, <a href=\\\"https://www.shiksha.com/b-tech/uptac-counselling\\\">UPTAC</a>, <a href=\\\"https://www.shiksha.com/b-tech/tnea-counselling\\\">TNEA </a>and other state level counselling processes. She aims to help students and aspirants make informed decisions about pursuing engineering as a career. Alongside, she also covers education related news and feature stories that help students and their parents stay informed about important and relevant information.</p>\\n<p>Trusted by lakhs of students for fact based and simplified information, starting from how to prepare for an exam to completion of admission process.&nbsp;</p>\\n<h2>Highlights</h2>\\n<p>Mamona has authored over 1,300 articles and stories, with approximately 23 million reads.</p>\\n<p>Education wise, Mamona holds an MA (Hons) in Advertising and Public Relations and a BA (Hons) in Journalism and Mass Communications. Her academic background and practical industry knowledge make her an expert in domain of education news writing, particularly related to current events, policies, and latest trends.</p>\\n<p><strong>Contact</strong> - mamona.majumder@shiksha.com</p>\",\"twitterLink\":\"https://twitter.com/__mamona__\",\"facebookLink\":null,\"linkedinLink\":\"https://www.linkedin.com/in/mamona-majumder-176a1b124/\",\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":78,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"yes\"},\"7679100\":{\"userId\":7679100,\"firstName\":\"Shiksha Knowledge \",\"lastName\":\"Series \",\"name\":\"Shiksha Knowledge  Series \",\"displayName\":\"ShikshaKnowledge\",\"city\":74,\"locality\":null,\"country\":2,\"imageURL\":\"\",\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/ShikshaKnowledge\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":null,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"PG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"NO\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"abroadUser\":false,\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"0\"},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/ShikshaKnowledge\",\"isAbroad\":false,\"description\":\"This account contains a repository of insightful articles by subject matter experts from all walks of life talking in-depth about various facets of course/college/career selection and corresponding challenges and learnings. The knowledge shared on focused topics is meant to help aspirants introspect and make well informed choices about their undergraduate and postgraduate studies in India across higher education streams.\",\"twitterLink\":null,\"facebookLink\":null,\"linkedinLink\":null,\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":-1,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"implicit\"},\"61302717\":{\"userId\":61302717,\"firstName\":\"Vikash Kumar\",\"lastName\":\"Vishwakarma\",\"name\":\"Vikash Kumar Vishwakarma\",\"displayName\":\"Vikash1965490648\",\"city\":161,\"locality\":null,\"country\":2,\"imageURL\":\"\",\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/Vikash1965490648\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":null,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"PG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"NO\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"abroadUser\":false,\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"1\"},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/Vikash1965490648\",\"isAbroad\":false,\"description\":\"Vikash Kumar is a leading subject matter expert, specializing in K–12 education and competitive exam preparation for JEE Mains. With a BTech degree and over 10 years of experience in creating high quality content for in Physics, Chemistry, and Mathematics, various competitive exams, he creates academic content that blends conceptual clarity with exam-focused strategies. His articles, study guides, and mock tests are trusted by thousands of students preparing for JEE Mains as well as NEET. Vikash can be reached at vikash.k@Shiksha.com.\",\"twitterLink\":null,\"facebookLink\":null,\"linkedinLink\":null,\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":78,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"implicit\"},\"11614203\":{\"userId\":11614203,\"firstName\":\"Anangsha\",\"lastName\":\"Patra\",\"name\":\"Anangsha Patra\",\"displayName\":\"AnangshaPatra\",\"city\":74,\"locality\":898,\"country\":2,\"imageURL\":\"\",\"workExperience\":1,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/AnangshaPatra\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":null,\"prefYear\":2019,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"UG\",\"desiredCourse\":null,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"YES\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"abroadUser\":false,\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"1\"},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/AnangshaPatra\",\"isAbroad\":false,\"description\":\"<div>Anangsha Patra is MA in Mass Communication &amp; Journalism with more than 10 years of experience in the field of Journalism, Content Writing and Editing. At Shiksha.Com, she works as Deputy Manager-Content for the Sarkari Exam Domain. Anangsha specialises in developing content for Banking, Defence, SSC, Railway, Teaching related Sarkari Exams such as NDA, SBI Clerk, SBI PO, SSC CPO, RRB NTPC, RRB Group D, IBPS Clerk, IBPS RRB, AFCAT and many more.</div>\\n<div><strong>Professional Role</strong></div>\\n<div>At Shiksha, Anangsha Manage:</div>\\n<div>• Developing content basis student needs and SEO goals</div>\\n<div>• Ensuring accuracy and clarity in content</div>\\n<div>• Real time coverages of events</div>\\n<div><strong>Expertise</strong></div>\\n<div>• Competitive exam content creation-SBI, IBPS, RRB, SSC, UPSC, etc.</div>\\n<div>• SEO-driven content development for Government Jobs</div>\\n<div>• Student-centric communication</div>\\n<div>• Ground Reporting of Government Exams in India</div>\\n<div>• Conducting Topper Interviews</div>\\n<div>• Covering Latest Govt Jobs News</div>\\n<div><strong>Contribution to Students</strong></div>\\n<div>Through her Role, Anangsha Ensures:</div>\\n<div>• Timely updates on Govt exams, results, and admit cards for NDA, SBI Clerk, SBI PO, SSC CPO, RRB NTPC, RRB Group D, IBPS Clerk, IBPS RRB, AFCAT</div>\\n<div>• Comprehensive preparation resources, guides and live blogs</div>\\n<div>Anangsha believes that delivering reliable content with accurate and updated information to students can help aspirants to choose their right careers.</div>\\n<div><strong>Contact</strong></div>\\n<div><strong>Email:</strong> anangsha.patra@shiksha.com</div>\\n<div><strong>Specialises in:</strong></div>\\n<div>Board Exams/Sarkari Exams/Govt Exams</div>\",\"twitterLink\":\"https://twitter.com/anangsha_patra\",\"facebookLink\":null,\"linkedinLink\":\"https://www.linkedin.com/in/anangsha-patra-b558a521a/\",\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":77,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"implicit\"},\"2582250\":{\"userId\":2582250,\"firstName\":\"UPASANA\",\"lastName\":\"PRADHAN\",\"name\":\"UPASANA PRADHAN\",\"displayName\":\"UPASANA75632\",\"city\":64,\"locality\":null,\"country\":2,\"imageURL\":\"\",\"workExperience\":null,\"usergroup\":\"cms\",\"profilePageURL\":\"/userprofile/UPASANA75632\",\"abroadProfilePageURL\":null,\"passport\":null,\"anyProfileExists\":true,\"userContactInfo\":null,\"userPref\":{\"timeOfStart\":\"2013-07-02 00:00:00\",\"prefYear\":null,\"abroadSubcatId\":null,\"extraFlag\":null,\"educationLevel\":\"PG\",\"desiredCourse\":35,\"isUnsubscribe\":\"0\",\"isAbused\":\"0\",\"isOwnershipChallenged\":\"0\",\"testUser\":\"NO\",\"ldbuser\":\"YES\",\"ndnc\":\"NO\",\"abroadUser\":false,\"hardBounce\":\"0\",\"softBounce\":\"0\",\"mobileVerified\":\"1\",\"emailVerified\":\"1\"},\"userSCMProfile\":null,\"userEducation\":null,\"userPrefLocation\":null,\"userAdditionalInfo\":null,\"userSocialSignUpInfo\":null,\"userAuthorInfo\":{\"activeAuthor\":true,\"authorUrl\":\"/author/UPASANA75632\",\"isAbroad\":false,\"description\":\"<p><span style=\\\"font-weight: 400;\\\">Upasana Pradhan is an Mtech graduate in Electronics and Communication Engineering from DTU who specialises in curating postgraduate and undergraduate engineering entrance exam content, such as <strong>GATE, TS PGECET, KCET, TS EAMCET, VITREE</strong>, etc.&nbsp;</span></p>\\n<p><span style=\\\"font-weight: 400;\\\">With experience in writing college, university, admission, virtual reality and study abroad content, Upasana aims to deliver accurate and student-friendly content that make users to make smart decisions in their career and exam decisions.</span></p>\\n<p><strong>Highlights:</strong></p>\\n<ul>\\n<li aria-level=\\\"1\\\"><strong>Domain expertise: <span style=\\\"font-weight: 400;\\\">crafts content in GATE and other exams covering syllabus, preparation tips, cutoff, exam, admission process, etc.&nbsp;</span></strong></li>\\n</ul>\\n<ul>\\n<li aria-level=\\\"1\\\"><strong>Proven track record:</strong> <span style=\\\"font-weight: 400;\\\">Authored and published around 300+ articles and news related to the exam and admission insights.&nbsp;&nbsp;</span></li>\\n</ul>\\n<ul>\\n<li aria-level=\\\"1\\\"><strong>Student Focused:</strong> <span style=\\\"font-weight: 400;\\\">She believes in Simplifying complex processes into easy, actionable guidance.</span></li>\\n</ul>\\n<ul>\\n<li aria-level=\\\"1\\\"><strong>Reliable Voice:</strong> <span style=\\\"font-weight: 400;\\\">Delivers timely, fact-checked updates so students never miss critical deadlines.</span></li>\\n</ul>\\n<p><strong>Contact details:&nbsp;</strong></p>\\n<p><strong>Email ID - </strong><a href=\\\"mailto:upasana.pradhan@Shiksha.com\\\" rel=\\\"nofollow\\\"><span style=\\\"font-weight: 400;\\\">upasana.pradhan@Shiksha.com</span></a></p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\",\"twitterLink\":null,\"facebookLink\":null,\"linkedinLink\":\"https://www.linkedin.com/in/upasana-pradhan-785b42142/\",\"abroad\":false},\"admissionTakenInfo\":null,\"allUserSCMProfile\":null,\"userConsentSection\":null,\"isSOUser\":\"NO\",\"delete\":\"no\",\"deactivate\":\"no\",\"userCustomQuestion\":null,\"userSecondaryContactInfoObject\":null,\"userRcsUnsubscribeMapping\":null,\"profileCompletionScore\":78,\"deliveryType\":null,\"encFirstName\":null,\"hashedFirstName\":null,\"encLastName\":null,\"hashedLastName\":null,\"encName\":null,\"hashedName\":null,\"encDisplayName\":null,\"hashedDisplayName\":null,\"whatsappPermission\":\"yes\"}},\"admissionDatesBaseCourseWise\":{\"100\":{\"pastDates\":[],\"futureDates\":[{\"eventCategory\":1,\"baseCourseId\":100,\"type\":null,\"entityId\":13560,\"tentative\":false,\"event_name\":\"IIT JAM 2026 Form Correction\",\"start_date\":\"2026-11-25\",\"end_date\":\"2026-12-01\"},{\"eventCategory\":6,\"baseCourseId\":100,\"type\":null,\"entityId\":13560,\"tentative\":false,\"event_name\":\"IIT JAM 2027 Exam Day\",\"start_date\":\"2027-02-14\",\"end_date\