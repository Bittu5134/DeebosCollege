\",\"name\":\"MBA/PGDM\",\"subName\":null,\"count\":-1,\"url\":null,\"enabled\":true,\"checked\":false,\"filterType\":\"base_course\"},{\"id\":\"85\",\"name\":\"M.Des\",\"subName\":null,\"count\":-1,\"url\":null,\"enabled\":true,\"checked\":false,\"filterType\":\"base_course\"}]},\"nameMapping\":{\"offered_by_college\":\"College\",\"course\":\"Course\",\"base_course\":\"Degree\",\"review\":\"Avg. Rating\"},\"filterOrder\":[\"offered_by_college\",\"base_course\",\"course\",\"review\"]},\"instituteInfos\":{\"244704\":{\"id\":244704,\"name\":\"Indian Institute of Technology Kanpur (IIT Kanpur-Online)\",\"url\":\"/college/indian-institute-of-technology-kanpur-iit-kanpur-online-244704\",\"domain\":\"national\"},\"53988\":{\"id\":53988,\"name\":\"IIT Kanpur - Department of Industrial and Management Engineering\",\"url\":\"/college/iit-kanpur-department-of-industrial-and-management-engineering-53988\",\"domain\":\"national\"},\"25116\":{\"id\":25116,\"name\":\"IIT Kanpur - Indian Institute of Technology\",\"url\":\"/college/iit-kanpur-indian-institute-of-technology-25116\",\"domain\":\"national\"}},\"partialResponse\":false},\"anaWidget\":{\"totalNumber\":484,\"listingType\":\"institute\",\"questionsDetail\":{\"12974325\":[{\"answerId\":12974345,\"answerText\":\"<p>According to the <strong>IIT Kanpur GATE cutoff 2024</strong>, the last round closing ranks ranged from <strong>622</strong> to <strong>840</strong> for the General AI category. So, students who score above <strong>630</strong> increase their chances of admission. The higher the score, the better the chances of admission. Check the list below to know the minimum score for different categories.</p><ul><li>General: 840</li><li>OBC: 692</li><li>SC: 504</li><li>ST: 424</li><li>EWS: 693</li><li>PWD: 930</li></ul>\",\"activityTime\":\"3 months ago\",\"answerOwnerUserId\":97214830,\"questionId\":12974325,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":1,\"msgCount\":1,\"viewCount\":7,\"status\":\"LIVE\",\"userId\":97214830,\"firstname\":\"Neerja Rohatgi\",\"lastname\":null,\"creationDate\":\"2026-08-26 09:38:01\",\"url\":\"https://ask.shiksha.com/what-is-the-gate-cutoff-for-m-tech-at-iit-kanpur-qna-12974325\",\"title\":\"What is the GATE cutoff for M.Tech at IIT Kanpur? \",\"answerOwnerName\":\"Neerja Rohatgi \",\"answerOwnerLevel\":\"Contributor-Level 10\",\"answerOwnerImage\":\"\",\"likeCount\":0,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":1,\"questionCreationDate\":\"3 months ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192347,\"tagName\":\"IIT Kanpur - Indian Institute of Technology\",\"tagType\":\"Colleges\"},{\"tagId\":387298,\"tagName\":\"GATE\",\"tagType\":\"Exams\"}]}],\"13050882\":[{\"answerId\":13050884,\"answerText\":\"<p>CSE cut-off for B.Tech programme at IIT Kanpur using JEE Advanced ranks through JoSAA counselling is 283 (General-Gender Neutral) for recent years. Below is a table showing the trend for last three years.</p><table style=\\\"border-collapse: collapse; width: 100.012%; height: 121.528px;\\\" border=\\\"1\\\"><colgroup><col style=\\\"width: 37.2483%;\\\"><col style=\\\"width: 62.7061%;\\\"></colgroup><tbody><tr style=\\\"height: 54.375px;\\\"><th style=\\\"height: 54.375px;\\\">Year</th><th style=\\\"height: 54.375px;\\\"><p>Cutoff (General - open category)</p></th></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\">2026 </td><td style=\\\"height: 22.3843px;\\\"> 283 </td></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\">2025</td><td style=\\\"height: 22.3843px;\\\">271</td></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\">2024</td><td style=\\\"height: 22.3843px;\\\">252</td></tr></tbody></table><div data-bfc=\\\"\\\" data-sfc-cp=\\\"\\\" data-sfc-root=\\\"c\\\" data-ved=\\\"2ahUKEwjahofrl4-YAxXUT2wGHXKYDYcQi4wTegYIAggIEAo\\\" data-hveid=\\\"CAIICBAK\\\"> </div><div data-bfc=\\\"\\\" data-sfc-cp=\\\"\\\" data-sfc-root=\\\"c\\\" data-ved=\\\"2ahUKEwjahofrl4-YAxXUT2wGHXKYDYcQi4wTegYIAggIEA4\\\" data-hveid=\\\"CAIICBAO\\\"><p> </p></div><p> </p>\",\"activityTime\":\"a week ago\",\"answerOwnerUserId\":109142833,\"questionId\":13050882,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":1,\"msgCount\":1,\"viewCount\":2,\"status\":\"LIVE\",\"userId\":109142833,\"firstname\":\"Mahima\",\"lastname\":\"Aggarwal\",\"creationDate\":\"2026-11-17 19:44:59\",\"url\":\"https://ask.shiksha.com/what-is-iit-kanpur-cse-cutoff-trend-qna-13050882\",\"title\":\"What is IIT Kanpur CSE cutoff trend? \",\"answerOwnerName\":\"Mahima Aggarwal\",\"answerOwnerLevel\":\"Contributor-Level 6\",\"answerOwnerImage\":\"\",\"likeCount\":0,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":1,\"questionCreationDate\":\"a week ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192347,\"tagName\":\"IIT Kanpur - Indian Institute of Technology\",\"tagType\":\"Colleges\"},{\"tagId\":192347,\"tagName\":\"IIT Kanpur - Indian Institute of Technology\",\"tagType\":\"Colleges\"}]}],\"12974419\":[{\"answerId\":12974421,\"answerText\":\"<p> IIT Kanpur BTech cutoff for female category.</p>\",\"activityTime\":\"3 months ago\",\"answerOwnerUserId\":97214830,\"questionId\":12974419,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":1,\"msgCount\":1,\"viewCount\":2,\"status\":\"LIVE\",\"userId\":97214830,\"firstname\":\"Neerja Rohatgi\",\"lastname\":null,\"creationDate\":\"2026-08-26 10:46:20\",\"url\":\"https://ask.shiksha.com/what-is-the-iit-kanpur-btech-cutoff-for-female-category-qna-12974419\",\"title\":\"What is the IIT Kanpur BTech cutoff for female category? \",\"answerOwnerName\":\"Neerja Rohatgi \",\"answerOwnerLevel\":\"Contributor-Level 10\",\"answerOwnerImage\":\"\",\"likeCount\":0,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":1,\"questionCreationDate\":\"3 months ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192347,\"tagName\":\"IIT Kanpur - Indian Institute of Technology\",\"tagType\":\"Colleges\"},{\"tagId\":995229,\"tagName\":\"btech\",\"tagType\":\"Careers\"}]}],\"11494808\":[{\"answerId\":12952329,\"answerText\":\"<p>MHT-CET is not necessarily the only way, but you should not assume that you can simply take direct admission without any entrance/eligibility requirements.</p>\",\"activityTime\":\"3 months ago\",\"answerOwnerUserId\":75566599,\"questionId\":11494808,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":1,\"msgCount\":1,\"viewCount\":14,\"status\":\"LIVE\",\"userId\":7388054,\"firstname\":\"Atul\",\"lastname\":\"Mishra\",\"creationDate\":\"2025-06-16 12:00:19\",\"url\":\"https://ask.shiksha.com/can-i-get-admission-to-sae-sinhgad-academy-of-engineering-b-e-b-tech-course-without-mht-cet-qna-11494808\",\"title\":\"Can I get admission to SAE - Sinhgad Academy of Engineering B.E. / B.Tech course without MHT CET? \",\"answerOwnerName\":\"Shariek Sheik\",\"answerOwnerLevel\":\"Beginner-Level 2\",\"answerOwnerImage\":\"\",\"likeCount\":0,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":1,\"questionCreationDate\":\"a year ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192347,\"tagName\":\"IIT Kanpur - Indian Institute of Technology\",\"tagType\":\"Colleges\"},{\"tagId\":928767,\"tagName\":\"SAE - Sinhgad Academy of Engineering\",\"tagType\":\"Colleges\"}]}],\"12974393\":[{\"answerId\":12974407,\"answerText\":\"<p><strong>IIT Kanpur BTech cutoff 2026</strong> ranged from <strong>283</strong> to <strong>7837 </strong>in the last round for the General AI category. As per this range, BTech CSE was the most difficult course for admission, with the lowest closing rank of <strong>283</strong>. Candidates can check the table below to know the <strong>IIT Kanpur BTech cutoff 2026 </strong>for different BTech course specialisations. </p><table style=\\\"border-collapse: collapse; width: 99.9923%;\\\" border=\\\"1\\\"><colgroup><col style=\\\"width: 50.0662%;\\\"><col style=\\\"width: 50.0662%;\\\"></colgroup><tbody><tr><th>Course</th><th>IIT Kanpur BTech cutoff 2026</th></tr><tr><td width=\\\"237\\\" height=\\\"19\\\">B.Tech. in Computer Science and Engineering</td><td align=\\\"right\\\" width=\\\"163\\\">283</td></tr><tr><td height=\\\"19\\\">B.Tech. in Intelligent Systems</td><td align=\\\"right\\\">1134</td></tr><tr><td height=\\\"19\\\">B.Tech. in Electrical Engineering</td><td align=\\\"right\\\">1171</td></tr><tr><td height=\\\"19\\\">B.Tech. in Mechanical Engineering</td><td align=\\\"right\\\">3178</td></tr><tr><td height=\\\"19\\\">B.Sc. in Economics</td><td align=\\\"right\\\">3650</td></tr><tr><td height=\\\"19\\\">B.Tech. in Aerospace Engineering</td><td align=\\\"right\\\">4015</td></tr><tr><td height=\\\"19\\\">B.Tech. in Chemical Engineering</td><td align=\\\"right\\\">4436</td></tr><tr><td height=\\\"19\\\">B.Tech. in Materials Science and Engineering</td><td align=\\\"right\\\">6533</td></tr><tr><td height=\\\"19\\\">B.Tech. in Civil Engineering</td><td align=\\\"right\\\">7177</td></tr><tr><td height=\\\"19\\\">B.Tech. in Biological Science and Bioengineering</td><td align=\\\"right\\\">7837</td></tr></tbody></table>\",\"activityTime\":\"3 months ago\",\"answerOwnerUserId\":97214830,\"questionId\":12974393,\"discussionId\":null,\"aboutMe\":null,\"commentCount\":1,\"msgCount\":1,\"viewCount\":3,\"status\":\"LIVE\",\"userId\":97214830,\"firstname\":\"Neerja Rohatgi\",\"lastname\":null,\"creationDate\":\"2026-08-26 10:27:36\",\"url\":\"https://ask.shiksha.com/what-is-the-iit-kanpur-btech-cutoff-qna-12974393\",\"title\":\"What is the IIT Kanpur BTech cutoff? \",\"answerOwnerName\":\"Neerja Rohatgi \",\"answerOwnerLevel\":\"Contributor-Level 10\",\"answerOwnerImage\":\"\",\"likeCount\":0,\"dislikeCount\":0,\"threadStatus\":null,\"answerCount\":1,\"questionCreationDate\":\"3 months ago\",\"hasUserVotedUp\":false,\"hasUserVotedDown\":false,\"isUserFollowing\":false,\"hasUserAnswered\":false,\"type\":\"Q\",\"uniqueId\":null,\"followerCount\":0,\"tags\":[{\"tagId\":192347,\"tagName\":\"IIT Kanpur - Indian Institute of Technology\",\"tagType\":\"Colleges\"},{\"tagId\":192347,\"tagName\":\"IIT Kanpur - Indian Institute of Technology\",\"tagType\":\"Colleges\"}]}]},\"allQuestionURL\":\"/college/iit-kanpur-indian-institute-of-technology-25116/questions\",\"questionOrder\":[13050882,11494808,12974419,12974393,12974325],\"pageSize\":5,\"maxPagetoDisplay\":2,\"anaFaqData\":null,\"prepFaqData\":null,\"anaWidgetPresent\":false},\"sectionToAnaTaggedFaqDataMap\":{\"review_section_reviews_ATFs_2\":[{\"anaFaqId\":108460043,\"entityId\":25116,\"entityType\":\"institutePage\",\"childPage\":\"reviewPage\",\"wikiIdentifier\":\"review_section_reviews_ATFs_2\",\"questionId\":8067545,\"answerId\":8067589,\"questionText\":\"What is the highest package offered at IIT Kanpur?\",\"answerText\":\"<p dir=\\\"ltr\\\">The overall IIT Kanpur highest package has not been released yet. Take a look at the table below to know the IIT Kanpur highest package trends for MBA:</p><div dir=\\\"ltr\\\" align=\\\"left\\\"><table><colgroup><col width=\\\"156\\\"><col width=\\\"156\\\"><col style=\\\"width: 77.5px;\\\" width=\\\"155\\\"><col style=\\\"width: 77.5px;\\\"></colgroup><tbody><tr><th><p dir=\\\"ltr\\\">Course</p></th><th><p dir=\\\"ltr\\\">Highest Package (2023)</p></th><th><p dir=\\\"ltr\\\">Highest Package (2024)</p></th><th><p dir=\\\"ltr\\\">Highest Package (2025)</p></th></tr><tr><td><p dir=\\\"ltr\\\">MBA</p></td><td><p dir=\\\"ltr\\\">INR 24 LPA</p></td><td><p dir=\\\"ltr\\\">INR 24 LPA</p></td><td><p dir=\\\"ltr\\\">INR 36 LPA</p></td></tr></tbody></table></div>\",\"order\":0,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-highest-package-offered-at-iit-kanpur-qna-8067545\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":51,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239922,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":1,\"dislikesCount\":2,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-11-24T16:18:09\",\"context\":\"Placements\",\"isStale\":false},{\"anaFaqId\":162736515,\"entityId\":25116,\"entityType\":\"institutePage\",\"childPage\":\"reviewPage\",\"wikiIdentifier\":\"review_section_reviews_ATFs_2\",\"questionId\":7910925,\"answerId\":7910933,\"questionText\":\"What is the NIRF Ranking of IIT Kanpur MBA course? \",\"answerText\":\"<p>NIRF has ranked IIT Kanpur under the 'Management' Category for past three-years. Check below the NIRF rankings:</p><table style=\\\"border-collapse: collapse; width: 99.971%; height: 90.5372px;\\\" border=\\\"1\\\"><colgroup><col style=\\\"width: 49.9659%;\\\"><col style=\\\"width: 49.9659%;\\\"></colgroup><tbody><tr style=\\\"height: 22.3843px;\\\"><th style=\\\"height: 22.3843px;\\\">Year</th><th style=\\\"height: 22.3843px;\\\">Rank</th></tr><tr style=\\\"height: 22.3843px;\\\"><td style=\\\"height: 22.3843px;\\\">2025</td><td style=\\\"height: 22.3843px;\\\">27</td></tr><tr style=\\\"height: 23.3843px;\\\"><td style=\\\"height: 23.3843px;\\\">2022</td><td style=\\\"height: 23.3843px;\\\">29</td></tr><tr style=\\\"height: 22.3843px;\\\"><td>2023</td><td>23</td></tr></tbody></table>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-nirf-ranking-of-iit-kanpur-mba-course-qna-7910925\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":57,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":241262,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2025-09-08T10:02:49\",\"context\":\"Rank\",\"isStale\":false},{\"anaFaqId\":143489991,\"entityId\":25116,\"entityType\":\"institutePage\",\"childPage\":\"reviewPage\",\"wikiIdentifier\":\"review_section_reviews_ATFs_2\",\"questionId\":12860999,\"answerId\":12861035,\"questionText\":\"How is BTech in CSE at IIT Kanpur? \",\"answerText\":\"<p>BTech CSE is the most sought after BTech specialisation at IIT Kanpur. The course is offered in full-time mode for a span of 4 years. BTech CSE students at IITK have bagged excellent placement packages over the years. In 2024, the vaerage package for BTech CSE stood at INR 52.8 LPA.&nbsp;</p><p>Further, the course curriculum offers a strong foundation in Science and maths in the first 2 years, followed by highly advanced professional courses and electives in the last 2 years of the course. It is also the most competitve BTech branch with a closing cutoff rank of 271 in 2025.</p>\",\"order\":2,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-is-btech-in-cse-at-iit-kanpur-qna-12860999\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":7,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-06-10T15:30:04\",\"context\":\"Comparison\",\"isStale\":false},{\"anaFaqId\":162736517,\"entityId\":25116,\"entityType\":\"institutePage\",\"childPage\":\"reviewPage\",\"wikiIdentifier\":\"review_section_reviews_ATFs_2\",\"questionId\":7910623,\"answerId\":7910631,\"questionText\":\"What is the rank of IIT Kanpur MBA? \",\"answerText\":\"<p>IIT Kanpur MBA course has been ranked by various ranking Agencies. Check below the 2025 rankings of IIT Kanpur:</p><table style=\\\"border-collapse: collapse; width: 99.971%;\\\" border=\\\"1\\\"><colgroup><col style=\\\"width: 49.9461%;\\\"><col style=\\\"width: 49.9461%;\\\"></colgroup><tbody><tr><th>Ranking Body</th><th>Rank (2025)</th></tr><tr><td>NIRF</td><td>27</td></tr></tbody></table>\",\"order\":3,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-rank-of-iit-kanpur-mba-qna-7910623\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":57,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":274466,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2025-09-08T10:03:39\",\"context\":\"Rank\",\"isStale\":false}],\"review_section_ATFs_1\":[{\"anaFaqId\":77434290,\"entityId\":25116,\"entityType\":\"institutePage\",\"childPage\":\"reviewPage\",\"wikiIdentifier\":\"review_section_ATFs_1\",\"questionId\":8067703,\"answerId\":8067725,\"questionText\":\"How is the placement scenario at IIT Kanpur? \",\"answerText\":\"<p dir=\\\"ltr\\\">The institute has not released the placement report incorporating the overall data for the 2026 drive. However, the institute have disclosed the 2026 placement statistics till Phase I. As per the reports, over 250 recruiters participated and presented 1202 offers to the students. 1079 students were placed, of which 15 students&nbsp;have got&nbsp;international placements.&nbsp;</p>\",\"order\":0,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/how-is-the-placement-scenario-at-iit-kanpur-qna-8067703\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":53,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":244708,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":3,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-01-23T16:34:04\",\"context\":\"Placements\",\"isStale\":false},{\"anaFaqId\":115971035,\"entityId\":25116,\"entityType\":\"institutePage\",\"childPage\":\"reviewPage\",\"wikiIdentifier\":\"review_section_ATFs_1\",\"questionId\":8734939,\"answerId\":8734941,\"questionText\":\"Which are the top companies visiting IIT Kanpur for M.Tech placements? \",\"answerText\":\"<p>As per the verified students' reviews on Shiksha, top companies, such as Barclays, Flipkart, Qualcomm, Bajaj, HSBC, Tata Motors and Intel come for final placements at IIT Kanpur for MTech. Students get roles from technical research profiles to analytical roles. Additionaly, the institute in 2022 recorded a the highest domestic package of INR 1.9 crore per annum (not just for M.Tech but overall across courses).&nbsp;</p>\",\"order\":1,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/which-are-the-top-companies-visiting-iit-kanpur-for-m-tech-placements-qna-8734939\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":51,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":319102,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2023-11-28T13:30:05\",\"context\":\"Placements\",\"isStale\":false},{\"anaFaqId\":77434296,\"entityId\":25116,\"entityType\":\"institutePage\",\"childPage\":\"reviewPage\",\"wikiIdentifier\":\"review_section_ATFs_1\",\"questionId\":8067511,\"answerId\":8067525,\"questionText\":\"Is IIT Kanpur good for placement? \",\"answerText\":\"<p>As of now, the institute has released the phase-I placement statistics. A total of 1079&nbsp;students were placed and 1202 job offers were distributed among them. Check the complete insights of IIT Kanpur placements 2026 from the table below:</p><table style=\\\"width: 80.9684%;\\\"><tbody><tr><th style=\\\"width: 47.0306%;\\\"><p>Particulars</p></th><th style=\\\"width: 52.9095%;\\\"><p>Placement Statistics (2026) Phase I</p></th></tr><tr><td style=\\\"width: 47.0306%;\\\"><p>Total job offers</p></td><td style=\\\"width: 52.9095%;\\\"><p>1202&nbsp;</p></td></tr><tr><td style=\\\"width: 47.0306%;\\\"><p>Students placed</p></td><td style=\\\"width: 52.9095%;\\\"><p>1079&nbsp;</p></td></tr><tr><td style=\\\"width: 47.0306%;\\\"><p>International offers</p></td><td style=\\\"width: 52.9095%;\\\"><p>15</p></td></tr><tr><td style=\\\"width: 47.0306%;\\\"><p>Top Recruiters</p></td><td style=\\\"width: 52.9095%;\\\"><p>Accenture, American Express, BlackRock, Boeing, Databricks</p></td></tr></tbody></table>\",\"order\":2,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/is-iit-kanpur-good-for-placement-qna-8067511\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":53,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":239808,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":0,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":3,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-01-23T16:35:33\",\"context\":\"Placements\",\"isStale\":false},{\"anaFaqId\":118268291,\"entityId\":25116,\"entityType\":\"institutePage\",\"childPage\":\"reviewPage\",\"wikiIdentifier\":\"review_section_ATFs_1\",\"questionId\":7768621,\"answerId\":7768623,\"questionText\":\"What is the highest salary offered for IIT Kanpur BTech programme? \",\"answerText\":\"<p>&nbsp;IIT Kanpur has not released course-wise placements information so far for 2022-23 Phase-I placements (which got over in December).&nbsp; According to media reports, phase 1 of the placement session 2022-23 concluded with 1,200 job offers received from over 250 companies. IIT Kanpur the highest package (domestic) stood at INR 1.9 crore per annum. The recruitment drive witnessed 74 international offers and 208 PPOs and a total of 1,198 students accepted the job offers. Further,  33 students received packages of above INR 1 crore per annum during IIT Kanpur placements 2023. For more details on IIT Kanpur placements, &nbsp;<a href=\\\"https://www.shiksha.com/college/iit-kanpur-indian-institute-of-technology-25116/placement\\\">click here</a>.&nbsp;</p>\",\"order\":3,\"answerCount\":1,\"url\":{\"url\":null,\"urlHost\":null,\"absoluteUrl\":\"https://ask.shiksha.com/what-is-the-highest-salary-offered-for-iit-kanpur-btech-programme-qna-7768621\"},\"anaFaqSource\":\"asq\",\"generationSource\":\"manual\",\"templateId\":51,\"atfCtrIndex\":0.0,\"showViewOther\":false,\"quesTemplateId\":null,\"quesBaseCourses\":null,\"isCrawlable\":true,\"likesCount\":0,\"dislikesCount\":1,\"navigationUrl\":null,\"isQuestionHtml\":0,\"experiment\":false,\"messageType\":\"QNA\",\"prepQuestionDetails\":null,\"isAIGenerated\":false,\"alumniFeedbackCount\":null,\"showFeedback\":true,\"answerUpdatedAt\":\"2026-03-26T01:12:16\",\"context\":\"Placements\",\"isStale\":false}]},\"media\":{