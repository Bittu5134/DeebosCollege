s.shiksha.ws/public/images/CHP/businessN.jpg\",\"entityType\":\"basecourse\",\"entityId\":193},{\"chpId\":1529,\"displayName\":\"MBA (Masters of Business Administration)\",\"url\":\"/mba-masters-of-business-administration-chp\",\"imageUrl\":\"https://images.shiksha.ws/public/mobile5/images/CHP/businessN.jpg\",\"desktopImageUrl\":\"https://images.shiksha.ws/public/images/CHP/businessN.jpg\",\"entityType\":\"basecourse\",\"entityId\":101},{\"chpId\":1491,\"displayName\":\"M.A. (Master of Arts)\",\"url\":\"/m-a-master-of-arts-chp\",\"imageUrl\":\"https://images.shiksha.ws/public/mobile5/images/CHP/humanitiesN.jpg\",\"desktopImageUrl\":\"https://images.shiksha.ws/public/images/CHP/humanitiesN.jpg\",\"entityType\":\"basecourse\",\"entityId\":82},{\"chpId\":1497,\"displayName\":\"M.Des\",\"url\":\"/m-des-chp\",\"imageUrl\":\"https://images.shiksha.ws/public/mobile5/images/CHP/designN.jpg\",\"desktopImageUrl\":\"https://images.shiksha.ws/public/images/CHP/designN.jpg\",\"entityType\":\"basecourse\",\"entityId\":85},{\"chpId\":1351,\"displayName\":\"B Des (Bachelor of Design)\",\"url\":\"/b-des-bachelor-of-design-chp\",\"imageUrl\":\"https://images.shiksha.ws/public/mobile5/images/CHP/designN.jpg\",\"desktopImageUrl\":\"https://images.shiksha.ws/public/images/CHP/designN.jpg\",\"entityType\":\"basecourse\",\"entityId\":9},{\"chpId\":1573,\"displayName\":\"Ph.D.\",\"url\":\"/ph-d-chp\",\"imageUrl\":\"https://images.shiksha.ws/public/mobile5/images/CHP/engineeringN.jpg\",\"desktopImageUrl\":\"https://images.shiksha.ws/public/images/CHP/engineeringN.jpg\",\"entityType\":\"basecourse\",\"entityId\":124},{\"chpId\":1479,\"displayName\":\"Executive MBA\",\"url\":\"/executive-mba-chp\",\"imageUrl\":\"https://images.shiksha.ws/public/mobile5/images/CHP/businessN.jpg\",\"desktopImageUrl\":\"https://images.shiksha.ws/public/images/CHP/businessN.jpg\",\"entityType\":\"basecourse\",\"entityId\":75},{\"chpId\":3,\"displayName\":\"Engineering\",\"url\":\"/engineering-chp\",\"imageUrl\":\