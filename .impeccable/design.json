      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single filled action on a screen. Tidal blue ground, deep ink text.",
      "html": "<button class=\"ds-btn-primary\">Build my index</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 20px;border:1px solid var(--accent);border-radius:0;background:var(--accent);color:var(--bg-deep);font-family:var(--mono);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;transition:background 120ms var(--ease-out)}.ds-btn-primary:hover{background:color-mix(in srgb,var(--accent) 84%,var(--text));border-color:color-mix(in srgb,var(--accent) 84%,var(--text))}.ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Quiet Button",
