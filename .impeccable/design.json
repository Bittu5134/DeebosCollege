      "css": ".ds-chip{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border:1px solid var(--line-strong);border-radius:0;background:transparent;color:var(--copy);font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:0.08em}.ds-chip-value{font-variant-numeric:tabular-nums;color:var(--text)}"
    },
