# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL, used by docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=college_predictor

# Backend database URL.
# Inside docker compose the host is "postgres". For a backend running on the
# host, change the host to localhost.
DATABASE_URL=postgresql+psycopg2://postgres:change_me@postgres:5432/college_predictor

# Qdrant. Leave QDRANT_URL empty to use the local qdrant_storage directory.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=branches

# Embedding model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM provider: gemini or openai (any OpenAI-compatible endpoint).
LLM_PROVIDER=gemini

# Gemini. A key is required for preference extraction and explanations.
GEMINI_API_KEY=
USE_VERTEX=false
GCP_PROJECT=
GCP_LOCATION=us-central1
LLM_MODEL=gemini-2.5-flash

# OpenAI-compatible endpoint, used when LLM_PROVIDER=openai.
# OPENAI_API_MODE is "chat" for /chat/completions or "responses" for /responses.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_MODE=chat


# Comma separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
